# ============================================
# Loom Multiverse — Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ──────────────────────────────────────────────
# LLM Provider (choose: ollama | anthropic | openai)
# ──────────────────────────────────────────────
# DEFAULT: "ollama" — runs locally on your machine for FREE
# Change to "anthropic" or "openai" only if you want paid cloud models
LLM_PROVIDER=ollama

# ──────────────────────────────────────────────
# Ollama (Local LLM — FREE, default)
# ──────────────────────────────────────────────
# Install: https://ollama.com/download
# Then run: ollama pull qwen3:4b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CODE_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Embedding Provider: "ollama" (768d, FREE) or "openai" (1536d, PAID)
EMBEDDING_PROVIDER=ollama

# ──────────────────────────────────────────────
# Cloud LLM Providers (OPTIONAL — paid fallback)
# ──────────────────────────────────────────────
# Only needed if LLM_PROVIDER is set to "anthropic" or "openai"
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# ──────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://loom:loom_secret@localhost:5432/loom_multiverse
POSTGRES_USER=loom
POSTGRES_PASSWORD=loom_secret
POSTGRES_DB=loom_multiverse

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# E2B Sandbox (Secure Code Execution)
# ──────────────────────────────────────────────
E2B_API_KEY=e2b_xxxxxxxxxxxxx

# ──────────────────────────────────────────────
# Stripe (Billing MCP)
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ──────────────────────────────────────────────
# Resend (Email MCP)
# ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxx

# ──────────────────────────────────────────────
# PostHog (Analytics MCP)
# ──────────────────────────────────────────────
POSTHOG_API_KEY=phc_xxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# ──────────────────────────────────────────────
# Linear (Project Tracking)
# ──────────────────────────────────────────────
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxx
LINEAR_TEAM_ID=
LINEAR_WEBHOOK_SECRET=

# ──────────────────────────────────────────────
# GitHub
# ──────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=

# ──────────────────────────────────────────────
# OpenCode (AI PR Reviews)
# ──────────────────────────────────────────────
OPENCODE_API_KEY=

# ──────────────────────────────────────────────
# Deployment
# ──────────────────────────────────────────────
VERCEL_TOKEN=
RENDER_API_KEY=

# ──────────────────────────────────────────────
# API Server
# ──────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# ──────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string
SESSION_SECRET=change-this-to-another-random-64-char-string

# ──────────────────────────────────────────────
# Founder Feed
# ──────────────────────────────────────────────
FEED_REFRESH_INTERVAL_MINUTES=30
