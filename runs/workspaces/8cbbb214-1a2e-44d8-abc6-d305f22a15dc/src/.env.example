REACT_APP_API_URL=
REACT_APP_PAYPAL_CLIENT_ID=
REACT_APP_STRIPE_PUBLIC_KEY=
REACT_APP_MONGODB_URI=
REACT_APP_SESSION_SECRET=

# Explanation of variables:
# REACT_APP_API_URL: Base URL for your backend API
# REACT_APP_PAYPAL_CLIENT_ID: Client ID for PayPal integration
# REACT_APP_STRIPE_PUBLIC_KEY: Public key for Stripe integration
# REACT_APP_MONGODB_URI: MongoDB connection string
# REACT_APP_SESSION_SECRET: Secret used for session management
