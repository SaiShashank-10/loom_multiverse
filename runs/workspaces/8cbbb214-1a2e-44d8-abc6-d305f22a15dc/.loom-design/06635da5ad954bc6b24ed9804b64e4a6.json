  "html": "<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Secure Checkout — Emily Carter Ceramics</title>\n<!-- Fonts -->\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Tailwind CSS with custom configuration -->\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          \"colors\": {\n            \"secondary-fixed-dim\": \"#bfc8d0\",\n            \"on-primary-container\": \"#fefcff\",\n            \"on-secondary-fixed-variant\": \"#3f484f\",\n            \"outline-variant\": \"#c1c6d7\",\n            \"on-error\": \"#ffffff\",\n            \"error-container\": \"#ffdad6\",\n            \"on-tertiary-fixed\": \"#351000\",\n            \"on-secondary-container\": \"#5b646b\",\n            \"surface-container-highest\": \"#dde3eb\",\n            \"on-background\": \"#161c22\",\n            \"primary-container\": \"#0070ea\",\n            \"error\": \"#ba1a1a\",\n            \"primary\": \"#0059bb\",\n            \"inverse-primary\": \"#adc7ff\",\n            \"outline\": \"#717786\",\n            \"surface-variant\": \"#dde3eb\",\n            \"on-primary-fixed-variant\": \"#004493\",\n            \"tertiary\": \"#9e3d00\",\n            \"on-surface-variant\": \"#414754\",\n            \"on-secondary-fixed\": \"#141d23\",\n            \"on-tertiary-container\": \"#fffbff\",\n            \"inverse-on-surface\": \"#ecf1f9\",\n            \"surface-container-lowest\": \"#ffffff\",\n            \"surface-container-high\": \"#e3e9f0\",\n            \"surface\": \"#f7f9ff\",\n            \"on-tertiary\": \"#ffffff\",\n            \"secondary\": \"#575f67\",\n            \"tertiary-fixed\": \"#ffdbcc\",\n            \"tertiary-container\": \"#c64f00\",\n            \"secondary-container\": \"#d8e1ea\",\n            \"on-error-container\": \"#93000a\",\n            \"tertiary-fixed-dim\": \"#ffb695\",\n            \"on-tertiary-fixed-variant\": \"#7c2e00\",\n            \"on-primary\": \"#ffffff\",\n            \"surface-dim\": \"#d5dae2\",\n            \"surface-bright\": \"#f7f9ff\",\n            \"surface-container-low\": \"#eff4fc\",\n            \"surface-container\": \"#e9eef6\",\n            \"on-surface\": \"#161c22\",\n            \"inverse-surface\": \"#2b3137\",\n            \"on-secondary\": \"#ffffff\",\n            \"secondary-fixed\": \"#dbe4ed\",\n            \"primary-fixed-dim\": \"#adc7ff\",\n            \"on-primary-fixed\": \"#001a41\",\n            \"primary-fixed\": \"#d8e2ff\",\n            \"surface-tint\": \"#005bc0\",\n            \"background\": \"#f7f9ff\"\n          },\n          \"borderRadius\": {\n            \"DEFAULT\": \"0.125rem\",\n            \"lg\": \"0.25rem\",\n            \"xl\": \"0.5rem\",\n            \"full\": \"0.75rem\"\n          },\n          \"spacing\": {\n            \"space-xl\": \"2.5rem\",\n            \"margin-mobile\": \"1.25rem\",\n            \"space-xs\": \"0.25rem\",\n            \"space-sm\": \"0.5rem\",\n            \"gutter-mobile\": \"1rem\",\n            \"space-md\": \"1rem\",\n            \"margin\": \"3rem\",\n            \"space-lg\": \"1.5rem\",\n            \"gutter\": \"1.5rem\"\n          },\n          \"fontFamily\": {\n            \"label-sm\": [\"Plus Jakarta Sans\"],\n            \"headline-md\": [\"Newsreader\"],\n            \"headline-lg\": [\"Newsreader\"],\n            \"body-sm\": [\"Plus Jakarta Sans\"],\n            \"headline-lg-mobile\": [\"Newsreader\"],\n            \"body-md\": [\"Plus Jakarta Sans\"],\n            \"label-md\": [\"Plus Jakarta Sans\"],\n            \"label-lg\": [\"Plus Jakarta Sans\"],\n            \"headline-sm\": [\"Newsreader\"],\n            \"display-hero-mobile\": [\"Newsreader\"],\n            \"display-hero\": [\"Newsreader\"],\n            \"body-lg\": [\"Plus Jakarta Sans\"]\n          },\n          \"fontSize\": {\n            \"label-sm\": [\"11px\", { \"lineHeight\": \"14px\", \"letterSpacing\": \"0.06em\", \"fontWeight\": \"700\" }],\n            \"headline-md\": [\"28px\", { \"lineHeight\": \"36px\", \"fontWeight\": \"500\" }],\n            \"headline-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.015em\", \"fontWeight\": \"400\" }],\n            \"body-sm\": [\"13px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }],\n            \"headline-lg-mobile\": [\"28px\", { \"lineHeight\": \"36px\", \"fontWeight\": \"400\" }],\n            \"body-md\": [\"15px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }],\n            \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.04em\", \"fontWeight\": \"600\" }],\n            \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }],\n            \"headline-sm\": [\"22px\", { \"lineHeight\": \"28px\", \"fontWeight\": \"500\" }],\n            \"display-hero-mobile\": [\"36px\", { \"lineHeight\": \"44px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"400\" }],\n            \"display-hero\": [\"56px\", { \"lineHeight\": \"64px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"400\" }],\n            \"body-lg\": [\"18px\", { \"lineHeight\": \"28px\", \"fontWeight\": \"400\" }]\n          }\n        }\n      }\n    }\n  </script>\n<style>\n    .material-symbols-outlined {\n      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n      display: inline-block;\n      vertical-align: middle;\n      line-height: 1;\n    }\n  </style>\n</head>\n<body class=\"bg-background text-on-surface antialiased selection:bg-primary-fixed selection:text-on-primary-fixed min-h-screen flex flex-col justify-between\">\n<!-- TOP HEADER NAVBAR (Shared Component compliant) -->\n<header class=\"bg-surface/90 dark:bg-inverse-surface/90 backdrop-blur-md text-primary dark:text-inverse-primary docked full-width top-0 sticky z-40 shadow-sm border-b border-outline-variant/30\">\n<div class=\"flex justify-between items-center w-full px-12 py-4 max-w-[1440px] mx-auto\">\n<!-- Brand Logo / Wordmark -->\n<div class=\"flex items-center gap-6\">\n<a class=\"font-headline-md text-headline-md tracking-tight text-on-surface dark:text-inverse-on-surface hover:opacity-90 transition-opacity\" href=\"#\">\n          Emily Carter Ceramics\n        </a>\n<div class=\"hidden sm:flex items-center gap-1.5 px-2.5 py-1 bg-surface-container rounded border border-outline-variant/40\">\n<span class=\"material-symbols-outlined text-[15px] text-secondary\" data-icon=\"lock\" style=\"font-variation-settings: 'FILL' 1;\">lock</span>\n<span class=\"font-label-sm text-label-sm text-secondary tracking-wider uppercase\">256-Bit Encrypted</span>\n</div>\n</div>\n<!-- Navigation Links (Shop active as top-level parent) -->\n<nav aria-label=\"Main Studio Navigation\" class=\"hidden lg:flex items-center space-x-8\">\n<a class=\"text-primary dark:text-inverse-primary font-semibold border-b-2 border-primary pb-1 font-label-md text-label-md transition-all duration-200\" href=\"#\">Shop</a>\n<a class=\"text-on-surface-variant dark:text-surface-variant transition-colors hover:text-primary dark:hover:text-inverse-primary font-label-md text-label-md\" href=\"#\">Collection</a>\n<a class=\"text-on-surface-variant dark:text-surface-variant transition-colors hover:text-primary dark:hover:text-inverse-primary font-label-md text-label-md\" href=\"#\">Workshops</a>\n<a class=\"text-on-surface-variant dark:text-surface-variant transition-colors hover:text-primary dark:hover:text-inverse-primary font-label-md text-label-md\" href=\"#\">About</a>\n<a class=\"text-on-surface-variant dark:text-surface-variant transition-colors hover:text-primary dark:hover:text-inverse-primary font-label-md text-label-md\" href=\"#\">Journal</a>\n</nav>\n<!-- Trailing Action Icons -->\n<div class=\"flex items-center space-x-5\">\n<a aria-label=\"Customer Profile\" class=\"p-2 text-on-surface-variant hover:text-primary transition-colors duration-150\" href=\"#\">\n<span class=\"material-symbols-outlined text-[22px]\" data-icon=\"person\">person</span>\n</a>\n<a aria-label=\"Cart (3 items)\" class=\"p-2 text-primary relative transition-colors duration-150 flex items-center gap-1\" href=\"#\">\n<span class=\"material-symbols-outlined text-[22px]\" data-icon=\"shopping_bag\">shopping_bag</span>\n<span class=\"bg-primary text-on-primary text-[10px] font-bold rounded-full w-4 h-4 flex items-center justify-center -ml-2 -mt-2\">3</span>\n</a>\n</div>\n</div>\n</header>\n<!-- STEPPER & PROGRESS NAVIGATION -->\n<section class=\"w-full bg-surface-container-lowest border-b border-outline-variant/20 py-4 px-6 md:px-12\">\n<div class=\"max-w-[1440px] mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n<!-- Back to Bag link -->\n<a class=\"inline-flex items-center gap-2 text-secondary hover:text-on-surface font-body-sm text-body-sm transition-colors group\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px] group-hover:-translate-x-0.5 transition-transform\" data-icon=\"arrow_back\">arrow_back</span>\n<span>Return to Studio Bag</span>\n</a>\n<!-- Progress Indicators -->\n<ol aria-label=\"Checkout Progress\" class=\"flex items-center space-x-3 sm:space-x-8\">\n<!-- Step 1: Cart Completed -->\n<li class=\"flex items-center gap-2\">\n<span class=\"w-6 h-6 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[14px]\" data-icon=\"check\">check</span>\n</span>\n<span class=\"font-label-md text-label-md text-secondary line-through opacity-70\">1. Cart</span>\n</li>\n<span class=\"text-outline-variant text-xs\">/</span>\n<!-- Step 2: Shipping & Payment Details (Active) -->\n<li aria-current=\"step\" class=\"flex items-center gap-2\">\n<span class=\"w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-label-sm text-label-sm font-bold shadow-sm\">\n            2\n          </span>\n<span class=\"font-label-md text-label-md text-primary font-bold tracking-tight\">2. Shipping &amp; Payment</span>\n</li>\n<span class=\"text-outline-variant text-xs\">/</span>\n<!-- Step 3: Confirmation Upcoming -->\n<li class=\"flex items-center gap-2\">\n<span class=\"w-6 h-6 rounded-full bg-surface-container-highest text-secondary flex items-center justify-center font-label-sm text-label-sm\">\n            3\n          </span>\n<span class=\"font-label-md text-label-md text-secondary opacity-60\">3. Confirmation</span>\n</li>\n</ol>\n<!-- Trust Indicator Right -->\n<div class=\"hidden lg:flex items-center gap-2 text-secondary font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-tertiary text-[16px]\" data-icon=\"verified\">verified</span>\n<span>Artisan Studio Handcrafted Dispatch</span>\n</div>\n</div>\n</section>\n<!-- MAIN CHECKOUT CONTENT CANVAS (12-Column Responsive Layout) -->\n<main class=\"w-full max-w-[1440px] mx-auto px-6 md:px-12 py-10 flex-1\">\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\">\n<!-- LEFT COLUMN: Checkout Forms & Interactions (7 Columns Desktop) -->\n<div class=\"lg:col-span-7 space-y-10\">\n<!-- EXPRESS CHECKOUT SECTION -->\n<section aria-labelledby=\"express-checkout-title\" class=\"bg-surface-container-lowest p-6 sm:p-8 rounded-xl border border-outline-variant/30\">\n<div class=\"flex items-center justify-between mb-4\">\n<h2 class=\"font-label-md text-label-md uppercase tracking-wider text-secondary\" id=\"express-checkout-title\">\n              Express One-Click Checkout\n            </h2>\n<span class=\"font-label-sm text-label-sm text-outline\">Accelerated &amp; Touch-Safe</span>\n</div>\n<!-- Express Buttons Grid -->\n<div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n<!-- Shop Pay -->\n<button aria-label=\"Pay with Shop Pay\" class=\"w-full h-12 bg-[#5a31f4] hover:bg-[#4b27d4] text-white font-semibold rounded flex items-center justify-center transition-all duration-150 active:scale-[0.98] shadow-sm\" type=\"button\">\n<span class=\"tracking-tight text-[15px] font-bold italic font-body-md\">shop<span class=\"font-normal not-italic bg-white/20 px-1 py-0.5 rounded ml-1 text-xs\">Pay</span></span>\n</button>\n<!-- Apple Pay -->\n<button aria-label=\"Pay with Apple Pay\" class=\"w-full h-12 bg-black hover:bg-neutral-900 text-white font-medium rounded flex items-center justify-center transition-all duration-150 active:scale-[0.98] shadow-sm\" type=\"button\">\n<span class=\"inline-flex items-center gap-1 text-[15px] tracking-tight font-body-md\">\n<svg class=\"h-4 w-4 fill-current\" viewbox=\"0 0 170 170\">\n<path d=\"M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.04-7.66-7.85-11.91-14.42-6-9.28-10.74-19.8-14.22-31.57-3.48-11.76-5.22-23.01-5.22-33.75 0-14.35 3.59-26.43 10.78-36.25 7.18-9.82 16.3-14.79 27.35-14.92 5.54 0 11.21 1.48 17.02 4.44 5.8 2.96 9.77 4.54 11.91 4.74 1.74-.2 5.92-1.87 12.54-5 6.62-3.13 12.51-4.51 17.68-4.14 13.58.98 24.31 5.86 32.19 14.64-11.74 7.07-17.5 16.89-17.29 29.46.21 9.8 4.02 18.06 11.44 24.78 3.8 3.48 8.1 6.13 12.91 7.95-2.61 7.61-5.8 15.1-9.57 22.48zM119.22 31.84c0-7.39 2.66-14.35 7.98-20.88 5.32-6.53 11.96-10.65 19.92-12.36.43 1.96.65 3.8.65 5.54 0 7.28-2.77 14.37-8.31 21.27-5.54 6.9-12.24 11.08-20.1 12.54-.14-2.07-.14-4.1-.14-6.11z\"></path>\n</svg>\n                Pay\n              </span>\n</button>\n<!-- Google Pay -->\n<button aria-label=\"Pay with Google Pay\" class=\"w-full h-12 bg-white hover:bg-neutral-50 text-neutral-800 border border-outline-variant/60 font-medium rounded flex items-center justify-center transition-all duration-150 active:scale-[0.98] shadow-sm\" type=\"button\">\n<span class=\"inline-flex items-center gap-1.5 font-bold tracking-tight text-[14px]\">\n<span class=\"text-blue-500 font-extrabold\">G</span><span class=\"text-neutral-700\">Pay</span>\n</span>\n</button>\n</div>\n<!-- Divider -->\n<div class=\"relative flex py-6 items-center\">\n<div class=\"flex-grow border-t border-outline-variant/30\"></div>\n<span class=\"flex-shrink mx-4 font-label-md text-label-md text-secondary\">\n              Or proceed with studio checkout\n            </span>\n<div class=\"flex-grow border-t border-outline-variant/30\"></div>\n</div>\n<!-- Quick Account Notification -->\n<div class=\"flex items-center justify-between text-body-sm font-body-sm bg-surface-container-low px-4 py-2.5 rounded\">\n<span class=\"text-on-surface-variant\">Already collected with Emily Carter?</span>\n<a class=\"text-primary font-semibold hover:underline underline-offset-4\" href=\"#\">Log in for studio archive</a>\n</div>\n</section>\n<!-- SHIPPING ADDRESS FORM -->\n<section aria-labelledby=\"shipping-heading\" class=\"bg-surface-container-lowest p-6 sm:p-8 rounded-xl border border-outline-variant/30 space-y-6\">\n<div class=\"flex items-center justify-between border-b border-outline-variant/20 pb-4\">\n<div class=\"flex items-center gap-3\">\n<span class=\"w-7 h-7 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-md text-label-md flex items-center justify-center font-bold\">1</span>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface\" id=\"shipping-heading\">\n                Artisan Delivery &amp; Studio Dispatch\n              </h2>\n</div>\n<span class=\"font-label-sm text-label-sm text-secondary\">All shipments fully insured</span>\n</div>\n<form class=\"space-y-4\" onsubmit=\"event.preventDefault();\">\n<!-- Full Name & Email -->\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n<div>\n<label class=\"block font-label-md text-label-md text-on-surface-variant mb-1\" for=\"fullName\">\n                  Recipient Full Name <span class=\"text-error\">*</span>\n</label>\n<input class=\"w-full h-12 px-3.5 bg-surface-container-lowest border border-outline-variant/60 rounded text-on-surface font-body-md text-body-md focus:border-primary focus:ring-0 transition-colors\" id=\"fullName\" required=\"\" type=\"text\" value=\"Lady Margaret Vance\"/>\n</div>\n<div>\n<label class=\"block font-label-md text-label-md text-on-surface-variant mb-1\" for=\"email\">\n                  Email Address (for kiln &amp; tracking notes) <span class=\"text-error\">*</span>\n</label>\n<input class=\"w-full h-12 px-3.5 bg-surface-container-lowest border border-outline-variant/60 rounded text-on-surface font-body-md text-body-md focus:border-primary focus:ring-0 transition-colors\" id=\"email\" required=\"\" type=\"email\" value=\"margaret.vance@studio-curator.co.uk\"/>\n</div>\n</div>\n<!-- Phone Number & Country -->\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n<div>\n<label class=\"block font-label-md text-label-md text-on-surface-variant mb-1\" for=\"phone\">\n                  Contact Phone (for fragile courier delivery) <span class=\"text-error\">*</span>\n</label>\n<input class=\"w-full h-12 px-3.5 bg-surface-container-lowest border border-outline-variant/60 rounded text-on-surface font-body-md text-body-md focus:border-primary focus:ring-0 transition-colors\" id=\"phone\" required=\"\" type=\"tel\" value=\"+1 (415) 890-2341\"/>\n</div>\n<div>\n<label class=\"block font-label-md text-label-md text-on-surface-variant mb-1\" for=\"country\">\n                  Destination Country / Region <span class=\"text-error\">*</span>\n</label>\n<select class=\"w-full h-12 px-3.5 bg-surface-container-lowest border border-outline-variant/60 rounded text-on-surface font-body-md text-body-md focus:border-primary focus:ring-0 transition-colors\" id=\"country\">\n<option selected=\"\">United States (Lower 48 &amp; Coastal)</option>\n<option>United Kingdom &amp; Northern Ireland</option>\n<option>European Union (Customs Inspected)</option>\n<option>Japan &amp; East Asia Specialty Fragile</option>\n<option>Canada (Studio Direct)</option>\n</select>\n</div>\n</div>\n<!-- Street Address -->\n<div>\n<label class=\"block font-label-md text-label-md text-on-surface-variant mb-1\" for=\"street\">\n                Street Address <span class=\"text-error\">*</span>\n</label>\n<input class=\"w-full h-12 px-3.5 bg-surface-container-lowest border border-outline-variant/60 rounded text-on-surface font-body-md text-body-md focus:border-primary focus:ring-0 transition-colors\" id=\"street\" required=\"\" type=\"text\" value=\"742 Montgomery Street, Studio Suite 4B\"/>\n</div>\n<!-- Apartment / Floor / Suite (Optional) -->\n<div>\n<label class=\"block font-label-md text-label-md text-on-surface-variant mb-1\" for=\"apartment\">\n                Apartment, suite, unit, building, floor, etc. (optional)\n              </label>\n<input class=\"w-full h-12 px-3.5 bg-surface-container-lowest border border-outline-variant/60 rounded text-on-surface font-body-md text-body-md focus:border-primary focus:ring-0 transition-colors\" id=\"apartment\" placeholder=\"e.g. Penthouse West, Ring bell twice\" type=\"text\"/>\n</div>\n<!-- City, State, Postal Code -->\n<div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n<div>\n<label class=\"block font-label-md text-label-md text-on-surface-variant mb-1\" for=\"city\">\n                  City <span class=\"text-error\">*</span>\n</label>\n<input class=\"w-full h-12 px-3.5 bg-surface-container-lowest border border-outline-variant/60 rounded text-on-surface font-body-md text-body-md focus:border-primary focus:ring-0 transition-colors\" id=\"city\" required=\"\" type=\"text\" value=\"San Francisco\"/>\n</div>\n<div>\n<label class=\"block font-label-md text-label-md text-on-surface-variant mb-1\" for=\"state\">\n                  State / Province <span class=\"text-error\">*</span>\n</label>\n<select class=\"w-full h-12 px-3.5 bg-surface-container-lowest border border-outline-variant/60 rounded text-on-surface font-body-md text-body-md focus:border-primary focus:ring-0 transition-colors\" id=\"state\">\n<option selected=\"\">California (CA)</option>\n<option>New York (NY)</option>\n<option>Oregon (OR)</option>\n<option>Washington (WA)</option>\n<option>Massachusetts (MA)</option>\n<option>Illinois (IL)</option>\n</select>\n</div>\n<div>\n<label class=\"block font-label-md text-label-md text-on-surface-variant mb-1\" for=\"zip\">\n                  Postal / ZIP Code <span class=\"text-error\">*</span>\n</label>\n<input class=\"w-full h-12 px-3.5 bg-surface-container-lowest border border-outline-variant/60 rounded text-on-surface font-body-md text-body-md focus:border-primary focus:ring-0 transition-colors\" id=\"zip\" required=\"\" type=\"text\" value=\"94111\"/>\n</div>\n</div>\n<!-- Studio Checkboxes -->\n<div class=\"pt-2 space-y-3\">\n<label class=\"flex items-start gap-3 cursor-pointer group\">\n<input checked=\"\" class=\"mt-0.5 w-4 h-4 text-primary rounded border-outline focus:ring-primary focus:ring-offset-0\" type=\"checkbox\"/>\n<span class=\"font-body-sm text-body-sm text-on-surface group-hover:text-primary transition-colors\">\n                  Save this residential gallery address for future stoneware drops and private stu