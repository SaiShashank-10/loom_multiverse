"headline-sm\": [\"Roboto Flex\"],\n            \"display\": [\"Roboto Flex\"],\n            \"label-lg\": [\"Roboto Flex\"],\n            \"headline-md\": [\"Roboto Flex\"],\n            \"body-sm\": [\"Roboto Flex\"],\n            \"body-md\": [\"Roboto Flex\"],\n            \"headline-lg\": [\"Roboto Flex\"],\n            \"body-lg\": [\"Roboto Flex\"],\n            \"title-md\": [\"Roboto Flex\"],\n            \"label-md\": [\"Roboto Flex\"],\n            \"label-sm\": [\"Roboto Flex\"],\n            \"headline-lg-mobile\": [\"Roboto Flex\"]\n          },\n          \"fontSize\": {\n            \"headline-sm\": [\"20px\", { \"lineHeight\": \"28px\", \"fontWeight\": \"600\" }],\n            \"display\": [\"48px\", { \"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }],\n            \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }],\n            \"headline-md\": [\"24px\", { \"lineHeight\": \"32px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"600\" }],\n            \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }],\n            \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }],\n            \"headline-lg\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }],\n            \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }],\n            \"title-md\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }],\n            \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }],\n            \"label-sm\": [\"11px\", { \"lineHeight\": \"14px\", \"letterSpacing\": \"0.03em\", \"fontWeight\": \"500\" }],\n            \"headline-lg-mobile\": [\"26px\", { \"lineHeight\": \"34px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }]\n          }\n        },\n      },\n    }\n  </script>\n</head>\n<body class=\"bg-background text-on-surface font-body-md min-h-screen antialiased flex flex-col selection:bg-primary-fixed selection:text-on-primary-fixed\">\n<!-- TopNavBar (Shared Component JSON compliant) -->\n<header class=\"flex items-center justify-between px-6 py-3 w-full border-b border-surface-variant dark:border-outline-variant bg-surface-container-lowest dark:bg-surface-container-low sticky top-0 z-40 shadow-sm\">\n<!-- Left: Brand Logo & Universal Search -->\n<div class=\"flex items-center gap-6\">\n<div class=\"flex items-center gap-2\">\n<div class=\"w-8 h-8 rounded-lg bg-primary flex items-center justify-center text-on-primary shadow-sm\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"explore\">explore</span>\n</div>\n<span class=\"text-title-md font-title-md font-bold tracking-tight text-primary dark:text-inverse-primary\">CareerPath</span>\n</div>\n<!-- Search Input on Left -->\n<div class=\"relative w-80 hidden md:block\">\n<span class=\"material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-secondary text-[18px]\" data-icon=\"search\">search</span>\n<input class=\"w-full pl-9 pr-4 py-1.5 text-body-md font-body-md bg-surface-container-lowest border border-surface-variant rounded-lg text-on-surface placeholder:text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all\" placeholder=\"Role title, skills, or target company...\" type=\"text\" value=\"Frontend Developer, React, Next.js\"/>\n</div>\n</div>\n<!-- Center: Primary Navigation Links -->\n<nav class=\"hidden lg:flex items-center gap-8\">\n<!-- Active Link: Job Match -->\n<a class=\"border-b-2 border-primary dark:border-inverse-primary text-primary dark:text-inverse-primary font-semibold pb-1 text-label-lg font-label-lg flex items-center gap-1.5\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"target\">target</span>\n        Job Match\n      </a>\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors text-label-lg font-label-lg flex items-center gap-1.5\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"troubleshoot\">troubleshoot</span>\n        Gap Analysis\n      </a>\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors text-label-lg font-label-lg flex items-center gap-1.5\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"map\">map</span>\n        Learning Roadmaps\n      </a>\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors text-label-lg font-label-lg flex items-center gap-1.5\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"contract\">contract</span>\n        Applications\n      </a>\n</nav>\n<!-- Right: Trailing Actions, Notification & Candidate Profile -->\n<div class=\"flex items-center gap-3\">\n<!-- Match Score Badge -->\n<div class=\"flex items-center gap-1.5 px-2.5 py-1 bg-tertiary-fixed text-on-tertiary-fixed rounded-full text-label-sm font-label-sm border border-tertiary/20\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary animate-pulse\"></span>\n<span class=\"font-semibold\">Match Score: 88%</span>\n</div>\n<!-- Secondary Trailing Action -->\n<button class=\"hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-surface-variant bg-surface-container-lowest hover:bg-surface-container text-on-surface text-label-md font-label-md transition-colors shadow-sm active:scale-[0.98]\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\" data-icon=\"rate_review\">rate_review</span>\n        Resume Review\n      </button>\n<div class=\"h-5 w-[1px] bg-surface-variant mx-1 hidden sm:block\"></div>\n<!-- Trailing Icon Actions -->\n<div class=\"flex items-center gap-1\">\n<button class=\"p-1.5 rounded-lg text-secondary hover:bg-surface-container hover:text-on-surface transition-colors\" title=\"Notifications\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"notifications\">notifications</span>\n</button>\n<button class=\"p-1.5 rounded-lg text-secondary hover:bg-surface-container hover:text-on-surface transition-colors\" title=\"Chat\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"chat_bubble\">chat_bubble</span>\n</button>\n<button class=\"p-1.5 rounded-lg text-secondary hover:bg-surface-container hover:text-on-surface transition-colors\" title=\"Settings\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"settings\">settings</span>\n</button>\n</div>\n<!-- Candidate Profile Avatar & Details -->\n<div class=\"flex items-center gap-2 pl-2 border-l border-surface-variant\">\n<div class=\"relative\">\n<img class=\"w-8 h-8 rounded-full object-cover ring-2 ring-primary/20\" data-alt=\"A clean, modern photographic headshot of Alex Chen, an ambitious young Asian software developer smiling warmly in a bright, modern architectural tech workspace with daylighting and minimal blue accents reflecting CareerPath high-tech branding.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAOHOWt0_KwN6BghObyGvwh-5fX-5EAqu9ldUVB6YBLB8GeeJ1I_bFadKxJ0J4_vWn_02jyQ6eXCToEKEdCaF-i6luiHQRa5Vbo8GYCqxGYvDbESBmtiyfoa4W9py-5jrLvd0Q38OOULuhQN97XUTzLBsDAA70pQcQ5MInjcNF8gEt7mRYyYW7I_7Oo0-O4JKq6zcg_nOrOgxpsSklBj5sX5I-dir3B0L-GTJURiZNq3UuulklxGE1BY12ypREHUW3sj3NSqnecaG2Q\"/>\n<span class=\"absolute bottom-0 right-0 w-2.5 h-2.5 bg-tertiary border-2 border-surface-container-lowest rounded-full\" title=\"Active job search status\"></span>\n</div>\n<div class=\"hidden xl:flex flex-col text-left\">\n<span class=\"text-label-md font-label-md text-on-surface leading-tight\">Alex Chen</span>\n<span class=\"text-label-sm font-label-sm text-secondary\">Junior FE Track</span>\n</div>\n</div>\n</div>\n</header>\n<!-- Workspace 3-Column Desktop Grid Container -->\n<div class=\"flex-1 w-full max-w-[1536px] mx-auto px-4 lg:px-6 py-5 flex gap-5 items-start\">\n<!-- 1. Left Filter Sidebar (w-72) -->\n<aside class=\"w-72 shrink-0 bg-surface-container-lowest border border-surface-variant rounded-xl p-4 shadow-sm space-y-5 sticky top-[73px]\">\n<!-- Header -->\n<div class=\"flex items-center justify-between pb-3 border-b border-surface-variant\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\" data-icon=\"tune\">tune</span>\n<h2 class=\"text-title-md font-title-md text-on-surface\">Filter Criteria</h2>\n</div>\n<button class=\"text-label-sm font-label-sm text-primary hover:underline\">Reset</button>\n</div>\n<!-- Minimum Match Score Slider -->\n<div class=\"space-y-2\">\n<div class=\"flex justify-between items-center\">\n<label class=\"text-label-md font-label-md text-on-surface flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary\" data-icon=\"verified\">verified</span>\n            Min. Skill Match\n          </label>\n<span class=\"text-label-md font-label-md px-2 py-0.5 rounded bg-tertiary-fixed text-on-tertiary-fixed font-bold\">≥ 80%</span>\n</div>\n<input class=\"w-full accent-primary h-1.5 bg-surface-container-highest rounded-lg cursor-pointer\" max=\"100\" min=\"50\" type=\"range\" value=\"80\"/>\n<div class=\"flex justify-between text-label-sm font-label-sm text-secondary\">\n<span>50%</span>\n<span>75%</span>\n<span>100%</span>\n</div>\n</div>\n<!-- Experience Level -->\n<div class=\"space-y-2 pt-2 border-t border-surface-variant\">\n<label class=\"text-label-md font-label-md text-on-surface font-semibold block\">Experience Level</label>\n<div class=\"space-y-2\">\n<label class=\"flex items-center gap-2.5 text-body-sm font-body-sm text-on-surface cursor-pointer\">\n<input checked=\"\" class=\"w-4 h-4 rounded text-primary focus:ring-primary border-outline-variant\" type=\"checkbox\"/>\n<span class=\"font-medium text-primary\">Entry (0–2 yrs)</span>\n<span class=\"ml-auto text-secondary text-label-sm font-label-sm\">84</span>\n</label>\n<label class=\"flex items-center gap-2.5 text-body-sm font-body-sm text-on-surface cursor-pointer\">\n<input class=\"w-4 h-4 rounded text-primary focus:ring-primary border-outline-variant\" type=\"checkbox\"/>\n<span>Internship / Co-op</span>\n<span class=\"ml-auto text-secondary text-label-sm font-label-sm\">29</span>\n</label>\n<label class=\"flex items-center gap-2.5 text-body-sm font-body-sm text-on-surface cursor-pointer\">\n<input class=\"w-4 h-4 rounded text-primary focus:ring-primary border-outline-variant\" type=\"checkbox\"/>\n<span>Mid-Level (3–5 yrs)</span>\n<span class=\"ml-auto text-secondary text-label-sm font-label-sm\">31</span>\n</label>\n</div>\n</div>\n<!-- Tech Stack Facet -->\n<div class=\"space-y-2 pt-2 border-t border-surface-variant\">\n<div class=\"flex justify-between items-center\">\n<label class=\"text-label-md font-label-md text-on-surface font-semibold\">Tech Stack Required</label>\n<span class=\"text-label-sm font-label-sm text-secondary\">4 selected</span>\n</div>\n<div class=\"flex flex-wrap gap-1.5\">\n<button class=\"px-2.5 py-1 rounded bg-primary text-on-primary text-label-sm font-label-sm flex items-center gap-1 shadow-sm\">\n            React\n            <span class=\"material-symbols-outlined text-[14px]\" data-icon=\"close\">close</span>\n</button>\n<button class=\"px-2.5 py-1 rounded bg-primary text-on-primary text-label-sm font-label-sm flex items-center gap-1 shadow-sm\">\n            TypeScript\n            <span class=\"material-symbols-outlined text-[14px]\" data-icon=\"close\">close</span>\n</button>\n<button class=\"px-2.5 py-1 rounded bg-primary text-on-primary text-label-sm font-label-sm flex items-center gap-1 shadow-sm\">\n            Next.js\n            <span class=\"material-symbols-outlined text-[14px]\" data-icon=\"close\">close</span>\n</button>\n<button class=\"px-2.5 py-1 rounded bg-primary text-on-primary text-label-sm font-label-sm flex items-center gap-1 shadow-sm\">\n            Node.js\n            <span class=\"material-symbols-outlined text-[14px]\" data-icon=\"close\">close</span>\n</button>\n<button class=\"px-2 py-1 rounded bg-surface-container border border-surface-variant text-on-surface-variant text-label-sm font-label-sm hover:bg-surface-container-high transition-colors\">\n            + Tailwind\n          </button>\n<button class=\"px-2 py-1 rounded bg-surface-container border border-surface-variant text-on-surface-variant text-label-sm font-label-sm hover:bg-surface-container-high transition-colors\">\n            + GraphQL\n          </button>\n</div>\n</div>\n<!-- Location / Remote Toggle -->\n<div class=\"space-y-2 pt-2 border-t border-surface-variant\">\n<label class=\"text-label-md font-label-md text-on-surface font-semibold block\">Workplace Model</label>\n<div class=\"grid grid-cols-3 gap-1 p-1 bg-surface-container rounded-lg text-center text-label-sm font-label-sm\">\n<button class=\"py-1 rounded bg-surface-container-lowest text-primary font-semibold shadow-xs\">All</button>\n<button class=\"py-1 rounded text-secondary hover:text-on-surface\">Remote</button>\n<button class=\"py-1 rounded text-secondary hover:text-on-surface\">Hybrid</button>\n</div>\n</div>\n<!-- Salary Range -->\n<div class=\"space-y-2 pt-2 border-t border-surface-variant\">\n<div class=\"flex justify-between items-center\">\n<label class=\"text-label-md font-label-md text-on-surface font-semibold\">Base Compensation</label>\n<span class=\"text-label-sm font-label-sm text-primary font-bold\">$90k – $130k+</span>\n</div>\n<div class=\"grid grid-cols-2 gap-2\">\n<div class=\"px-2 py-1 bg-surface-container rounded border border-surface-variant text-body-sm font-body-sm text-on-surface\">\n<span class=\"text-secondary text-label-sm font-label-sm block\">Min</span>\n            $90,000\n          </div>\n<div class=\"px-2 py-1 bg-surface-container rounded border border-surface-variant text-body-sm font-body-sm text-on-surface\">\n<span class=\"text-secondary text-label-sm font-label-sm block\">Max</span>\n            $140,000+\n          </div>\n</div>\n</div>\n<!-- Export Readiness CTA -->\n<div class=\"pt-3 border-t border-surface-variant\">\n<button class=\"w-full py-2 px-3 rounded-lg bg-surface-container hover:bg-surface-container-high text-primary font-label-md text-label-md flex items-center justify-center gap-1.5 transition-colors border border-surface-variant\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"file_download\">file_download</span>\n          Export Readiness Report\n        </button>\n</div>\n</aside>\n<!-- 2. Central Main Feed (flex-1) -->\n<main class=\"flex-1 min-w-0 space-y-4\">\n<!-- Hero Banner: Alex's Skill Profile Match Summary -->\n<section class=\"bg-surface-container-lowest border border-surface-variant rounded-xl p-5 shadow-sm relative overflow-hidden\">\n<!-- Subtle ambient radial highlight -->\n<div class=\"absolute -right-16 -top-16 w-56 h-56 bg-primary/5 rounded-full blur-2xl pointer-events-none\"></div>\n<div class=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n<div class=\"space-y-1.5\">\n<div class=\"flex items-center gap-2\">\n<span class=\"px-2.5 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed text-label-sm font-label-sm font-bold flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\" data-icon=\"auto_awesome\">auto_awesome</span>\n                AI Profile Telemetry Active\n              </span>\n<span class=\"text-secondary text-label-sm font-label-sm\">• Target: Junior Frontend Engineer</span>\n</div>\n<h1 class=\"text-headline-md font-headline-md text-on-surface\">\n              88% Average Alignment for Frontend Roles\n            </h1>\n<p class=\"text-body-md font-body-md text-secondary max-w-