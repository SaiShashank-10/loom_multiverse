styles and structure from JSON) -->\n<header class=\"flex items-center justify-between px-6 py-3 w-full border-b border-surface-variant dark:border-outline-variant bg-surface-container-lowest dark:bg-surface-container-low sticky top-0 z-40 shadow-sm\">\n<!-- Left Section: Brand Logo & Search -->\n<div class=\"flex items-center gap-6\">\n<div class=\"flex items-center gap-2\">\n<div class=\"w-8 h-8 rounded-lg bg-primary flex items-center justify-center text-on-primary\">\n<span class=\"material-symbols-outlined text-lg\" data-icon=\"polyline\">polyline</span>\n</div>\n<a class=\"text-title-md font-title-md font-bold tracking-tight text-primary dark:text-inverse-primary\" href=\"#\">CareerPath</a>\n</div>\n<!-- Search Input on Left -->\n<div class=\"relative w-72 hidden md:block\">\n<span class=\"material-symbols-outlined absolute left-3 top-2.5 text-secondary text-lg\" data-icon=\"search\">search</span>\n<input class=\"w-full pl-9 pr-3 py-1.5 text-body-md bg-surface-bright border border-surface-variant rounded-lg text-on-surface placeholder:text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all\" placeholder=\"Search roles, skills, or companies...\" type=\"text\"/>\n</div>\n</div>\n<!-- Center Section: Navigation Links -->\n<nav class=\"hidden lg:flex items-center gap-6 text-label-lg font-label-lg\">\n<a class=\"border-b-2 border-primary dark:border-inverse-primary text-primary dark:text-inverse-primary font-semibold pb-1\" href=\"#\">Job Match</a>\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors\" href=\"#\">Gap Analysis</a>\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors\" href=\"#\">Learning Roadmaps</a>\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors\" href=\"#\">Applications</a>\n</nav>\n<!-- Right Section: Trailing Actions & Profile -->\n<div class=\"flex items-center gap-3\">\n<!-- Trailing Primary Action: Match Score -->\n<div class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed text-label-sm font-label-sm font-semibold\">\n<span class=\"material-symbols-outlined text-sm\" data-icon=\"bolt\" data-weight=\"fill\" style=\"font-variation-settings: 'FILL' 1;\">bolt</span>\n<span>Match Score: 88%</span>\n</div>\n<!-- Trailing Secondary Action -->\n<button class=\"hidden sm:flex items-center gap-1 px-3 py-1.5 rounded-lg border border-surface-variant hover:bg-surface-container text-secondary hover:text-on-surface text-label-md font-label-md transition-colors active:scale-[0.98]\">\n<span class=\"material-symbols-outlined text-base\" data-icon=\"rate_review\">rate_review</span>\n<span>Resume Review</span>\n</button>\n<!-- Trailing Icon Actions -->\n<div class=\"flex items-center gap-1 text-secondary\">\n<button class=\"p-1.5 rounded-lg hover:bg-surface-container transition-colors\" title=\"Notifications\">\n<span class=\"material-symbols-outlined text-lg\" data-icon=\"notifications\">notifications</span>\n</button>\n<button class=\"p-1.5 rounded-lg hover:bg-surface-container transition-colors\" title=\"Messages\">\n<span class=\"material-symbols-outlined text-lg\" data-icon=\"chat_bubble\">chat_bubble</span>\n</button>\n<button class=\"p-1.5 rounded-lg hover:bg-surface-container transition-colors\" title=\"Settings\">\n<span class=\"material-symbols-outlined text-lg\" data-icon=\"settings\">settings</span>\n</button>\n</div>\n<!-- Candidate Profile Avatar -->\n<div class=\"flex items-center gap-2 pl-2 border-l border-surface-variant\">\n<div class=\"relative\">\n<img class=\"w-8 h-8 rounded-full object-cover ring-1 ring-surface-variant\" data-alt=\"Close-up professional portrait of Alex Chen, an ambitious young software engineer wearing a dark sweater against an architectural studio backdrop with soft natural lighting and confident composure.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCoRR5IFvaraFW5V92UaQxwD1ziLaIKa76WtQWDQ2Pp61qhKrYljJZM_4-0HrN_dCYochzYJDvp5eCbu1_z6TsEhPvvO-0jy7ATraDUzfYs7_fGpzpDrbkhuJSGNX9lmh0iPCJILXARB7wEmaom3QstoAm5BRQboz7MfmWJhZypMbSNpDZeHkmTggs8NphEJOrHKcemV-UE-ZFlBkJjByh5UfK6dWwcJSxDuRSNsDiVpX-SHcf5UuRo8zuKxRlIv8vcMnLBo2-UvtO7\"/>\n<span class=\"absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-tertiary border-2 border-surface-container-lowest\" title=\"Active Job Search\"></span>\n</div>\n<span class=\"text-label-md font-label-md text-on-surface font-medium hidden xl:inline\">Alex Chen</span>\n</div>\n</div>\n</header>\n<!-- Main Content Canvas -->\n<main class=\"flex-1 max-w-[1280px] w-full mx-auto px-4 md:px-8 py-6\">\n<!-- Breadcrumb Bar -->\n<nav aria-label=\"Breadcrumb\" class=\"flex items-center gap-2 text-label-md font-label-md text-secondary mb-6\">\n<a class=\"hover:text-primary transition-colors\" href=\"#\">Jobs</a>\n<span class=\"material-symbols-outlined text-sm\" data-icon=\"chevron_right\">chevron_right</span>\n<a class=\"hover:text-primary transition-colors\" href=\"#\">Stripe</a>\n<span class=\"material-symbols-outlined text-sm\" data-icon=\"chevron_right\">chevron_right</span>\n<span class=\"text-on-surface font-semibold\">Junior Frontend Engineer</span>\n</nav>\n<!-- Wide Two-Column Split Desktop Layout -->\n<div class=\"flex flex-col lg:flex-row gap-8 items-start\">\n<!-- Left Column: Job Specifications & Role Deep-Dive (w-7/12) -->\n<section class=\"w-full lg:w-7/12 space-y-6\">\n<!-- Company & Role Header Card -->\n<div class=\"bg-surface-container-lowest border border-surface-variant rounded-xl p-6 shadow-sm\">\n<div class=\"flex items-start justify-between gap-4\">\n<div class=\"flex items-start gap-4\">\n<!-- Stripe Logo Badge -->\n<div class=\"w-14 h-14 rounded-xl bg-[#635BFF] flex items-center justify-center text-white shadow-sm flex-shrink-0\">\n<span class=\"text-2xl font-black tracking-tighter\">S</span>\n</div>\n<div>\n<div class=\"flex items-center gap-2 flex-wrap mb-1\">\n<h2 class=\"text-headline-md font-headline-md font-bold text-on-surface\">Stripe</h2>\n<span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed text-label-sm font-label-sm\">\n<span class=\"material-symbols-outlined text-xs\" data-icon=\"verified\" data-weight=\"fill\" style=\"font-variation-settings: 'FILL' 1;\">verified</span>\n                    Verified Recruiter\n                  </span>\n</div>\n<h1 class=\"text-headline-lg font-headline-lg font-bold text-on-surface mb-2\">Junior Frontend Engineer</h1>\n<div class=\"flex items-center gap-4 flex-wrap text-secondary text-body-md\">\n<span class=\"flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-base\" data-icon=\"location_on\">location_on</span>\n                    San Francisco, CA (Hybrid)\n                  </span>\n<span class=\"flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-base\" data-icon=\"schedule\">schedule</span>\n                    Posted 2 days ago\n                  </span>\n</div>\n</div>\n</div>\n<!-- Share & Save Quick Action -->\n<div class=\"flex items-center gap-1\">\n<button class=\"p-2 rounded-lg border border-surface-variant hover:bg-surface-container text-secondary hover:text-on-surface transition-colors\" title=\"Bookmark Role\">\n<span class=\"material-symbols-outlined text-lg\" data-icon=\"bookmark\">bookmark</span>\n</button>\n<button class=\"p-2 rounded-lg border border-surface-variant hover:bg-surface-container text-secondary hover:text-on-surface transition-colors\" title=\"Share Job\">\n<span class=\"material-symbols-outlined text-lg\" data-icon=\"share\">share</span>\n</button>\n</div>\n</div>\n<!-- Key Metatags Bar -->\n<div class=\"mt-6 pt-5 border-t border-surface-variant flex items-center gap-3 flex-wrap\">\n<div class=\"px-3 py-1.5 rounded-lg bg-surface-container-low border border-surface-variant text-on-surface font-semibold text-label-md flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-primary text-base\" data-icon=\"payments\">payments</span>\n              $105,000 - $125,000 / yr\n            </div>\n<div class=\"px-3 py-1.5 rounded-lg bg-surface-container text-on-surface-variant text-label-md font-medium flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-secondary text-base\" data-icon=\"business_center\">business_center</span>\n              Full-time\n            </div>\n<div class=\"px-3 py-1.5 rounded-lg bg-surface-container text-on-surface-variant text-label-md font-medium flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-secondary text-base\" data-icon=\"engineering\">engineering</span>\n              Engineering • Developer Dashboard\n            </div>\n</div>\n</div>\n<!-- CareerPath Match Analysis Banner (Bento Style) -->\n<div class=\"bg-surface-container-lowest border border-surface-variant rounded-xl p-6 shadow-sm relative overflow-hidden\">\n<div class=\"absolute top-0 right-0 w-32 h-32 bg-tertiary-fixed opacity-20 rounded-full blur-2xl -mr-10 -mt-10 pointer-events-none\"></div>\n<div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4\">\n<div>\n<div class=\"flex items-center gap-2\">\n<span class=\"w-3 h-3 rounded-full bg-tertiary animate-pulse\"></span>\n<span class=\"text-label-lg font-label-lg font-bold text-tertiary\">94% Match — High Compatibility</span>\n</div>\n<p class=\"text-body-sm text-secondary mt-0.5\">Based on Alex Chen's profile vs 75% average applicant pool compatibility</p>\n</div>\n<!-- Visual Mini Benchmark Progress -->\n<div class=\"flex items-center gap-3 bg-surface-container-low px-3 py-2 rounded-lg border border-surface-variant\">\n<div class=\"text-right\">\n<div class=\"text-label-sm font-semibold text-on-surface\">Alex: 94%</div>\n<div class=\"text-label-sm text-secondary\">Cohort Avg: 75%</div>\n</div>\n<div class=\"w-16 h-2 bg-surface-variant rounded-full overflow-hidden\">\n<div class=\"h-full bg-tertiary rounded-full\" style=\"width: 94%;\"></div>\n</div>\n</div>\n</div>\n<!-- Matched Skills Pills -->\n<div class=\"mt-3\">\n<div class=\"text-label-sm font-label-sm font-semibold text-secondary mb-2\">MATCHED SKILLS (5 VERIFIED)</div>\n<div class=\"flex flex-wrap gap-2\">\n<span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container text-on-surface text-label-sm border border-surface-variant\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary\"></span> React\n              </span>\n<span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container text-on-surface text-label-sm border border-surface-variant\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary\"></span> TypeScript\n              </span>\n<span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container text-on-surface text-label-sm border border-surface-variant\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary\"></span> Tailwind CSS\n              </span>\n<span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container text-on-surface text-label-sm border border-surface-variant\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary\"></span> Git\n              </span>\n<span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container text-on-surface text-label-sm border border-surface-variant\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary\"></span> HTML5 / CSS3\n              </span>\n</div>\n</div>\n<!-- Identified Skill Gap Card -->\n<div class=\"mt-4 p-3 rounded-lg bg-surface-bright border border-surface-variant flex items-center justify-between gap-3\">\n<div class=\"flex items-center gap-2.5\">\n<span class=\"material-symbols-outlined text-primary text-xl\" data-icon=\"lightbulb\">lightbulb</span>\n<div>\n<span class=\"text-label-sm font-bold text-on-surface\">Skill Gap Identified: Next.js SSR / SSG</span>\n<p class=\"text-body-sm text-secondary\">You are 1 roadmap module away from 99% alignment.</p>\n</div>\n</div>\n<button class=\"px-3 py-1 rounded text-label-sm font-semibold text-primary hover:bg-primary-fixed transition-colors\">\n              View Quick Module →\n            </button>\n</div>\n</div>\n<!-- About The Role Narrative -->\n<div class=\"bg-surface-container-lowest border border-surface-variant rounded-xl p-6 shadow-sm space-y-4\">\n<h3 class=\"text-title-md font-title-md font-bold text-on-surface flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"description\">description</span>\n            About the Role\n          </h3>\n<p class=\"text-body-md text-on-surface-variant leading-relaxed\">\n            As a Junior Frontend Engineer on Stripe’s Developer Dashboard team, you will shape the foundation through which millions of global internet businesses manage their billing, analytics, and infrastructure. Our team crafts high-fidelity, exceptionally reliable web experiences that condense intricate financial mechanics into serene, intuitive workflows.\n          </p>\n<p class=\"text-body-md text-on-surface-variant leading-relaxed\">\n            You will work hand-in-hand with senior systems engineers, product designers, and technical writers to ship accessible, lightning-fast UI components. We value crisp execution, deep curiosity about modern JavaScript runtimes, and a genuine obsession with developer ergonomics.\n          </p>\n</div>\n<!-- Core Responsibilities -->\n<div class=\"bg-surface-container-lowest border border-surface-variant rounded-xl p-6 shadow-sm space-y-4\">\n<h3 class=\"text-title-md font-title-md font-bold text-on-surface flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"task_alt\">task_alt</span>\n            Core Responsibilities\n          </h3>\n<ul class=\"space-y-3 text-body-md text-on-surface-variant\">\n<li class=\"flex items-start gap-3\">\n<span class=\"material-symbols-outlined text-primary text-lg mt-0.5\" data-icon=\"check_circle\">check_circle</span>\n<span>Architect, implement, and maintain modular, WCAG AA compliant UI components using React, TypeScript, and modern CSS tooling.</span>\n</li>\n<li class=\"flex items-start gap-3\">\n<span class=\"material-symbols-outlined text-primary text-lg mt-0.5\" data-icon=\"check_circle\">check_circle</span>\n<span>Collaborate tightly with product designers and backend API engineers to translate wireframes and OpenAPI schemas into fluid state machines.</span>\n</li>\n<li class=\"flex items-start gap-3\">\n<span class=\"material-symbols-outlined text-primary text-lg mt-0.5\" data-icon=\"check_circle\">check_circle</span>\n<span>Write reliable, deterministic unit and integration test suites using Jest and React Testing Library to sustain >90% branch coverage.</span>\n</li>\n<li class=\"flex items-start gap-3\">\n<span class=\"material-symbols-outlined text-primary text-lg mt-0.5\" data-icon=\"check_circle\">check_circle</span>\n<span>Diagnose client-side performance bottlenecks, profile Core Web Vitals, and contribute to Stripe’s enterprise design token infrastructure.</span>\n</li>\n</ul>\n</div>\n<!-- Technical Qualifications: Must-Have vs Nice-to-Have -->\n<div class=\"bg-surface-container-lowest border border-surface-variant rounded-xl p-6 shadow-sm space-y-5\">\n<h3 class=\"text-title-md font-title-md font-bold text-on-surface flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"psychology\">psychology</span>\n            Technical Qualifications\n          </h3>\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n<!-- Must Haves -->\n<div class=\"p-4 rounded-lg bg-surface-container-low border border-surface-variant\">\n<div class=\"flex items-center gap-1.5 text-label-md font-bold text-on-surface mb-3\">\n<span class=\"material-symbols-outlined text-primary text-base\" data-icon=\"star\" data-weight=\"fill\" style=\"font-variation-settings: 'FILL' 1;\">star</span>\n                Must-Have Qualifications\n              </div>\n<ul class=\"space-y-2 text-body-sm text-on-surface-variant\">\n<li class=\"flex items-start gap-2\">\n<span class=\"text-primary font-bold\">•</span>\n<span>1+ years of modern JavaScript (ES6+) and React development experience.</span>\n</li>\n<li class=\"flex items-start gap-2\">\n<span class=\"text-primary font-bold\">•</span>\n<span>Solid understanding of TypeScript typing models and asynchronous flow.</span>\n</li>\n<li class=\"flex items-start gap-2\">\n<span class=\"text-primary font-bold\">•</span>\n<span>Strong command of CSS box model, semantic HTML5, and responsive design.</span>\n</li>\n<li class=\"flex items-start gap-2\">\n<span class=\"text-primary font-bold\">•</span>\n<span>Familiarity with Git branching, pull request code reviews, and CI/CD pipelines.</span>\n</li>\n</ul>\n</div>\n<!-- Nice to Haves -->\n<div class=\"p-4 rounded-lg bg-surface-bright border border-surface-variant\">\n<div class=\"flex items-center gap-1.5 text-label-md font-bold text-secondary mb-3\">\n<span class=\"material-symbols-outlined text-secondary text-base\" data-icon=\"add_circle\">add_circle</span>\n                Nice-to-Have Bonus\n              </div>\n<ul class=\"space-y-2 text-body-sm text-on-surface-variant\">\n<li class=\"flex items-start gap-2\">\n<span class=\"text-secondary font-bold\">•</span>\n<span>Experience with Next.js or React Server Components architecture.</span>\n</li>\n<li class=\"flex items-start gap-2\">\n<span class=\"text-secondary font-bold\">•</span>\n<span>Background working with GraphQL APIs or React Query cache normalization.</span>\n</li>\n<li class=\"flex items-start gap-2\">\n<span class=\"text-secondary font-bold\">•</span>\n<span>Prior contributions to public open-source libraries or design systems.