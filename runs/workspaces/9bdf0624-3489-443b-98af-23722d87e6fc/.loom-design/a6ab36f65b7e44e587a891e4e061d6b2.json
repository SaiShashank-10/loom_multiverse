  "html": "<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Junior Frontend Engineer at Stripe - CareerPath</title>\n<!-- Material Symbols Outlined -->\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Roboto+Flex:wght@100..900&display=swap\" rel=\"stylesheet\"/>\n<!-- Tailwind CSS CDN -->\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          \"colors\": {\n            \"surface-container-low\": \"#eff4fc\",\n            \"on-tertiary\": \"#ffffff\",\n            \"inverse-primary\": \"#adc7ff\",\n            \"secondary\": \"#575f67\",\n            \"outline\": \"#717786\",\n            \"tertiary\": \"#006b24\",\n            \"outline-variant\": \"#c1c6d7\",\n            \"surface-bright\": \"#f7f9ff\",\n            \"secondary-fixed\": \"#dbe4ed\",\n            \"primary\": \"#0059bb\",\n            \"tertiary-fixed\": \"#83fc8e\",\n            \"on-primary\": \"#ffffff\",\n            \"on-error\": \"#ffffff\",\n            \"primary-fixed\": \"#d8e2ff\",\n            \"tertiary-fixed-dim\": \"#66df75\",\n            \"primary-fixed-dim\": \"#adc7ff\",\n            \"on-tertiary-fixed\": \"#002106\",\n            \"on-surface-variant\": \"#414754\",\n            \"on-error-container\": \"#93000a\",\n            \"secondary-container\": \"#d8e1ea\",\n            \"inverse-on-surface\": \"#ecf1f9\",\n            \"surface-container\": \"#e9eef6\",\n            \"on-primary-container\": \"#fefcff\",\n            \"background\": \"#f7f9ff\",\n            \"on-surface\": \"#161c22\",\n            \"primary-container\": \"#0070ea\",\n            \"on-primary-fixed-variant\": \"#004493\",\n            \"secondary-fixed-dim\": \"#bfc8d0\",\n            \"tertiary-container\": \"#008730\",\n            \"surface-container-lowest\": \"#ffffff\",\n            \"surface-tint\": \"#005bc0\",\n            \"on-background\": \"#161c22\",\n            \"on-secondary\": \"#ffffff\",\n            \"surface-variant\": \"#dde3eb\",\n            \"on-secondary-fixed\": \"#141d23\",\n            \"surface\": \"#f7f9ff\",\n            \"surface-dim\": \"#d5dae2\",\n            \"on-secondary-container\": \"#5b646b\",\n            \"on-tertiary-fixed-variant\": \"#00531a\",\n            \"inverse-surface\": \"#2b3137\",\n            \"error-container\": \"#ffdad6\",\n            \"surface-container-high\": \"#e3e9f0\",\n            \"on-secondary-fixed-variant\": \"#3f484f\",\n            \"on-primary-fixed\": \"#001a41\",\n            \"surface-container-highest\": \"#dde3eb\",\n            \"on-tertiary-container\": \"#f7fff2\",\n            \"error\": \"#ba1a1a\"\n          },\n          \"borderRadius\": {\n            \"DEFAULT\": \"0.125rem\",\n            \"lg\": \"0.25rem\",\n            \"xl\": \"0.5rem\",\n            \"full\": \"0.75rem\"\n          },\n          \"spacing\": {\n            \"margin\": \"2rem\",\n            \"space-xs\": \"0.25rem\",\n            \"space-lg\": \"1.5rem\",\n            \"space-md\": \"1rem\",\n            \"gutter-mobile\": \"1rem\",\n            \"space-xl\": \"2.5rem\",\n            \"space-sm\": \"0.5rem\",\n            \"margin-mobile\": \"1rem\",\n            \"gutter\": \"1.5rem\"\n          },\n          \"fontFamily\": {\n            \"headline-sm\": [\"Roboto Flex\"],\n            \"display\": [\"Roboto Flex\"],\n            \"label-lg\": [\"Roboto Flex\"],\n            \"headline-md\": [\"Roboto Flex\"],\n            \"body-sm\": [\"Roboto Flex