"#d8e1ea\",\n            \"inverse-on-surface\": \"#ecf1f9\",\n            \"surface-container\": \"#e9eef6\",\n            \"on-primary-container\": \"#fefcff\",\n            \"background\": \"#f7f9ff\",\n            \"on-surface\": \"#161c22\",\n            \"primary-container\": \"#0070ea\",\n            \"on-primary-fixed-variant\": \"#004493\",\n            \"secondary-fixed-dim\": \"#bfc8d0\",\n            \"tertiary-container\": \"#008730\",\n            \"surface-container-lowest\": \"#ffffff\",\n            \"surface-tint\": \"#005bc0\",\n            \"on-background\": \"#161c22\",\n            \"on-secondary\": \"#ffffff\",\n            \"surface-variant\": \"#dde3eb\",\n            \"on-secondary-fixed\": \"#141d23\",\n            \"surface\": \"#f7f9ff\",\n            \"surface-dim\": \"#d5dae2\",\n            \"on-secondary-container\": \"#5b646b\",\n            \"on-tertiary-fixed-variant\": \"#00531a\",\n            \"inverse-surface\": \"#2b3137\",\n            \"error-container\": \"#ffdad6\",\n            \"surface-container-high\": \"#e3e9f0\",\n            \"on-secondary-fixed-variant\": \"#3f484f\",\n            \"on-primary-fixed\": \"#001a41\",\n            \"surface-container-highest\": \"#dde3eb\",\n            \"on-tertiary-container\": \"#f7fff2\",\n            \"error\": \"#ba1a1a\"\n          },\n          \"borderRadius\": {\n            \"DEFAULT\": \"0.125rem\",\n            \"lg\": \"0.25rem\",\n            \"xl\": \"0.5rem\",\n            \"full\": \"0.75rem\"\n          },\n          \"spacing\": {\n            \"margin\": \"2rem\",\n            \"space-xs\": \"0.25rem\",\n            \"space-lg\": \"1.5rem\",\n            \"space-md\": \"1rem\",\n            \"gutter-mobile\": \"1rem\",\n            \"space-xl\": \"2.5rem\",\n            \"space-sm\": \"0.5rem\",\n            \"margin-mobile\": \"1rem\",\n            \"gutter\": \"1.5rem\"\n          },\n          \"fontFamily\": {\n            \"headline-sm\": [\"Roboto Flex\"],\n            \"display\": [\"Roboto Flex\"],\n            \"label-lg\": [\"Roboto Flex\"],\n            \"headline-md\": [\"Roboto Flex\"],\n            \"body-sm\": [\"Roboto Flex\"],\n            \"body-md\": [\"Roboto Flex\"],\n            \"headline-lg\": [\"Roboto Flex\"],\n            \"body-lg\": [\"Roboto Flex\"],\n            \"title-md\": [\"Roboto Flex\"],\n            \"label-md\": [\"Roboto Flex\"],\n            \"label-sm\": [\"Roboto Flex\"],\n            \"headline-lg-mobile\": [\"Roboto Flex\"]\n          },\n          \"fontSize\": {\n            \"headline-sm\": [\"20px\", { \"lineHeight\": \"28px\", \"fontWeight\": \"600\" }],\n            \"display\": [\"48px\", { \"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }],\n            \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }],\n            \"headline-md\": [\"24px\", { \"lineHeight\": \"32px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"600\" }],\n            \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }],\n            \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }],\n            \"headline-lg\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }],\n            \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }],\n            \"title-md\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }],\n            \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }],\n            \"label-sm\": [\"11px\", { \"lineHeight\": \"14px\", \"letterSpacing\": \"0.03em\", \"fontWeight\": \"500\" }],\n            \"headline-lg-mobile\": [\"26px\", { \"lineHeight\": \"34px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }]\n          }\n        }\n      }\n    }\n  </script>\n</head>\n<body class=\"bg-background text-on-surface antialiased min-h-screen flex flex-col font-body-md text-body-md\">\n<!-- TopNavBar (Shared Component JSON faithfully mapped) -->\n<header class=\"flex items-center justify-between px-6 py-3 w-full border-b border-surface-variant dark:border-outline-variant bg-surface-container-lowest dark:bg-surface-container-low sticky top-0 z-40 shadow-sm\">\n<!-- Left: Brand Logo & Global Search -->\n<div class=\"flex items-center gap-6\">\n<a class=\"text-title-md font-title-md font-bold tracking-tight text-primary dark:text-inverse-primary flex items-center gap-2\" href=\"#\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"route\" style=\"font-variation-settings: 'FILL' 1;\">route</span>\n<span>CareerPath</span>\n</a>\n<!-- Search Bar on left -->\n<div class=\"relative hidden lg:block w-72\">\n<span class=\"absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-secondary\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"search\">search</span>\n</span>\n<input class=\"w-full pl-9 pr-3 py-1.5 text-body-sm font-body-sm bg-surface-bright border border-surface-variant rounded-lg text-on-surface placeholder:text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all\" placeholder=\"Search skills, companies, roadmaps...\" type=\"text\"/>\n</div>\n</div>\n<!-- Center Navigation Links -->\n<nav class=\"hidden md:flex items-center gap-6\">\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors font-label-lg text-label-lg\" href=\"#\">Job Match</a>\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors font-label-lg text-label-lg\" href=\"#\">Gap Analysis</a>\n<!-- Active Link: Learning Roadmaps -->\n<a class=\"border-b-2 border-primary dark:border-inverse-primary text-primary dark:text-inverse-primary font-semibold pb-1 font-label-lg text-label-lg flex items-center gap-1.5\" href=\"#\">\n<span>Learning Roadmaps</span>\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary inline-block\"></span>\n</a>\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors font-label-lg text-label-lg\" href=\"#\">Applications</a>\n</nav>\n<!-- Right Trailing Actions & Profile -->\n<div class=\"flex items-center gap-3\">\n<!-- Trailing Primary Action: Match Score -->\n<div class=\"hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full bg-tertiary/10 border border-tertiary/20 text-tertiary font-label-md text-label-md font-semibold\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary animate-pulse\"></span>\n<span>Match Score: 88%</span>\n</div>\n<!-- Trailing Secondary Action -->\n<button class=\"hidden xl:inline-flex items-center px-3 py-1.5 rounded-lg border border-secondary text-secondary hover:bg-surface-container font-label-md text-label-md transition-colors\">\n        Resume Review\n      </button>\n<!-- Icon Actions -->\n<div class=\"flex items-center gap-1 text-secondary\">\n<button aria-label=\"Notifications\" class=\"p-2 rounded-lg hover:bg-surface-container transition-colors relative\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"notifications\">notifications</span>\n<span class=\"absolute top-1.5 right-1.5 w-2 h-2 bg-primary rounded-full\"></span>\n</button>\n<button aria-label=\"Messages\" class=\"p-2 rounded-lg hover:bg-surface-container transition-colors\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"chat_bubble\">chat_bubble</span>\n</button>\n<button aria-label=\"Settings\" class=\"p-2 rounded-lg hover:bg-surface-container transition-colors\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"settings\">settings</span>\n</button>\n</div>\n<!-- Candidate Profile Avatar -->\n<div class=\"relative pl-1\">\n<img class=\"w-8 h-8 rounded-full border border-surface-variant object-cover shadow-sm\" data-alt=\"Candidate profile photo with active job search status featuring professional studio portraiture with subtle balanced lighting against a neutral backdrop, conveying upward mobility, technical competence, and career focus in clean modern framing.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCwp640jRs3NdTNb5jZ4PjDD1-xjDT8ZsutCIpPWQxZdS_t26tMcoPhFGJO9uGwZMl6H3RWxEX32BoJYsCXNKYLgWbAL3fGc0j9DX_Mf45qt3OMhJWZXiYuFS9QjBRSUJlcrTIAHwMpEEF27Upqb2BOmqjSta0zvwv7AyniCiDkq1AZ4R4OHv62yr7z792uj8AtVBuW7PUlzad2j6eWfHU2o-glReqWBT9zvtE_Zty48Re6p_fU3kbIaPMTzEgqwatfofD5712rDclQ\"/>\n<span class=\"absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-tertiary ring-2 ring-surface-container-lowest\"></span>\n</div>\n</div>\n</header>\n<!-- Main Content Layout with Sticky Sub-Navigation Shell -->\n<div class=\"flex flex-1 overflow-hidden\">\n<!-- SideNav (Shared Component JSON) -->\n<aside class=\"sticky top-[65px] left-0 h-[calc(100vh-65px)] w-64 p-4 hidden xl:flex flex-col justify-between border-r border-surface-variant dark:border-outline-variant bg-surface-container-lowest dark:bg-surface-container-low shrink-0 select-none\">\n<div class=\"space-y-4\">\n<!-- Assistant Header -->\n<div class=\"p-3 bg-surface-container rounded-xl border border-surface-variant/70 flex items-center gap-3\">\n<div class=\"w-9 h-9 rounded-lg bg-primary-container text-on-primary flex items-center justify-center shadow-sm\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"smart_toy\">smart_toy</span>\n</div>\n<div>\n<div class=\"text-label-md font-label-md text-on-surface font-semibold\">Navigation &amp; Filters</div>\n<div class=\"text-label-sm font-label-sm text-secondary flex items-center gap-1\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary inline-block\"></span>\n<span>AI Query Engine Active</span>\n</div>\n</div>\n</div>\n<!-- 5 Tabs as in JSON -->\n<nav class=\"space-y-1\">\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-secondary dark:text-secondary-fixed-dim hover:bg-surface-container dark:hover:bg-surface-container-high hover:text-on-surface transition-all font-label-lg text-label-lg\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"tune\">tune</span>\n<span>Curated Feed</span>\n</a>\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-secondary dark:text-secondary-fixed-dim hover:bg-surface-container dark:hover:bg-surface-container-high hover:text-on-surface transition-all font-label-lg text-label-lg\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"filter_list\">filter_list</span>\n<span>Filter Criteria</span>\n</a>\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-secondary dark:text-secondary-fixed-dim hover:bg-surface-container dark:hover:bg-surface-container-high hover:text-on-surface transition-all font-label-lg text-label-lg\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"bookmark\">bookmark</span>\n<span>Saved Roles</span>\n</a>\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-secondary dark:text-secondary-fixed-dim hover:bg-surface-container dark:hover:bg-surface-container-high hover:text-on-surface transition-all font-label-lg text-label-lg\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"description\">description</span>\n<span>Resume Versions</span>\n</a>\n<!-- Active Tab in context -->\n<a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg bg-primary-fixed dark:bg-on-primary-fixed-variant text-on-primary-fixed dark:text-primary-fixed font-semibold font-label-lg text-label-lg shadow-sm\" href=\"#\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"psychology\" style=\"font-variation-settings: 'FILL' 1;\">psychology</span>\n<span>Interview Prep</span>\n</a>\n</nav>\n</div>\n<!-- Footer CTA & Guidelines -->\n<div class=\"space-y-3 pt-4 border-t border-surface-variant\">\n<button class=\"w-full py-2 px-3 rounded-lg bg-primary text-on-primary font-label-md text-label-md font-semibold hover:bg-primary-container transition-colors flex items-center justify-center gap-2 shadow-sm\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"file_download\">file_download</span>\n<span>Export Readiness Report</span>\n</button>\n<div class=\"space-y-1\">\n<a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-secondary hover:bg-surface-container hover:text-on-surface transition-all font-label-sm text-label-sm\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"help_outline\">help_outline</span>\n<span>Help &amp; Guidelines</span>\n</a>\n<a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-secondary hover:bg-surface-container hover:text-on-surface transition-all font-label-sm text-label-sm\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"verified\">verified</span>\n<span>System Status</span>\n</a>\n</div>\n</div>\n</aside>\n<!-- Scrollable Canvas Area -->\n<main class=\"flex-1 overflow-y-auto bg-background\">\n<div class=\"max-w-[1280px] mx-auto px-6 py-8 space-y-8\">\n<!-- Target Horizon Hero Header -->\n<section class=\"bg-surface-container-lowest border border-surface-variant rounded-xl p-6 shadow-sm relative overflow-hidden\">\n<div class=\"absolute right-0 top-0 w-96 h-full bg-gradient-to-l from-primary/5 to-transparent pointer-events-none\"></div>\n<div class=\"flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10\">\n<!-- Left Info -->\n<div class=\"space-y-2 max-w-2xl\">\n<div class=\"flex flex-wrap items-center gap-2\">\n<span class=\"px-2.5 py-0.5 rounded-full text-label-sm font-label-sm bg-primary-fixed text-on-primary-fixed font-semibold tracking-wide\">\n                  TARGET CAREER PATHWAY\n                </span>\n<span class=\"text-label-sm font-label-sm text-secondary flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\" data-icon=\"update\">update</span>\n                  Updated 2 hours ago via Stripe &amp; Datadog Talent Graph\n                </span>\n</div>\n<h1 class=\"text-headline-md font-headline-md text-on-surface tracking-tight\">\n                Junior Frontend Engineer Target Horizon - Stripe, Datadog &amp; High-Growth Tech\n              </h1>\n<p class=\"text-body-md font-body-md text-secondary\">\n                Personalized diagnostic roadmap bridging your React proficiency into elite production-grade frontend criteria. Clear these 3 phases to reach certified technical interview readiness.\n              </p>\n</div>\n<!-- Right KPI & Readyness Bento Card -->\n<div class=\"bg-surface-container-low border border-surface-variant rounded-xl p-4 min-w-[290px] space-y-3\">\n<div class=\"flex items-center justify-between\">\n<span class=\"text-label-sm font-label-sm text-secondary\">Current Overall Readiness</span>\n<span class=\"text-label-md font-label-md font-bold text-tertiary bg-tertiary/10 px-2 py-0.5 rounded-full flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\" data-icon=\"trending_up\">trending_up</span>\n                  +12% Potential\n                </span>\n</div>\n<div class=\"flex items-baseline gap-2\">\n<span class=\"text-display font-display text-primary leading-none\">88%</span>\n<span class=\"text-label-md font-label-md text-secondary\">/ 100% Target</span>\n</div>\n<!-- Progress Multi-bar -->\n<div class=\"space-y-1\">\n<div class=\"w-full bg-surface-variant h-2.5 rounded-full overflow-hidden flex\">\n<div class=\"bg-primary h-full rounded-full\" style=\"width: 88%;\"></div>\n<div class=\"bg-primary/30 h-full\" style=\"width: 12%;\"></div>\n</div>\n<div class=\"flex justify-between text-label-sm font-label-sm text-secondary pt-0.5\">\n<span class=\"flex items-center gap-1\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary inline-block\"></span>\n                    Benchmark: 85% for Screen\n                  </span>\n<span class=\"font-medium text-on-surface\">~9.5 hrs required</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- 3-Column Desktop Grid Layout (12-col grid split 7 / 5) -->\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n<!-- LEFT / MAIN COLUMN (col-span-7): Roadmap Timeline -->\n<div class=\"lg:col-span-7 space-y-6\">\n<div class=\"flex items-center justify-between\">\n<div>\n<h2 class=\"text-title-md font-title-md text-on-surface\">Target Skill Progression Sequence</h2>\n<p class=\"text-body-sm font-body-sm text-secondary\">Phased curriculum tailored to close current resume and technical audition gaps.</p>\n</div>\n<span class=\"text-label-sm font-label-sm text-secondary bg-surface-container px-2.5 py-1 rounded-lg border border-surface-variant\">\n                3 Milestones\n              </span>\n</div>\n<!-- Timeline Card 1: Critical Gap (High Priority) -->\n<div class=\"relative bg-surface-container-lowest border-2 border-primary/40 rounded-xl p-5 shadow-sm space-y-4 transition-all hover:border-primary\">\n<!-- Accent Indicator -->\n<div class=\"absolute -left-[2px] top-6 bottom-6 w-1.5 bg-primary rounded-r\"></div>\n<div class=\"flex items-start justify-between gap-3\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-8 h-8 rounded-lg bg-primary text-on-primary flex items-center justify-center font-bold text-label-lg font-label-lg\">\n                    1\n                  </div>\n<div>\n<div class=\"flex items-center gap-2\">\n<span class=\"px-2 py-0.5 rounded text-[10px] uppercase font-bold tracking-wider bg-error/10 text-error border border-error/20\">\n                        Critical Gap • High Priority\n                      </span>\n<span class=\"text-label-sm font-label-sm text-secondary flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\" data-icon=\"schedule\">schedule</span>\n                        ~4.0 hrs\n                      </span>\n</div>\n<h3 class=\"text-headline-sm font-headline-sm text-on-surface mt-1\">\n                      Next.js 14 App Router &amp; Server Components\n                    </h3>\n</div>\n</div>\n<span class=\"p-1 text-primary hover:bg-primary-fixed/30 rounded-lg cursor-pointer transition-colors\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"flag\">flag</span>\n</span>\n</div>\n<p class=\"text-body-md font-body-md text-on-surface-variant\">\n                Required by Stripe and Datadog junior roles. Replaces conventional client-side routing with server action boundaries, partial rendering, and granular hydration.\n              </p>\n<!-- Key Concepts Chips -->\n<div class=\"space-y-1.5\">\n<div class=\"text-label-sm font-label-sm font-semibold text-secondary uppercase tracking-wider\">Targeted Key Concepts</div>\n<div class=\"flex flex-wrap gap-2\">\n<span class=\"px-2.5 py-1 rounded bg-surface-container border border-surface-variant text-on-surface text-label-sm font-label-sm flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[14px] text-primary\" data-icon=\"check_circle\">check_circle</span>\n                    Server Actions\n                  </span>\n<span class=\"px-2.5 py-1 rounded bg-surface-container border border-surface-variant text-on-surface text-label-sm font-label-sm flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[14px] text-primary\" data-icon=\"check_circle\">check_circle</span>\n                    Streaming Suspense\n                  </span>\n<span class=\"px-2.5 py-1 rounded bg-surface-container border border-surface-variant text-on-surface text-label-sm font-label-sm flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[14px] text-primary\" data-icon=\"check_circle\">check_circle</span>\n                    Nested Layouts &amp; Route Handlers\n                  </span>\n</div>\n</div>\n<!-- Embedde