           \"display\": [\"Roboto Flex\"],\n            \"label-lg\": [\"Roboto Flex\"],\n            \"headline-md\": [\"Roboto Flex\"],\n            \"body-sm\": [\"Roboto Flex\"],\n            \"body-md\": [\"Roboto Flex\"],\n            \"headline-lg\": [\"Roboto Flex\"],\n            \"body-lg\": [\"Roboto Flex\"],\n            \"title-md\": [\"Roboto Flex\"],\n            \"label-md\": [\"Roboto Flex\"],\n            \"label-sm\": [\"Roboto Flex\"],\n            \"headline-lg-mobile\": [\"Roboto Flex\"]\n          },\n          \"fontSize\": {\n            \"headline-sm\": [\"20px\", { \"lineHeight\": \"28px\", \"fontWeight\": \"600\" }],\n            \"display\": [\"48px\", { \"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }],\n            \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }],\n            \"headline-md\": [\"24px\", { \"lineHeight\": \"32px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"600\" }],\n            \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }],\n            \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }],\n            \"headline-lg\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }],\n            \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }],\n            \"title-md\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }],\n            \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }],\n            \"label-sm\": [\"11px\", { \"lineHeight\": \"14px\", \"letterSpacing\": \"0.03em\", \"fontWeight\": \"500\" }],\n            \"headline-lg-mobile\": [\"26px\", { \"lineHeight\": \"34px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }]\n          }\n        }\n      }\n    }\n  </script>\n</head>\n<body class=\"bg-background text-on-surface font-body-md antialiased min-h-screen flex flex-col selection:bg-primary-fixed selection:text-on-primary-fixed\">\n<!-- TopNavBar (Shared Component JSON anchor) -->\n<header class=\"flex items-center justify-between px-6 py-3 w-full border-b border-surface-variant dark:border-outline-variant bg-surface-container-lowest dark:bg-surface-container-low sticky top-0 z-40 shadow-sm\">\n<!-- Left: Brand Logo & Global Search -->\n<div class=\"flex items-center gap-6\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[28px]\" data-icon=\"terminal\">terminal</span>\n<span class=\"text-title-md font-title-md font-bold tracking-tight text-primary dark:text-inverse-primary\">CareerPath</span>\n</div>\n<div class=\"relative hidden lg:block w-72\">\n<span class=\"material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]\" data-icon=\"search\">search</span>\n<input class=\"w-full pl-9 pr-3 py-1.5 text-body-md font-body-md bg-surface-container-lowest border border-surface-variant rounded-lg text-on-surface placeholder:text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all\" placeholder=\"Search competencies, roles, tools...\" type=\"text\"/>\n</div>\n</div>\n<!-- Center: Desktop Navigation Links -->\n<nav class=\"hidden md:flex items-center gap-8\">\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors text-label-lg font-label-lg\" href=\"#\">Job Match</a>\n<a class=\"border-b-2 border-primary dark:border-inverse-primary text-primary dark:text-inverse-primary font-semibold pb-1 text-label-lg font-label-lg flex items-center gap-1.5\" href=\"#\">\n<span>Gap Analysis</span>\n<span class=\"w-2 h-2 rounded-full bg-primary inline-block\"></span>\n</a>\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors text-label-lg font-label-lg\" href=\"#\">Learning Roadmaps</a>\n<a class=\"text-secondary dark:text-secondary-fixed-dim hover:text-on-surface dark:hover:text-inverse-on-surface font-medium transition-colors text-label-lg font-label-lg\" href=\"#\">Applications</a>\n</nav>\n<!-- Right: Trailing Actions & Profile -->\n<div class=\"flex items-center gap-3\">\n<div class=\"hidden sm:flex items-center gap-2 px-2.5 py-1 rounded-full bg-surface-container border border-surface-variant\">\n<span class=\"material-symbols-outlined text-tertiary text-[18px]\" data-icon=\"verified\" style=\"font-variation-settings: 'FILL' 1;\">verified</span>\n<span class=\"text-label-sm font-label-sm font-semibold text-on-surface\">Match Score: 88%</span>\n</div>\n<button class=\"hidden xl:inline-flex items-center justify-center px-3 py-1.5 rounded-lg border border-secondary text-secondary hover:bg-surface-container hover:text-on-surface text-label-lg font-label-lg transition-colors active:scale-[0.98]\">\n        Resume Review\n      </button>\n<div class=\"flex items-center gap-1 text-secondary\">\n<button class=\"p-1.5 rounded-lg hover:bg-surface-container hover:text-on-surface transition-colors\" title=\"Notifications\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"notifications\">notifications</span>\n</button>\n<button class=\"p-1.5 rounded-lg hover:bg-surface-container hover:text-on-surface transition-colors\" title=\"Messages\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"chat_bubble\">chat_bubble</span>\n</button>\n<button class=\"p-1.5 rounded-lg hover:bg-surface-container hover:text-on-surface transition-colors\" title=\"Settings\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"settings\">settings</span>\n</button>\n</div>\n<div class=\"h-6 w-px bg-surface-variant mx-1\"></div>\n<!-- Candidate profile avatar -->\n<div class=\"flex items-center gap-2 pl-1 cursor-pointer\">\n<div class=\"relative\">\n<img alt=\"Candidate profile photo with active job search status\" class=\"w-8 h-8 rounded-full object-cover border border-surface-variant\" data-alt=\"Close up professional headshot of a junior frontend software candidate looking forward with a confident smile in a bright contemporary tech workspace setting with subtle natural window light\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuB2UkTYBWUQrgQf5kSCxkn_E9BZx-DouI_xHfHUV2o2_7WRpL_-vDy6QTojShutGOld4y1IGe5033bkLUCQnx3lss-PstxDR8fr2AihcVNhGc2YwGl6Xcs4JjpE_KlrSOzjRce0nEh31Er6XXwZSRhIY_UtTeBrt8E40PO9I97abFSgxylmybZv7t9fO0YTunscIL8CXzzhJNua34MM8NgYnexodGyWAXL7R0Z2VShcH3OcQ-qfmoqnL8nsC1N2vIU4LZJH472PTCA8\"/>\n<span class=\"absolute bottom-0 right-0 w-2.5 h-2.5 bg-tertiary border-2 border-surface-container-lowest rounded-full\" title=\"Active Search\"></span>\n</div>\n<div class=\"hidden 2xl:block text-left\">\n<p class=\"text-label-md font-label-md text-on-surface leading-tight\">Alex Vance</p>\n<p class=\"text-label-sm font-label-sm text-secondary\">Frontend Dev</p>\n</div>\n</div>\n</div>\n</header>\n<!-- Sub-Header & Breadcrumb Bar -->\n<div class=\"bg-surface-container-lowest border-b border-surface-variant px-6 py-3\">\n<div class=\"max-w-[1280px] mx-auto flex flex-col md:flex-row md:items-center justify-between gap-3\">\n<!-- Breadcrumb -->\n<nav class=\"flex items-center gap-2 text-label-md font-label-md text-secondary overflow-x-auto\">\n<a class=\"hover:text-primary transition-colors flex items-center gap-1\" href=\"#\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"work\">work</span>\n<span>Job Search</span>\n</a>\n<span class=\"material-symbols-outlined text-[14px] text-outline-variant\" data-icon=\"chevron_right\">chevron_right</span>\n<span class=\"hover:text-primary transition-colors flex items-center gap-1.5\">\n<span class=\"w-4 h-4 rounded bg-[#635BFF] text-white flex items-center justify-center text-[10px] font-bold\">S</span>\n<span>Stripe - Junior Frontend Engineer</span>\n</span>\n<span class=\"material-symbols-outlined text-[14px] text-outline-variant\" data-icon=\"chevron_right\">chevron_right</span>\n<span class=\"text-on-surface font-semibold flex items-center gap-1 text-primary\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"analytics\">analytics</span>\n<span>Technical Gap Analysis</span>\n</span>\n</nav>\n<!-- Target Spec Pill Tag -->\n<div class=\"flex items-center gap-3 self-start md:self-auto\">\n<span class=\"px-2.5 py-1 rounded bg-surface-container text-secondary text-label-sm font-label-sm border border-surface-variant flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[14px]\" data-icon=\"payments\">payments</span>\n          $105,000 - $125,000 / yr\n        </span>\n<span class=\"px-2.5 py-1 rounded bg-primary-fixed text-on-primary-fixed text-label-sm font-label-sm font-semibold flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[14px]\" data-icon=\"location_on\">location_on</span>\n          San Francisco, CA (Hybrid)\n        </span>\n</div>\n</div>\n</div>\n<!-- Main Viewport Canvas -->\n<main class=\"flex-1 max-w-[1280px] w-full mx-auto px-4 md:px-6 py-6 flex flex-col gap-6\">\n<!-- Section 1: Prominent Role Alignment Dashboard Bento -->\n<section class=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n<!-- Overall Alignment Scorecard (7 cols on desktop) -->\n<div class=\"lg:col-span-7 bg-surface-container-lowest rounded-xl border border-surface-variant p-6 shadow-sm flex flex-col justify-between relative overflow-hidden\">\n<div class=\"absolute -right-6 -bottom-6 w-40 h-40 bg-surface-container rounded-full pointer-events-none opacity-40\"></div>\n<div>\n<div class=\"flex items-center justify-between mb-4\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[22px]\" data-icon=\"speed\">speed</span>\n<h2 class=\"text-headline-sm font-headline-sm text-on-surface\">Role Alignment Scorecard</h2>\n</div>\n<span class=\"px-2.5 py-0.5 rounded-full bg-emerald-50 text-tertiary border border-tertiary-fixed-dim text-label-sm font-label-sm font-semibold flex items-center gap-1\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary\"></span>\n              Competitive Candidacy\n            </span>\n</div>\n<div class=\"grid grid-cols-1 sm:grid-cols-12 gap-6 items-center\">\n<!-- Large Radial / Score Display -->\n<div class=\"sm:col-span-4 flex flex-col items-center justify-center p-3 bg-surface-bright rounded-xl border border-surface-variant\">\n<div class=\"relative flex items-center justify-center w-28 h-28\">\n<svg class=\"w-full h-full transform -rotate-90\" viewbox=\"0 0 100 100\">\n<circle cx=\"50\" cy=\"50\" fill=\"none\" r=\"42\" stroke=\"#dde3eb\" stroke-width=\"8\"></circle>\n<circle class=\"transition-all duration-700 ease-out\" cx=\"50\" cy=\"50\" fill=\"none\" id=\"score-ring\" r=\"42\" stroke=\"#0059bb\" stroke-dasharray=\"263.89\" stroke-dashoffset=\"15.83\" stroke-linecap=\"round\" stroke-width=\"8\"></circle>\n</svg>\n<div class=\"absolute inset-0 flex flex-col items-center justify-center text-center\">\n<span class=\"text-headline-lg font-headline-lg text-primary font-bold tracking-tight\" id=\"score-text\">94%</span>\n<span class=\"text-label-sm font-label-sm text-secondary\">Match Index</span>\n</div>\n</div>\n<p class=\"text-label-sm font-label-sm text-secondary mt-2 text-center\">Benchmark: &gt;80% for Interview</p>\n</div>\n<!-- Metric Breakdown Pillars -->\n<div class=\"sm:col-span-8 flex flex-col gap-3\">\n<div class=\"grid grid-cols-2 gap-3\">\n<div class=\"bg-surface-bright p-3 rounded-lg border border-surface-variant\">\n<span class=\"text-label-sm font-label-sm text-secondary flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary\" data-icon=\"check_circle\">check_circle</span>\n                    Skills Matched\n                  </span>\n<p class=\"text-headline-sm font-headline-sm text-on-surface mt-1\">5 <span class=\"text-body-sm font-body-sm text-secondary\">/ 7 required</span></p>\n</div>\n<div class=\"bg-surface-bright p-3 rounded-lg border border-surface-variant\">\n<span class=\"text-label-sm font-label-sm text-secondary flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px] text-error\" data-icon=\"warning\">warning</span>\n                    Critical Skill Gap\n                  </span>\n<p class=\"text-headline-sm font-headline-sm text-error mt-1\">1 <span class=\"text-body-sm font-body-sm text-secondary\">(Next.js RSC)</span></p>\n</div>\n</div>\n<!-- Secondary gap & boost alert strip -->\n<div class=\"p-2.5 rounded-lg bg-surface-container border border-surface-variant flex items-center justify-between text-body-sm font-body-sm\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[18px] text-outline\" data-icon=\"alt_route\">alt_route</span>\n<span class=\"text-on-surface\">Secondary: <strong>Docker Essentials</strong> (-40%)</span>\n</div>\n<span class=\"text-primary font-semibold flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"trending_up\">trending_up</span>\n                  +6% Remediation Potential\n                </span>\n</div>\n</div>\n</div>\n</div>\n<!-- Micro footer inside card -->\n<div class=\"mt-4 pt-3 border-t border-surface-variant flex items-center justify-between text-label-sm font-label-sm text-secondary\">\n<span>Stripe Job ID: #ST-89042 Frontend (Billing &amp; Connect Org)</span>\n<span class=\"text-on-surface font-medium\">Last automated sync: Today, 11:20 AM</span>\n</div>\n</div>\n<!-- ATS Automated Rejection Predictor Widget (5 cols on desktop) -->\n<div class=\"lg:col-span-5 bg-surface-container-lowest rounded-xl border border-surface-variant p-6 shadow-sm flex flex-col justify-between\">\n<div>\n<div class=\"flex items-center justify-between mb-3\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-tertiary text-[24px]\" data-icon=\"shield_with_heart\">shield_with_heart</span>\n<h2 class=\"text-headline-sm font-headline-sm text-on-surface\">ATS Screening Model</h2>\n</div>\n<span class=\"text-label-sm font-label-sm px-2 py-0.5 rounded bg-surface-container text-secondary font-medium\">Greenhouse Engine</span>\n</div>\n<p class=\"text-body-sm font-body-sm text-secondary mb-4\">\n            Parsed against Stripe's semantic recruiter parsing filters and historical qualifying thresholds for L3/New Grad candidates.\n          </p>\n<!-- Screening Pass Probability Gauge Card -->\n<div class=\"p-4 rounded-xl bg-gradient-to-br from-emerald-50/70 to-surface-bright border border-tertiary-fixed-dim\">\n<div class=\"flex items-center justify-between mb-2\">\n<span class=\"text-label-md font-label-md font-bold text-on-surface\">Screening Pass Probability</span>\n<span class=\"text-headline-sm font-headline-sm text-tertiary font-bold\">91%</span>\n</div>\n<!-- Dual-colored progress visual -->\n<div class=\"w-full bg-surface-variant rounded-full h-3 overflow-hidden mb-2\">\n<div class=\"bg-tertiary h-full rounded-full transition-all duration-500\" style=\"width: 91%\"></div>\n</div>\n<div class=\"flex items-center justify-between text-label-sm font-label-sm text-secondary\">\n<span class=\"text-tertiary font-semibold flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\" data-icon=\"check\" style=\"font-variation-settings: 'FILL' 1;\">check</span>\n                High Confidence Prediction\n              </span>\n<span class=\"font-medium text-on-surface\">Threshold: 74%</span>\n</div>\n</div>\n<!-- Applicant Tier Badge Callout -->\n<div class=\"mt-4 flex items-center gap-3 p-3 rounded-lg bg-surface-container border border-surface-variant\">\n<div class=\"w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"workspace_premium\">workspace_premium</span>\n</div>\n<div>\n<p class=\"text-label-md font-label-md text-on-surface font-semibold\">Top 5% Applicant Tier</p>\n<p class=\"text-body-sm font-body-sm text-secondary\">Your React &amp; TypeScript baseline outperforms 95% of parsed submissions for this role.</p>\n</div>\n</div>\n</div>\n<div class=\"mt-4 flex items-center justify-between text-label-sm font-label-sm text-secondary pt-3 border-t border-surface-variant\">\n<span class=\"flex items-center gap-1 text-tertiary font-semibold\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"lock\">lock</span>\n            Rejection Probability &lt; 9%\n          </span>\n<button class=\"text-primary hover:underline font-semibold flex items-center gap-0.5\">\n            View Heuristics\n            <span class=\"material-symbols-outlined text-[14px]\" data-icon=\"arrow_forward\">arrow_forward</span>\n</button>\n</div>\n</div>\n</section>\n<!-- Section 2: Two-Column Detailed Matrix Breakdown & Remediation Action Suite -->\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n<!-- LEFT COLUMN: Main Skill Matrix Breakdown (w-7/12 on desktop) -->\n<section class=\"lg:col-span-7 flex flex-col gap-4\">\n<!-- Header row -->\n<div class=\"flex items-center justify-between\">\n<div>\n<h3 class=\"text-title-md font-title-md text-on-surface\">Candidate Competency Matrix</h3>\n<p class=\"text-body-sm font-body-sm text-secondary\">Stripe Engineering Rubric benchmarked against verified repository code &amp; resume</p>\n</div>\n<div class=\"flex items-center gap-2\">\n<span class=\"text-label-sm font-label-sm text-secondary\">Legend:</span>\n<span class=\"inline-flex items-center gap-1 text-label-sm font-label-sm text-tertiary font-medium\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary\"></span> Matched\n            </span>\n<span class=\"inline-flex items-center gap-1 text-label-sm font-label-sm text-error font-medium\">\n<span clas