  "html": "<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>CareerPath - Technical Gap Analysis &amp; ATS Rejection Predictor</title>\n<!-- Fonts & Material Symbols -->\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Roboto+Flex:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Tailwind CSS -->\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          \"colors\": {\n            \"surface-container-low\": \"#eff4fc\",\n            \"on-tertiary\": \"#ffffff\",\n            \"inverse-primary\": \"#adc7ff\",\n            \"secondary\": \"#575f67\",\n            \"outline\": \"#717786\",\n            \"tertiary\": \"#006b24\",\n            \"outline-variant\": \"#c1c6d7\",\n            \"surface-bright\": \"#f7f9ff\",\n            \"secondary-fixed\": \"#dbe4ed\",\n            \"primary\": \"#0059bb\",\n            \"tertiary-fixed\": \"#83fc8e\",\n            \"on-primary\": \"#ffffff\",\n            \"on-error\": \"#ffffff\",\n            \"primary-fixed\": \"#d8e2ff\",\n            \"tertiary-fixed-dim\": \"#66df75\",\n            \"primary-fixed-dim\": \"#adc7ff\",\n            \"on-tertiary-fixed\": \"#002106\",\n            \"on-surface-variant\": \"#414754\",\n            \"on-error-container\": \"#93000a\",\n            \"secondary-container\": \"#