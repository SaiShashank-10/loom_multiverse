cument.getElementById('sim-nextjs').checked;\n      const dockerChecked = document.getElementById('sim-docker').checked;\n      \n      let baseScore = 94;\n      let atsScore = 91;\n      let boost = 0;\n\n      if (nextChecked) {\n        boost += 5;\n        atsScore += 5;\n      }\n      if (dockerChecked) {\n        boost += 1;\n        atsScore += 2;\n      }\n\n      const finalScore = baseScore + boost;\n      const finalAts = Math.min(atsScore, 99);\n\n      // Update UI elements\n      document.getElementById('sim-score').innerText = finalScore + '%';\n      document.getElementById('score-text').innerText = finalScore + '%';\n\n      const pill = document.getElementById('sim-pill');\n      if (boost > 0) {\n        pill.innerText = `+${boost}% Simulation Boost!`;\n        pill.className = \"text-label-sm font-label-sm text-tertiary font-bold animate-pulse\";\n      } else {\n        pill.innerText = \"Current baseline\";\n        pill.className = \"text-label-sm font-label-sm text-secondary\";\n      }\n\n      document.getElementById('sim-ats').innerText = `91% → ${finalAts}%`;\n\n      // Update score ring SVG dash offset\n      // Circumference = 263.89; (100 - score)% * 263.89 / 100\n      const ring = document.getElementById('score-ring');\n      const offset = 263.89 * ((100 - finalScore) / 100);\n      ring.style.strokeDashoffset = offset;\n      if (finalScore === 100) {\n        ring.setAttribute('stroke', '#006b24');\n      } else {\n        ring.setAttribute('stroke', '#0059bb');\n      }\n    }\n  </script>\n</body></html>",
