  "html": "<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>CareerPath - Job Search</title>\n<!-- Fonts -->\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Roboto+Flex:wght,GRAD,XOPQ,XTRA,YOPQ,YTAS,YTDE,YTFI,YTLC,YTUC@100..1000,0,96,468,79,750,-203,738,514,712&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Tailwind CSS -->\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          \"colors\": {\n            \"secondary-fixed\": \"#dbe4ed\",\n            \"surface-container-high\": \"#e3e9f0\",\n            \"outline-variant\": \"#c1c6d7\",\n            \"primary\": \"#0059bb\",\n            \"on-primary\": \"#ffffff\",\n            \"tertiary-fixed-dim\": \"#66df75\",\n            \"surface-dim\": \"#d5dae2\",\n            \"tertiary\": \"#006b24\",\n            \"on-surface\": \"#161c22\",\n            \"surface-tint\": \"#005bc0\",\n            \"primary-fixed-dim\": \"#adc7ff\",\n            \"on-tertiary\": \"#ffffff\",\n            \"tertiary-container\": \"#008730\",\n            \"on-error\": \"#ffffff\",\n            \"primary-fixed\": \"#d8e2ff\",\n            \"on-secondary-fixed-variant\": \"#3f484f\",\n            \"surface\": \"#f7f9ff\",\n            \"surface-bright\": \"#f7f9ff\",\n            \"on-primary-container\": \"#fefcff\",\n            \"on-background\": \"#161c22\",\n            \"on-tertiary-fixed-variant\": \"#00531a\",\n            \"secondary-container\": \"#d8e1ea\",\n            \"tertiary-fixed\": \"#83fc8e\",\n            \"inverse-primary\": \"#adc7ff\",\n            \"on-secondary-fixed\": \"#141d23\",\n            \"outline\": \"#717786\",\n            \"inverse-surface\": \"#2b3137\",\n            \"on-tertiary-container\": \"#f7fff2\",\n            \"inverse-on-surface\": \"#ecf1f9\",\n            \"surface-container-low\": \"#eff4fc\",\n            \"surface-container-lowest\": \"#ffffff\",\n            \"primary-container\": \"#0070ea\",\n            \"on-tertiary-fixed\": \"#002106\",\n            \"surface-container\": \"#e9eef6\",\n            \"on-primary-fixed-variant\": \"#004493\",\n            \"on-secondary\": \"#ffffff\",\n            \"error-container\": \"#ffdad6\",\n            \"surface-container-highest\": \"#dde3eb\",\n            \"surface-variant\": \"#dde3eb\",\n            \"on-secondary-container\": \"#5b646b\",\n            \"on-primary-fixed\": \"#001a41\",\n            \"secondary\": \"#575f67\",\n            \"on-surface-variant\": \"#414754\",\n            \"error\": \"#ba1a1a\",\n            \"background\": \"#f7f9ff\",\n            \"secondary-fixed-dim\": \"#bfc8d0\",\n            \"on-error-container\": \"#93000a\"\n          },\n          \"borderRadius\": {\n            \"DEFAULT\": \"0.125rem\",\n            \"lg\": \"0.25rem\",\n            \"xl\": \"0.5rem\",\n            \"full\": \"0.75rem\"\n          },\n          \"spacing\": {\n            \"space-xl\": \"2.5rem\",\n            \"gutter\": \"1.5rem\",\n            \"margin\": \"2rem\",\n            \"space-md\": \"1rem\",\n            \"margin-mobile\": \"1rem\",\n            \"gutter-mobile\": \"1rem\",\n            \"space-xs\": \"0.25rem\",\n            \"space-lg\": \"1.5rem\",\n            \"space-sm\": \"0.5rem\"\n          },\n          \"fontFamily\": {\n            \"label-md\": [\"Roboto Flex\"],\n            \"body-lg\": [\"Roboto Flex\"],\n            \"headline-sm\": [\"Roboto Flex\"],\n            \"display\": [\"Roboto Flex\"],\n            \"headline-md\": [\"Roboto Flex\"],\n            \"label-sm\": [\"Roboto Flex\"],\n            \"body-sm\": [\"Roboto Flex\"],\n            \"title-md\": [\"Roboto Flex\"],\n            \"headline-lg-mobile\": [\"Roboto Flex\"],\n            \"body-md\": [\"Roboto Flex\"],\n            \"headline-lg\": [\"Roboto Flex\"],\n            \"label-lg\": [\"Roboto Flex\"]\n          },\n          \"fontSize\": {\n            \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"600\" }],\n            \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }],\n            \"headline-sm\": [\"20px\", { \"lineHeight\": \"28px\", \"fontWeight\": \"600\" }],\n            \"display\": [\"48px\", { \"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }],\n            \"headline-md\": [\"24px\", { \"lineHeight\": \"32px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"600\" }],\n            \"label-sm\": [\"11px\", { \"lineHeight\": \"14px\", \"letterSpacing\": \"0.03em\", \"fontWeight\": \"500\" }],\n            \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }],\n            \"title-md\": [\"18px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"600\" }],\n            \"headline-lg-mobile\": [\"26px\", { \"lineHeight\": \"34px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }],\n            \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }],\n            \"headline-lg\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"700\" }],\n            \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"600\" }]\n          }\n        },\n      },\n    }\n  </script>\n<style>\n    .material-symbols-outlined {\n      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n      display: inline-block;\n      vertical-align: middle;\n      line-height: 1;\n    }\n    /* Hide scrollbars for clean filter strip */\n    .no-scrollbar::-webkit-scrollbar {\n      display: none;\n    }\n    .no-scrollbar {\n      -ms-overflow-style: none;\n      scrollbar-width: none;\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-surface text-on-surface antialiased min-h-screen flex flex-col font-body-md text-body-md selection:bg-primary-fixed selection:text-on-primary-fixed\">\n<!-- TOP APP BAR -->\n<header class=\"bg-surface-container-lowest dark:bg-inverse-surface flex justify-between items-center w-full px-margin-mobile h-14 sticky top-0 z-40 shadow-sm dark:shadow-none\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"flex items-center justify-center w-8 h-8 rounded-lg bg-primary-fixed text-primary\">\n<span class=\"material-symbols-outlined text-primary text-title-md\" data-icon=\"work\">work</span>\n</div>\n<span class=\"text-headline-sm font-headline-sm font-bold text-primary dark:text-inverse-primary tracking-tight\">CareerPath</span>\n</div>\n<div class=\"flex items-center gap-space-sm\">\n<button aria-label=\"Notifications\" class=\"relative p-space-xs rounded-lg text-secondary hover:bg-surface-container dark:hover:bg-surface-variant active:scale-95 transition-transform duration-150\">\n<span class=\"material-symbols-outlined\" data-icon=\"notifications\">notifications</span>\n<span class=\"absolute top-1 right-1 w-2 h-2 bg-error rounded-full ring-2 ring-surface-container-lowest\"></span>\n</button>\n<div class=\"w-8 h-8 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container font-label-md text-label-md ring-1 ring-outline-variant overflow-hidden\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Close up professional portrait of a software engineer candidate with subtle studio lighting, looking confident and poised against a modern clean office backdrop with high contrast clarity.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDJx9BuZkj_-FDt0x6B1BQjsFNhWUjEKRxwWPoHBrS9zV249yehh1E3ZyoV6OWmL2PcguSr3jQOdOf1t3ijB3mSPHqULI4FumBlQSHnXsP6AgIDiPRgaWm3sNbG_92n2eaiPwG79Zb_w_LBputsirthRAK4U7is9IqtyM13rVAGFXOoEMKB5oCk3PKu-0RkRt7pawnvaXtZZhJfTflMMAEc0XPy9Zt9oolYtodTdkinEn4jp5QFyb9sySyW2foq615ebn-DEUzU48H1\"/>\n</div>\n</div>\n</header>\n<!-- MAIN SCROLLABLE CONTENT CANVAS -->\n<main class=\"flex-1 w-full max-w-md mx-auto px-margin-mobile pt-space-md pb-24 flex flex-col gap-space-md\">\n<!-- SEARCH & FILTER SECTION -->\n<section class=\"flex flex-col gap-space-sm bg-surface-container-lowest p-space-md rounded-xl ring-1 ring-outline-variant shadow-sm\">\n<!-- Keyword Input -->\n<div class=\"relative flex items-center w-full\">\n<span class=\"material-symbols-outlined absolute left-3 text-secondary text-headline-sm\" data-icon=\"search\">search</span>\n<input class=\"w-full h-12 pl-10 pr-4 bg-surface rounded-lg ring-1 ring-outline-variant text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-2 focus:ring-primary focus:bg-surface-container-lowest transition-all\" placeholder=\"Job title, skills, or company...\" type=\"text\" value=\"Frontend Engineer, React\"/>\n</div>\n<!-- Location Input + Remote Toggle -->\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"relative flex-1 flex items-center\">\n<span class=\"material-symbols-outlined absolute left-3 text-secondary text-headline-sm\" data-icon=\"location_on\">location_on</span>\n<input class=\"w-full h-11 pl-10 pr-3 bg-surface rounded-lg ring-1 ring-outline-variant text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-2 focus:ring-primary focus:bg-surface-container-lowest transition-all\" placeholder=\"City, state or remote\" type=\"text\" value=\"San Francisco, CA\"/>\n</div>\n<label class=\"flex items-center gap-1.5 h-11 px-3 bg-surface-container-low rounded-lg ring-1 ring-outline-variant cursor-pointer select-none\">\n<input checked=\"\" class=\"w-4 h-4 rounded text-primary focus:ring-primary border-outline-variant\" type=\"checkbox\"/>\n<span class=\"font-label-sm text-label-sm text-on-surface whitespace-nowrap\">Remote</span>\n</label>\n</div>\n<!-- Quick Dropdown Selectors -->\n<div class=\"grid grid-cols-2 gap-space-sm pt-space-xs\">\n<button class=\"flex items-center justify-between h-9 px-3 bg-surface rounded-lg ring-1 ring-outline-variant font-label-md text-label-md text-on-surface hover:bg-surface-container active:scale-95 transition-all\">\n<span class=\"truncate\">Tech &amp; Software</span>\n<span class=\"material-symbols-outlined text-secondary text-label-lg\" data-icon=\"expand_more\">expand_more</span>\n</button>\n<button class=\"flex items-center justify-between h-9 px-3 bg-surface rounded-lg ring-1 ring-outline-variant font-label-md text-label-md text-on-surface hover:bg-surface-container active:scale-95 transition-all\">\n<span class=\"truncate\">Full-time</span>\n<span class=\"material-symbols-outlined text-secondary text-label-lg\" data-icon=\"expand_more\">expand_more</span>\n</button>\n</div>\n<!-- Scrollable Filter Chips -->\n<div class=\"flex items-center gap-space-xs overflow-x-auto no-scrollbar pt-space-xs pb-0.5 -mx-1 px-1\">\n<!-- Filter Toggle Button with Badge -->\n<button class=\"flex items-center gap-1 h-8 px-2.5 bg-primary text-on-primary rounded-lg font-label-sm text-label-sm shrink-0 shadow-sm active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined text-sm\" data-icon=\"tune\">tune</span>\n<span>Filters</span>\n<span class=\"w-4 h-4 rounded-full bg-surface-container-lowest text-primary font-bold flex items-center justify-center text-[10px]\">3</span>\n</button>\n<div class=\"h-5 w-px bg-outline-variant shrink-0 mx-0.5\"></div>\n<button class=\"flex items-center gap-1 h-8 px-2.5 bg-surface rounded-lg ring-1 ring-outline-variant font-label-sm text-label-sm text-on-surface shrink-0 hover:border-outline whitespace-nowrap\">\n<span>Exp: Entry (0-2 yrs)</span>\n<span class=\"material-symbols-outlined text-sm text-secondary\" data-icon=\"close\">close</span>\n</button>\n<button class=\"flex items-center gap-1 h-8 px-2.5 bg-surface rounded-lg ring-1 ring-outline-variant font-label-sm text-label-sm text-on-surface shrink-0 hover:border-outline whitespace-nowrap\">\n<span>Edu: Bachelor's</span>\n<span class=\"material-symbols-outlined text-sm text-secondary\" data-icon=\"close\">close</span>\n</button>\n<button class=\"flex items-center gap-1 h-8 px-2.5 bg-surface rounded-lg ring-1 ring-outline-variant font-label-sm text-label-sm text-on-surface shrink-0 hover:border-outline whitespace-nowrap\">\n<span>$90k - $130k+</span>\n<span class=\"material-symbols-outlined text-sm text-secondary\" data-icon=\"close\">close</span>\n</button>\n<button class=\"flex items-center gap-1 h-8 px-2.5 bg-tertiary-fixed text-on-tertiary-fixed rounded-lg font-label-sm text-label-sm shrink-0 ring-1 ring-tertiary font-semibold whitespace-nowrap\">\n<span class=\"material-symbols-outlined text-sm text-tertiary\" data-icon=\"verified\">verified</span>\n<span>Match &gt; 80%</span>\n</button>\n</div>\n</section>\n<!-- TECHNICAL GAP ANALYSIS & CAREER RECOMMENDATIONS HIGHLIGHT BANNER -->\n<section class=\"bg-gradient-to-br from-primary-fixed to-surface-container-low p-space-md rounded-xl ring-1 ring-primary/20 shadow-sm flex flex-col gap-space-sm relative overflow-hidden\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex items-center gap-2\">\n<div class=\"w-8 h-8 rounded-lg bg-primary text-on-primary flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-title-md\" data-icon=\"auto_awesome\">auto_awesome</span>\n</div>\n<div>\n<h2 class=\"font-headline-sm text-headline-sm text-on-surface leading-tight\">Skill Profile Match</h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Avg. 88% alignment for Frontend roles</p>\n</div>\n</div>\n<div class=\"text-right\">\n<span class=\"font-headline-md text-headline-md font-bold text-primary\">88%</span>\n</div>\n</div>\n<!-- Mini Progress & Gap Breakdown -->\n<div class=\"bg-surface-container-lowest/80 backdrop-blur-sm p-3 rounded-lg ring-1 ring-outline-variant/60 flex flex-col gap-2\">\n<div class=\"flex justify-between items-center text-label-sm font-label-sm\">\n<span class=\"text-on-surface font-medium\">3 Missing Skills to reach 95% target</span>\n<span class=\"text-primary font-bold\">Target 95%</span>\n</div>\n<div class=\"w-full bg-surface-container-high h-2 rounded-full overflow-hidden\">\n<div class=\"bg-primary h-full rounded-full transition-all duration-500\" style=\"width: 88%;\"></div>\n</div>\n<div class=\"flex items-center justify-between pt-1\">\n<span class=\"text-body-sm font-body-sm text-secondary\">Gaps: Next.js, Docker, WebGL</span>\n<a class=\"flex items-center gap-1 font-label-md text-label-md text-primary hover:underline font-bold\" href=\"#\">\n            Roadmap\n            <span class=\"material-symbols-outlined text-sm\" data-icon=\"arrow_forward\">arrow_forward</span>\n</a>\n</div>\n</div>\n</section>\n<!-- JOB SEARCH RESULTS FEED HEADER -->\n<div class=\"flex items-center justify-between pt-1 px-1\">\n<span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Showing 142 matched jobs</span>\n<button class=\"flex items-center gap-1 text-secondary font-label-sm text-label-sm hover:text-primary transition-colors\">\n<span>Sort: Best Match</span>\n<span class=\"material-symbols-outlined text-base\" data-icon=\"swap_vert\">swap_vert</span>\n</button>\n</div>\n<!-- JOB CARD 1 (Top Match - 94%) -->\n<article class=\"bg-surface-container-lowest rounded-xl p-space-md ring-1 ring-outline-variant shadow-sm hover:shadow-md transition-all flex flex-col gap-space-sm border-l-4 border-l-primary\">\n<div class=\"flex items-start justify-between gap-space-sm\">\n<div class=\"flex gap-3\">\n<div class=\"w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center font-bold text-headline-sm text-primary ring-1 ring-outline-variant shrink-0 overflow-hidden\">\n<span class=\"font-display text-headline-md tracking-tight\">S</span>\n</div>\n<div>\n<h3 class=\"font-title-md text-title-md font-bold text-on-surface\">Junior Frontend Engineer</h3>\n<p class=\"font-body-md text-body-md text-secondary\">Stripe • San Francisco, CA (Hybrid)</p>\n</div>\n</div>\n<button aria-label=\"Save Job\" class=\"text-secondary hover:text-primary p-1 active:scale-90 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"bookmark_border\">bookmark_border</span>\n</button>\n</div>\n<div class=\"flex flex-wrap items-center gap-2 pt-1\">\n<span class=\"font-label-md text-label-md text-on-surface bg-surface-container-low px-2 py-0.5 rounded-lg ring-1 ring-outline-variant font-bold\">$105k - $125k/yr</span>\n<span class=\"font-label-sm text-label-sm text-secondary bg-surface-container-low px-2 py-0.5 rounded-lg\">Full-time</span>\n<span class=\"font-label-sm text-label-sm text-secondary bg-surface-container-low px-2 py-0.5 rounded-lg\">Entry-Level</span>\n</div>\n<!-- Skill Match Pill -->\n<div class=\"flex items-center justify-between bg-tertiary-fixed/30 ring-1 ring-tertiary/20 px-3 py-1.5 rounded-lg\">\n<div class=\"flex items-center gap-1.5 text-tertiary font-label-md text-label-md font-bold\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary\"></span>\n<span>94% Skill Match</span>\n</div>\n<span class=\"font-label-sm text-label-sm text-on-tertiary-fixed-variant\">High Compatibility</span>\n</div>\n<!-- Skills breakdown badges -->\n<div class=\"flex flex-wrap gap-1.5 pt-1\">\n<span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-surface-container-low ring-1 ring-outline-var