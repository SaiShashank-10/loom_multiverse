ckground text-on-surface antialiased min-h-screen pb-24 selection:bg-primary-fixed selection:text-on-primary-fixed\">\n<!-- Mobile Viewport Wrapper (Centered on larger screens to simulate mobile UI fidelity) -->\n<div class=\"max-w-md mx-auto bg-surface-container-lowest min-h-screen relative shadow-2xl flex flex-col\">\n<!-- Top App Bar (Shared Components Anchor & Contextual Job Details Header) -->\n<header class=\"bg-surface-container-lowest sticky top-0 z-40 flex justify-between items-center w-full px-margin-mobile h-14 shadow-sm\">\n<div class=\"flex items-center space-x-2\">\n<a class=\"p-1 -ml-1 text-secondary hover:text-primary active:scale-95 transition-transform flex items-center\" href=\"#back\">\n<span class=\"material-symbols-outlined text-headline-sm\" data-icon=\"arrow_back\">arrow_back</span>\n</a>\n<span class=\"font-title-md text-title-md text-on-surface tracking-tight\">Job Details</span>\n</div>\n<div class=\"flex items-center space-x-1\">\n<!-- Bookmark Toggle Button -->\n<button aria-label=\"Bookmark Job\" class=\"p-2 text-primary hover:bg-surface-container rounded-full active:scale-95 transition-transform duration-150\" id=\"bookmarkBtn\" onclick=\"toggleBookmark()\">\n<span class=\"material-symbols-outlined text-headline-sm\" data-icon=\"bookmark\" id=\"bookmarkIcon\" style=\"font-variation-settings: 'FILL' 1;\">bookmark</span>\n</button>\n<!-- Share Action Button -->\n<button aria-label=\"Share Job\" class=\"p-2 text-secondary hover:text-primary hover:bg-surface-container rounded-full active:scale-95 transition-transform duration-150\" onclick=\"shareJob()\">\n<span class=\"material-symbols-outlined text-headline-sm\" data-icon=\"share\">share</span>\n</button>\n</div>\n</header>\n<!-- Main Content Canvas -->\n<main class=\"flex-1 px-margin-mobile pt-space-md space-y-space-lg\">\n<!-- Company Hero Block & Header Information -->\n<section class=\"bg-surface-container-lowest border border-outline-variant rounded-xl p-space-lg shadow-sm\">\n<div class=\"flex items-start gap-space-md\">\n<!-- Company Monogram / Logo Badge -->\n<div class=\"w-14 h-14 rounded-lg bg-primary flex items-center justify-center text-on-primary shadow-sm flex-shrink-0\">\n<span class=\"font-headline-md text-headline-md font-bold tracking-tight\">S</span>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center space-x-1.5 mb-1\">\n<span class=\"font-label-md text-label-md text-secondary\">Stripe</span>\n<span class=\"inline-block w-1 h-1 rounded-full bg-outline-variant\"></span>\n<span class=\"font-label-sm text-label-sm text-tertiary bg-surface-container-low px-1.5 py-0.5 rounded flex items-center gap-0.5\">\n<span class=\"material-symbols-outlined text-[12px]\" data-icon=\"verified\" style=\"font-variation-settings: 'FILL' 1;\">verified</span>\n                Verified\n              </span>\n</div>\n<h1 class=\"font-headline-lg-mobile text-headline-lg-mobile text-on-surface leading-tight font-bold mb-1\">\n              Junior Frontend Engineer\n            </h1>\n<p class=\"font-body-md text-body-md text-secondary flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px] text-secondary\" data-icon=\"location_on\">location_on</span>\n              San Francisco, CA <span class=\"text-outline-variant\">•</span> Hybrid\n            </p>\n</div>\n</div>\n<!-- Key Job Meta Pill Badges -->\n<div class=\"mt-space-md pt-space-md border-t border-surface-container flex flex-wrap gap-space-xs\">\n<div class=\"inline-flex items-center gap-1 px-2.5 py-1 bg-surface-container-low border border-outline-variant text-on-surface rounded font-label-md text-label-md\">\n<span class=\"material-symbols-outlined text-[14px] text-primary\" data-icon=\"payments\">payments</span>\n            $105k - $125k/yr\n          </div>\n<div class=\"inline-flex items-center gap-1 px-2.5 py-1 bg-surface-container-low border border-outline-variant text-on-surface rounded font-label-md text-label-md\">\n<span class=\"material-symbols-outlined text-[14px] text-secondary\" data-icon=\"schedule\">schedule</span>\n            Full-time\n          </div>\n<div class=\"inline-flex items-center gap-1 px-2.5 py-1 bg-surface-container-low border border-outline-variant text-on-surface rounded font-label-md text-label-md\">\n<span class=\"material-symbols-outlined text-[14px] text-secondary\" data-icon=\"school\">school</span>\n            Entry-Level\n          </div>\n<div class=\"inline-flex items-center gap-1 px-2.5 py-1 bg-surface-container-low border border-outline-variant text-secondary rounded font-label-md text-label-md\">\n<span class=\"material-symbols-outlined text-[14px] text-secondary\" data-icon=\"history\">history</span>\n            Posted 2 days ago\n          </div>\n</div>\n</section>\n<!-- Match & Technical Gap Analysis Card -->\n<section class=\"bg-surface-container-lowest border-2 border-tertiary-fixed rounded-xl p-space-lg shadow-sm relative overflow-hidden\">\n<!-- Top Accent Bar -->\n<div class=\"absolute top-0 left-0 right-0 h-1 bg-tertiary\"></div>\n<div class=\"flex items-center justify-between mb-space-md\">\n<div class=\"flex items-center gap-2\">\n<div class=\"w-8 h-8 rounded-full bg-surface-container-low flex items-center justify-center text-tertiary\">\n<span class=\"material-symbols-outlined text-headline-sm\" data-icon=\"auto_awesome\" style=\"font-variation-settings: 'FILL' 1;\">auto_awesome</span>\n</div>\n<div>\n<h2 class=\"font-title-md text-title-md text-on-surface\">Match Analysis</h2>\n<p class=\"font-body-sm text-body-sm text-secondary\">Based on your CareerPath profile</p>\n</div>\n</div>\n<!-- High Compatibility Pill Badge -->\n<div class=\"inline-flex items-center gap-1.5 px-3 py-1 bg-tertiary-fixed text-on-tertiary-fixed rounded-full font-label-md text-label-md\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary animate-pulse\"></span>\n            94% Match\n          </div>\n</div>\n<!-- Visual Progress Match Meter -->\n<div class=\"space-y-1.5 mb-space-lg\">\n<div class=\"flex justify-between font-label-sm text-label-sm\">\n<span class=\"text-on-surface font-semibold\">Your Candidate Compatibility</span>\n<span class=\"text-tertiary font-bold\">94% vs 75% Average</span>\n</div>\n<div class=\"w-full bg-surface-container rounded-full h-2.5 overflow-hidden flex\">\n<div class=\"bg-tertiary h-full rounded-full transition-all duration-500\" style=\"width: 94%\"></div>\n</div>\n</div>\n<!-- Detailed Breakdown Matrix -->\n<div class=\"space-y-space-md\">\n<!-- Matched Skills -->\n<div>\n<div class=\"flex items-center justify-between mb-2\">\n<span class=\"font-label-md text-label-md text-on-surface flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary\" data-icon=\"check_circle\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n                Matched Skills (5/7)\n              </span>\n<span class=\"font-label-sm text-label-sm text-secondary\">High Proficiency</span>\n</div>\n<div class=\"flex flex-wrap gap-1.5\">\n<span class=\"px-2.5 py-1 rounded-lg bg-surface-container-low border border-outline-variant font-label-sm text-label-sm text-on-surface flex items-center gap-1\">\n                React <span class=\"text-[10px] text-tertiary font-bold bg-white px-1 rounded\">Proficient</span>\n</span>\n<span class=\"px-2.5 py-1 rounded-lg bg-surface-container-low border border-outline-variant font-label-sm text-label-sm text-on-surface flex items-center gap-1\">\n                TypeScript <span class=\"text-[10px] text-tertiary font-bold bg-white px-1 rounded\">Proficient</span>\n</span>\n<span class=\"px-2.5 py-1 rounded-lg bg-surface-container-low border border-outline-variant font-label-sm text-label-sm text-on-surface flex items-center gap-1\">\n                Tailwind CSS <span class=\"text-[10px] text-tertiary font-bold bg-white px-1 rounded\">Proficient</span>\n</span>\n<span class=\"px-2.5 py-1 rounded-lg bg-surface-container-low border border-outline-variant font-label-sm text-label-sm text-on-surface\">Git</span>\n<span class=\"px-2.5 py-1 rounded-lg bg-surface-container-low border border-outline-variant font-label-sm text-label-sm text-on-surface\">HTML5 / CSS3</span>\n</div>\n</div>\n<!-- Skill Gaps / Recommendation Section -->\n<div class=\"pt-space-sm border-t border-surface-container\">\n<div class=\"flex items-center justify-between mb-2\">\n<span class=\"font-label-md text-label-md text-on-surface flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px] text-on-secondary-container\" data-icon=\"info\">info</span>\n                Skill Gaps & Accelerated Paths\n              </span>\n</div>\n<div class=\"space-y-2\">\n<!-- Gap 1: Next.js with direct action -->\n<div class=\"p-2.5 rounded-lg bg-surface-container-low border border-outline-variant flex flex-col space-y-1.5\">\n<div class=\"flex justify-between items-center\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary\"></span>\n<span class=\"font-label-md text-label-md text-on-surface\">Next.js</span>\n<span class=\"font-label-sm text-label-sm text-secondary\">(1 course away)</span>\n</div>\n<span class=\"font-label-sm text-label-sm text-primary font-semibold\">Fast Track</span>\n</div>\n<div class=\"bg-surface-container-lowest p-2 rounded border border-outline-variant flex items-center justify-between\">\n<div class=\"flex items-center space-x-2\">\n<span class=\"material-symbols-outlined text-[18px] text-primary\" data-icon=\"play_circle\">play_circle</span>\n<div>\n<p class=\"font-label-sm text-label-sm text-on-surface font-semibold leading-tight\">Next.js 14 App Router Deep Dive</p>\n<p class=\"font-body-sm text-[10px] text-secondary\">4h modular curriculum</p>\n</div>\n</div>\n<button class=\"px-2 py-1 bg-surface-container text-primary rounded font-label-sm text-label-sm hover:bg-primary hover:text-white transition-colors\">Start</button>\n</div>\n</div>\n<!-- Gap 2: Docker -->\n<div class=\"p-2.5 rounded-lg bg-surface-container-low border border-outline-variant flex justify-between items-center\">\n<div class=\"flex items-center gap-1.5\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-secondary\"></span>\n<span class=\"font-label-md text-label-md text-on-surface\">Docker</span>\n<span class=\"font-body-sm text-[11px] text-secondary\">• Basic containerization desired</span>\n</div>\n<span class=\"font-label-sm text-label-sm text-secondary\">Optional</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Detailed Description Section -->\n<section class=\"bg-surface-container-lowest border border-outline-variant rounded-xl p-space-lg shadow-sm space-y-space-md\">\n<div>\n<h2 class=\"font-title-md text-title-md text-on-surface mb-2\">About the Role</h2>\n<p class=\"font-body-md text-body-md text-secondary leading-relaxed\">\n            As a Junior Frontend Engineer on Stripe’s Developer Dashboard team, you will craft seamless, intuitive experiences that empower millions of online businesses globally. You will write robust web code, implement responsive UI patterns, and elevate standard interface performance across millions of daily active sessions.\n          </p>\n</div>\n<div>\n<h3 class=\"font-label-lg text-label-lg text-on-surface mb-2\">Core Responsibilities</h3>\n<ul class=\"space-y-2 font-body-md text-body-md text-secondary\">\n<li class=\"flex items-start gap-2\">\n<span class=\"material-symbols-outlined text-[16px] text-primary mt-0.5\" data-icon=\"check\">check</span>\n<span>Build modular, accessible, and high-performance React and TypeScript components within Stripe's Sailor design system.</span>\n</li>\n<li class=\"flex items-start gap-2\">\n<span class=\"material-symbols-outlined text-[16px] text-primary mt-0.5\" data-icon=\"check\">check</span>\n<span>Partner closely with product designers, staff engineers, and API product managers to iterate on financial analytics views.</span>\n</li>\n<li class=\"flex items-start gap-2\">\n<span class=\"material-symbols-outlined text-[16px] text-primary mt-0.5\" data-icon=\"check\">check</span>\n<span>Maintain unit test suites with Jest and React Testing Library, upholding Stripe’s standard for 99.99% interface uptime.</span>\n</li>\n</ul>\n</div>\n<div>\n<h3 class=\"font-label-lg text-label-lg text-on-surface mb-2\">Technical Qualifications</h3>\n<div class=\"space-y-3\">\n<div>\n<p class=\"font-label-md text-label-md text-primary mb-1 uppercase tracking-wide\">Must Have</p>\n<ul class=\"list-disc list-inside font-body-md text-body-md text-secondary space-y-1\">\n<li>Demonstrated proficiency with modern React (Hooks, Context, State Management).</li>\n<li>Firm foundation in TypeScript, strict typing, and ES6+ JavaScript.</li>\n<li>Working knowledge of responsive CSS layouts, semantic HTML, and accessibility (WCAG 2.1).</li>\n</ul>\n</div>\n<div>\n<p class=\"font-label-md text-label-md text-secondary mb-1 uppercase tracking-wide\">Nice to Have</p>\n<ul class=\"list-disc list-inside font-body-md text-body-md text-secondary space-y-1\">\n<li>Exposure to Next.js or modern server-side rendering patterns.</li>\n<li>Familiarity with financial dashboards, charts (D3/Recharts), and container concepts.</li>\n</ul>\n</div>\n</div>\n</div>\n<!-- Benefits & Perks Bento Grid -->\n<div>\n<h3 class=\"font-label-lg text-label-lg text-on-surface mb-2\">Benefits & Perks</h3>\n<div class=\"grid grid-cols-2 gap-2.5\">\n<div class=\"p-3 bg-surface-container-low border border-outline-variant rounded-lg\">\n<span class=\"material-symbols-outlined text-primary mb-1\" data-icon=\"health_and_safety\">health_and_safety</span>\n<p class=\"font-label-md text-label-md text-on-surface\">Comprehensive Health</p>\n<p class=\"font-body-sm text-[11px] text-secondary\">100% premium coverage for medical, vision, and dental.</p>\n</div>\n<div class=\"p-3 bg-surface-container-low border border-outline-variant rounded-lg\">\n<span class=\"material-symbols-outlined text-primary mb-1\" data-icon=\"savings\">savings</span>\n<p class=\"font-label-md text-label-md text-on-surface\">401(k) Matching</p>\n<p class=\"font-body-sm text-[11px] text-secondary\">Up to 4% dollar-for-dollar company contribution match.</p>\n</div>\n<div class=\"p-3 bg-surface-container-low border border-outline-variant rounded-lg\">\n<span class=\"material-symbols-outlined text-primary mb-1\" data-icon=\"menu_book\">menu_book</span>\n<p class=\"font-label-md text-label-md text-on-surface\">$1,500 Learning Stipend</p>\n<p class=\"font-body-sm text-[11px] text-secondary\">Annual budget for courses, books, and tech conferences.</p>\n</div>\n<div class=\"p-3 bg-surface-container-low border border-outline-variant rounded-lg\">\n<span class=\"material-symbols-outlined text-primary mb-1\" data-icon=\"home_work\">home_work</span>\n<p class=\"font-label-md text-label-md text-on-surface\">Hybrid Flexibility</p>\n<p class=\"font-body-sm text-[11px] text-secondary\">2 days in-office in SF, flexible remote days & home setup fund.</p>\n</div>\n</div>\n</div>\n</section>\n<!-- Quick Application Form (Inline Card / Express Apply) -->\n<section class=\"bg-surface-container-lowest border-2 border-primary rounded-xl p-space-lg shadow-md space-y-space-md\">\n<div class=\"flex items-center justify-between pb-2 border-b border-surface-container\">\n<div class=\"flex items-center space-x-2\">\n<span class=\"material-symbols-outlined text-primary text-headline-sm\" data-icon=\"bolt\">bolt</span>\n<h2 class=\"font-title-md text-title-md text-on-surface\">Quick Apply</h2>\n</div>\n<span class=\"font-label-sm text-label-sm bg-primary-fixed text-on-primary-fixed px-2 py-0.5 rounded-full font-bold\">1-Click Fast Track</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-secondary\">\n          We will auto-populate verified credentials from your CareerPath portfolio to Stripe's hiring system.\n        </p>\n<!-- Attached Resume File Pill -->\n<div class=\"space-y-1.5\">\n<label class=\"font-label-md text-label-md text-on-surface\">Target Resume Attached</label>\n<div class=\"p-2.5 rounded-lg border border-outline-variant bg-surface-container-low flex items-center justify-between\">\n<div class=\"flex items-center space-x-2.5 overflow-hidden\">\n<span class=\"material-symbols-outlined text-error text-[24px]\" data-icon=\"picture_as_pdf\">picture_as_pdf</span>\n<div class=\"truncate\">\n<p class=\"font-label-md text-label-md text-on-surface truncate\">Alex_Chen_Resume_2025.pdf</p>\n<p class=\"font-body-sm text-[10px] text-secondary\">Updated 3 days ago • ATS Optimized (98/100)</p>\n</div>\n</div>\n<button class=\"text-primary font-label-md text-label-md hover:underline flex-shrink-0 ml-2\" type=\"button\">Replace</button>\n</div>\n</div>\n<!-- Contact Details Preview -->\n<div class=\"space-y-1.5\">\n<label class=\"font-label-md text-label-md text-on-surface\">Applicant Profile</label>\n<div class=\"p-2.5 rounded-lg border border-outline-variant bg-surface-container-low space-y-1\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-md text-label-md text-on-surface font-semibold\">Alex Chen</span>\n<span class=\"font-label-sm text-label-sm text-tertiary flex items-center gap-0.5\">\n<span class=\"material-symbols-outlined text-[12px]\" data-icon=\"check_circle\">check_circle</span> Verified\n              </span>\n</div>\n<p class=\"font-body-sm text-body-sm text-secondary\">alex.chen@example.com • (555) 234-5678</p>\n</div>\n</div>\n<!-- Portfolio / GitHub Link Field -->\n<div class=\"space-y-1.5\">\n<label class=\"font-label-md text-label-md text-on-surface\" for=\"portfolioInput\">Portfolio / GitHub Repository</label>\n<div class=\"relative\">\n<span class=\"material-symbols-outlined absolute left-3 top-3 text-[18px] text-secondary\" data-icon=\"link\">link</span>\n<input class=\"w-full h-11 pl-9 pr-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none\" id=\"portfolioInput\" placeholder=\"https://\" type=\"url\" value=\"https://github.com/alexchen-dev\"/>\n</div>\n</div>\n<!-- Short Cover Note Field -->\n<div class=\"space-y-1.5\">\n<div class=\"flex justify-between\">\n<label class=\"font-label-md text-label-md text-on-surface\" for=\"coverNote\">Why are you excited about Stripe?</label>\n<span class=\"font-label-sm text-label-sm text-secondary\">Max 250 words</span>\n</div>\n<textarea class=\"w-full p-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none\" id=\"coverNote\" placeholder=\"Brief note highlighting your passion for developer tools and modern UI craft...\" rows=\"3\"></textarea>\n</div>\n<!-- Action Buttons -->\n<div class=\"space-y-2 pt-1\">\n<button class=\"w-full h-11 bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg rounded-lg flex items-center justify-center gap-2 shadow-sm active:scale-95 transition-all\" id=\"submitBtn\" onclick=\"handleApplicationSubmit()\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"send\">send</span>\n            Submit Application\n          </button>\n<button class=\"w-full h-10 bg-transparent border border-outline text-secondary hover:text-on-surface hover:border-on-surface font-label-md text-label-md rounded-lg flex items-center justify-center transition-colors\" onclick=\"handleSaveDraft()\" type=\"button\">\n            Save Draft\n          </button>\n</div>\n</section>\n<!-- Feedback Toast Notification Container (Dynamic) -->\n<div class=\"fixed bottom-20 left-4 right-4 max-w-md mx-auto transform translate-y-32 opacity-0 transition-all duration-300 pointer-events-none z-50\" id=\"toast\">\n<div class=\"bg-inverse-surface text-inverse-on-surface p-3 rounded-lg shadow-xl flex items-center justify-between border border-outline\">\n<div class=\"flex items-center space-x-2\">\n<span class=\"material-symbols-outlined text-tertiary-fixed text-[20px]\" data-icon=\"check_circle\">check_circle</span>\n<span class=\"font-body-md text-body-md\" id=\"toastMessage\">Application successfully submitted!</span>\n</div>\n</div>\n</div>\n</main>\n<!-- Bottom Navigation Bar (Executed verbatim from Shared Components JSON with active context) -->\n<!-- JSON Blueprint: destination_count: 4, label_texts: [\"Jobs\", \"Matches\", \"Applications\", \"Profile\"], icons: [\"search\", \"auto_awesome\", \"description\", \"person\"] -->\n<!-- The page intent is Job Details, belonging directly to the \"Jobs\" destination -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 px-gutter-mobile bg-surface-container-lowest dark:bg-inverse-surface shadow-md dark:shadow-none border-t border-outline-variant dark:border-outline\">\n<!-- Jobs (Active) -->\n<a class=\"flex flex-col items-center justify-center text-primary dark:text-inverse-primary font-label-sm text-label-sm active:scale-95 transition-transform duration-150\" href=\"#jobs\">\n<span class=\"material-symbols-outlined\" data-icon=\"search\" style=\"font-variation-settings: 'FILL' 1;\">search</span>\n<span>Jobs</span>\n</a>\n<!-- Matches -->\n<a class=\"flex flex-col items-center justify-center text-secondary dark:text-secondary-fixed-dim font-label-sm text-label-sm hover:text-primary dark:hover:text-inverse-primary active:scale-95 transition-transform duration-150\" href=\"#matches\">\n<span class=\"material-symbols-outlined\" data-icon=\"auto_awesome\">auto_awesome</span>\n<span>Matches</span>\n</a>\n<!-- Applications -->\n<a class=\"flex flex-col items-center justify-center text-secondary dark:text-secondary-fixed-dim font-label-sm text-label-sm hover:text-primary dark:hover:text-inverse-primary active:scale-95 transition-transform duration-150\" href=\"#applications\">\n<span class=\"material-symbols-outlined\" data-icon=\"description\">description</span>\n<span>Applications</span>\n</a>\n<!-- Profile -->\n<a class=\"flex flex-col items-center justify-center text-secondary dark:text-secondary-fixed-dim font-label-sm text-label-sm hover:text-primary dark:hover:text-inverse-primary active:scale-95 transition-transform duration-150\" href=\"#profile\">\n<span class=\"material-symbols-outlined\" data-icon=\"person\">person</span>\n<span>Profile</span>\n</a>\n</nav>\n</div>\n<!-- Interactive JavaScript Logic -->\n<script>\n    let isBookmarked = true;\n\n    function toggleBookmark() {\n      isBookmarked = !isBookmarked;\n      const icon = document.getElementById('bookmarkIcon');\n      if (isBookmarked) {\n        icon.style.fontVariationSettings = \"'FILL' 1\";\n        icon.classList.add('text-primary');\n        icon.classList.remove('text-secondary');\n        showToast('Job saved to your bookmarks.');\n      } else {\n        icon.style.fontVariationSettings = \"'FILL' 0\";\n        icon.classList.remove('text-primary');\n        icon.classList.add('text-secondary');\n        showToast('Job removed from bookmarks.');\n      }\n    }\n\n    function shareJob() {\n      if (navigator.share) {\n        navigator.share({\n          title: 'Junior Frontend Engineer at Stripe',\n          text: 'Check out this 94% matched role on CareerPath!',\n          url: window.location.href\n        }).catch(() => {});\n      } else {\n        showToast('Job link copied to clipboard!');\n      }\n    }\n\n    function handleApplicationSubmit() {\n      const submitBtn = document.getElementById('submitBtn');\n      submitBtn.disabled = true;\n      submitBtn.innerHTML = `\n        <span class=\"material-symbols-outlined animate-spin text-[18px]\" data-icon=\"progress_activity\">progress_activity</span>\n        Submitting...\n      `;\n\n      setTimeout(() => {\n        submitBtn.innerHTML = `\n          <span class=\"material-symbols-outlined text-[18px]\" data-icon=\"check\" style=\"font-variation-settings: 'FILL' 1;\">check</span>\n          Application Submitted\n        `;\n        submitBtn.classList.remove('bg-primary', 'hover:bg-primary-container');\n        submitBtn.classList.add('bg-tertiary');\n        showToast('Application sent directly to Stripe Recruiters!');\n      }, 1200);\n    }\n\n    function handleSaveDraft() {\n      showToast('Draft saved successfully to Applications tab.');\n    }\n\n    function showToast(message) {\n      const toast = document.getElementById('toast');\n      const toastMessage = document.getElementById('toastMessage');\n      toastMessage.textContent = message;\n      toast.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');\n      toast.classList.add('translate-y-0', 'opacity-100');\n\n      setTimeout(() => {\n        toast.classList.remove('translate-y-0', 'opacity-100');\n        toast.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');\n      }, 3000);\n    }\n  </script>\n</body></html>",
