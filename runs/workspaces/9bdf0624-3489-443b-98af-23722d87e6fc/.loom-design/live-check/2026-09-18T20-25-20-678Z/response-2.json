  "content": "{\n  \"content\": \"import React from 'react';\\n\\nexport default function JobCard({ job }) {\\n  return (\\n    <article className=\\\"job-card hover:bg-primary hover:shadow-md transition-all relative group\\\">\\n      <div className=\\\"absolute left-0 top-4 bottom-4 w-1 bg-primary rounded-r\\\"></div>\\n      <button className=\\\"px-3 py-1.5 rounded-lg border border-secondary text-secondary hover:border-on-surface hover:text-on-surface text-label-md font-label-md font-semibold transition-colors bg-surface-container-lowest\\\">\\n        View Details\\n      </button>\\n      <h3 className=\\\"text-title-md font-title-md font-bold text-on-surface group-hover:text-primary transition-colors\\\">\\n        {job.title}\\n      </h3>\\n      <div className=\\\"flex items-center gap-2\\\">\\n        <span className=\\\"icon material-symbols-outlined text-[16px]\\\" data-icon=\\\"work\\\"></span>\\n        <span>{job.company}</span>\\n      </div>\\n      <div className=\\\"flex items-center gap-2\\\">\\n        <span className=\\\"icon material-symbols-outlined text-[16px]\\\" data-icon=\\\"location_on\\\"></span>\\n        <span>{job.location}</span>\\n      </div>\\n      <div className=\\\"flex items-center gap-2\\\">\\n        <span className=\\\"icon material-symbols-outlined text-[16px]\\\" data-icon=\\\"workplace\\\"></span>\\n        <span>{job.workplace}</span>\\n      </div>\\n      <div className=\\\"flex items-center gap-2\\\">\\n        <span className=\\\"icon material-symbols-outlined text-[16px]\\\" data-icon=\\\"attach_money\\\"></span>\\n        <span>${job.salary}</span>\\n      </div>\\n      <div className=\\\"flex items-center gap-2\\\">\\n        <span className=\\\"icon material-symbols-outlined text-[16px]\\\" data-icon=\\\"schedule\\\"></span>\\n        <span>{job.posted} days ago</span>\\n      </div>\\n      <div className=\\\"flex items-center gap-2\\\">\\n        <span className=\\\"badge blue\\\">{job.match}% Match</span>\\n      </div>\\n      <ul className=\\\"list-disc pl-5\\\">\\n        {job.skills.map((skill, index) => (\\n          <li key={index}>{skill}</li>\\n        ))}\\n      </ul>\\n      <div className=\\\"flex items-center gap-2\\\">\\n        <span className=\\\"icon material-symbols-outlined text-[16px]\\\" data-icon=\\\"warning\\\"></span>\\n        <span>{job.gap}</span>\\n      </div>\\n      <button\\n        className=\\\"p-2 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors border border-surface-variant\\\"\\n        title=\\\"Save Role\\\"\\n      >\\n        <span className=\\\"material-symbols-outlined text-[20px]\\\" data-icon=\\\"bookmark\\\">\\n          bookmark\\n        </span>\\n      </button>\\n    </article>\\n  );\\n}\"\n}",
