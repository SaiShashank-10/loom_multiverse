{
  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "_id": { "$ref": "#/definitions/ObjectId" },
        "username": { "type": "string", "minLength": 3, "maxLength": 50 },
        "email": { "type": "string", "format": "email" },
        "passwordHash": { "type": "string" }
      },
      "required": ["username", "email", "passwordHash"],
      "additionalProperties": false
    },
    "Transaction": {
      "type": "object",
      "properties": {
        "_id": { "$ref": "#/definitions/ObjectId" },
        "userId": { "$ref": "#/definitions/ObjectId" },
        "amount": { "type": "number", "minimum": 0.01 },
        "categoryId": { "$ref": "#/definitions/ObjectId" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "categoryId", "date"],
      "additionalProperties": false
    },
    "Income": {
      "type": "object",
      "properties": {
        "_id": { "$ref": "#/definitions/ObjectId" },
        "userId": { "$ref": "#/definitions/ObjectId" },
        "amount": { "type": "number", "minimum": 0.01 },
        "categoryId": { "$ref": "#/definitions/ObjectId" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "categoryId", "date"],
      "additionalProperties": false
    },
    "Budget": {
      "type": "object",
      "properties": {
        "_id": { "$ref": "#/definitions/ObjectId" },
        "userId": { "$ref": "#/definitions/ObjectId" },
        "amount": { "type": "number", "minimum": 0.01 },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "startDate", "endDate"],
      "additionalProperties": false
    },
    "Category": {
      "type": "object",
      "properties": {
        "_id": { "$ref": "#/definitions/ObjectId" },
        "name": { "type": "string", "minLength": 3, "maxLength": 50 },
        "description": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "ObjectId": {
      "$ref": "https://json-schema.org/draft/2019-09/schema#",
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$"
    }
  },
  "collections": {
    "users": { "$ref": "#/definitions/User" },
    "transactions": { "$ref": "#/definitions/Transaction" },
    "incomes": { "$ref": "#/definitions/Income" },
    "budgets": { "$ref": "#/definitions/Budget" },
    "categories": { "$ref": "#/definitions/Category" }
  }
}