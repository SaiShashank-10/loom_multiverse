  "html": "<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>EcoStream Live - Reports &amp; Audits</title>\n<!-- Fonts: Roboto Flex, Open Sans, Montserrat -->\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&amp;family=Roboto+Flex:wght@500;600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          \"colors\": {\n            \"text-secondary\": \"#6c757d\",\n            \"secondary\": \"#575f67\",\n            \"surface-container-highest\": \"#dde3eb\",\n            \"secondary-container\": \"#d8e1ea\",\n            \"tertiary-container\": \"#c64f00\",\n            \"warning\": \"#ffc107\",\n            \"secondary-fixed\": \"#dbe4ed\",\n            \"on-primary-fixed-variant\": \"#004493\",\n            \"primary\": \"#0059bb\",\n            \"inverse-on-surface\": \"#ecf1f9\",\n            \"error-container\": \"#ffdad6\",\n            \"surface\": \"#f8f9fa\",\n            \"on-tertiary-container\": \"#fffbff\",\n            \"inverse-surface\": \"#2b3137\",\n            \"on-secondary\": \"#ffffff\",\n            \"surface-bright\": \"#f7f9ff\",\n            \"surface-container-lowest\": \"#ffffff\",\n            \"error\": \"#dc3545\",\n            \"success\": \"#28a745\",\n            \"tertiary-fixed\": \"#ffdbcc\",\n            \"on-primary\": \"#ffffff\",\n            \"outline\": \"#717786\",\n            \"on-primary-fixed\": \"#001a41\",\n            \"on-secondary-fixed\": \"#141d23\",\n            \"on-secondary-container\": \"#5b646b\",\n            \"background\": \"#ffffff\",\n            \"on-error-container\": \"#93000a\",\n            \"surface-dim\": \"#d5dae2\",\n            \"outline-variant\": \"#c1c6d7\",\n            \"on-error\": \"#ffffff\",\n            \"border\": \"#dee2e6\",\n            \"on-tertiary\": \"#ffffff\",\n            \"surface-container\": \"#e9eef6\",\n            \"primary-fixed-dim\": \"#adc7ff\",\n            \"surface-tint\": \"#005bc0\",\n            \"surface-container-low\": \"#eff4fc\",\n            \"primary-fixed\": \"#d8e2ff\",\n            \"on-surface-variant\": \"#414754\",\n            \"on-secondary-fixed-variant\": \"#3f484f\",\n            \"text-primary\": \"#343a40\",\n            \"surface-container-high\": \"#e3e9f0\",\n            \"on-primary-container\": \"#fefcff\",\n            \"on-tertiary-fixed\": \"#351000\",\n            \"tertiary-fixed-dim\": \"#ffb695\",\n            \"secondary-fixed-dim\": \"#bfc8d0\",\n            \"on-background\": \"#161c22\",\n            \"primary-container\": \"#0070ea\",\n            \"tertiary\": \"#9e3d00\",\n            \"surface-variant\": \"#dde3eb\",\n            \"inverse-primary\": \"#adc7ff\",\n            \"on-tertiary-fixed-variant\": \"#7c2e00\",\n            \"on-surface\": \"#161c22\"\n          },\n          \"borderRadius\": {\n            \"DEFAULT\": \"0.125rem\",\n            \"lg\": \"0.25rem\",\n            \"xl\": \"0.5rem\",\n            \"full\": \"0.75rem\"\n          },\n          \"spacing\": {\n            \"space-sm\": \"0.5rem\",\n            \"gutter\": \"1rem\",\n            \"space-xs\": \"0.25rem\",\n            \"space-xl\": \"2rem\",\n            \"space-lg\": \"1.5rem\",\n            \"margin-mobile\": \"1.5rem\",\n            \"margin\": \"3rem\",\n            \"space-md\": \"1rem\"\n          },\n          \"fontFamily\": {\n            \"headline-lg-mobile\": [\"Roboto Flex\"],\n            \"body-lg\": [\"Montserrat\"],\n            \"label-md\": [\"Open Sans\"],\n            \"headline-lg\": [\"Roboto Flex\"],\n            \"body-md\": [\"Montserrat\"],\n            \"label-sm\": [\"Open Sans\"],\n            \"headline-sm\": [\"Open Sans\"],\n            \"headline-md\": [\"Open Sans\"],\n            \"caption\": [\"Montserrat\"]\n          },\n          \"fontSize\": {\n            \"headline-lg-mobile\": [\"26px\", { \"lineHeight\": \"32px\", \"fontWeight\": \"700\" }],\n            \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }],\n            \"label-md\": [\"14px\", { \"lineHeight\": \"18px\", \"fontWeight\": \"600\" }],\n            \"headline-lg\": [\"32px\", { \"lineHeight\": \"38px\", \"fontWeight\": \"700\" }],\n            \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }],\n            \"label-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"500\" }],\n            \"headline-sm\": [\"20px\", { \"lineHeight\": \"26px\", \"fontWeight\": \"600\" }],\n            \"headline-md\": [\"24px\", { \"lineHeight\": \"31px\", \"fontWeight\": \"600\" }],\n            \"caption\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }]\n          }\n        },\n      },\n    }\n  </script>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-background text-text-primary antialiased selection:bg-primary selection:text-white pb-28 md:pb-12 pt-16\">\n<!-- TOP APP BAR -->\n<header class=\"fixed top-0 left-0 w-full z-50 flex justify-between items-center px-4 py-3 bg-surface dark:bg-inverse-surface shadow-sm dark:shadow-none transition-all duration-150\">\n<div class=\"flex items-center space-x-3\">\n<div class=\"w-9 h-9 rounded-lg bg-primary-container text-on-primary flex items-center justify-center shadow-sm\">\n<span class=\"material-symbols-outlined text-[22px]\" data-icon=\"recycling\">recycling</span>\n</div>\n<div>\n<div class=\"flex items-center space-x-2\">\n<span class=\"text-headline-sm font-headline-sm text-primary dark:text-inverse-primary font-bold tracking-tight\">EcoStream Live</span>\n<span class=\"hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-caption font-caption bg-surface-variant text-text-secondary\">v2.4 Core</span>\n</div>\n<p class=\"text-caption font-caption text-text-secondary leading-none\">Reports &amp; Audits Compliance Console</p>\n</div>\n</div>\n<!-- Trailing Actions & Desktop Navigation -->\n<div class=\"flex items-center space-x-1 sm:space-x-3\">\n<div class=\"hidden md:flex items-center space-x-1 mr-4\">\n<a class=\"px-3 py-1.5 rounded-lg text-label-md font-label-md text-text-secondary hover:bg-surface-variant hover:text-on-surface transition-all\" href=\"#\">Dashboard</a>\n<a class=\"px-3 py-1.5 rounded-lg text-label-md font-label-md text-primary font-bold bg-primary-fixed hover:bg-primary-fixed-dim transition-all\" href=\"#\">Reports</a>\n<a class=\"px-3 py-1.5 rounded-lg text-label-md font-label-md text-text-secondary hover:bg-surface-variant hover:text-on-surface transition-all\" href=\"#\">Settings</a>\n</div>\n<button aria-label=\"Quick Search\" class=\"w-9 h-9 flex items-center justify-center rounded-lg text-text-secondary hover:bg-surface-variant hover:text-on-surface active:scale-95 transition-all\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"search\">search</span>\n</button>\n<button aria-label=\"Notifications\" class=\"w-9 h-9 relative flex items-center justify-center rounded-lg text-text-secondary hover:bg-surface-variant hover:text-on-surface active:scale-95 transition-all\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\" data-icon=\"notifications\">notifications</span>\n<span class=\"absolute top-2 right-2 w-2 h-2 bg-error rounded-full ring-2 ring-surface\"></span>\n</button>\n<div class=\"h-6 w-px bg-border hidden sm:block\"></div>\n<div class=\"hidden sm:flex items-center space-x-2 pl-1\">\n<div class=\"w-8 h-8 rounded-full bg-secondary-container text-secondary flex items-center justify-center text-label-sm font-label-sm font-bold border border-border\">\n          EC\n        </div>\n</div>\n</div>\n</header>\n<!-- MAIN CANVAS -->\n<main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n<!-- PAGE TITLE & BREADCRUMB HERO -->\n<div class=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\">\n<div>\n<div class=\"flex items-center space-x-2 text-caption font-caption text-text-secondary mb-1\">\n<span>Enterprise Console</span>\n<span>/</span>\n<span>Environmental Compliance</span>\n<span>/</span>\n<span class=\"text-primary font-semibold\">Verification Reports</span>\n</div>\n<h1 class=\"text-headline-lg-mobile md:text-headline-lg font-headline-lg-mobile md:font-headline-lg text-text-primary tracking-tight\">\n          Reports &amp; Audits\n        </h1>\n<p class=\"text-body-md font-body-md text-text-secondary mt-0.5\">\n          Verify chain of custody, recovery yields, and automated environmental protection logs across regional depots.\n        </p>\n</div>\n<!-- Live Sync Indicator Badge -->\n<div class=\"flex items-center self-start sm:self-auto space-x-2 bg-surface px-3 py-1.5 rounded-full border border-border\">\n<span class=\"relative flex h-2 w-2\">\n<span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75\"></span>\n<span class=\"relative inline-flex rounded-full h-2 w-2 bg-success\"></span>\n</span>\n<span class=\"text-caption font-caption text-secondary font-medium\">Telemetry Synced: 2 mins ago</span>\n</div>\n</div>\n<!-- SUMMARY METRICS BAR / QUICK STATS (Bento Strip) -->\n<section class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n<!-- Metric 1 -->\n<div class=\"bg-surface rounded-lg p-space-md border border-border shadow-sm flex items-start justify-between\">\n<div class=\"space-y-1\">\n<span class=\"text-caption font-caption uppercase tracking-wider text-text-secondary\">Total Audited Volume</span>\n<div class=\"flex items-baseline space-x-2\">\n<span class=\"text-headline-md font-headline-md font-bold text-text-primary\">148.6</span>\n<span class=\"text-label-md font-label-md text-text-secondary\">Tons</span>\n</div>\n<div class=\"flex items-center space-x-1.5 pt-1\">\n<span class=\"inline-flex items-center px-2 py-0.5 rounded-full text-label-sm font-label-sm font-bold bg-success/10 text-success\">\n<span class=\"material-symbols-outlined text-[14px] mr-0.5\" data-icon=\"verified\">verified</span>\n              100% Compliance\n            </span>\n</div>\n</div>\n<div class=\"p-2.5 bg-surface-container rounded-lg text-primary\">\n<span class=\"material-symbols-outlined text-[24px]\" data-icon=\"scale\">scale</span>\n</div>\n</div>\n<!-- Metric 2 -->\n<div class=\"bg-surface rounded-lg p-space-md border border-border shadow-sm flex items-start justify-between\">\n<div class=\"space-y-1\">\n<span class=\"text-caption font-caption uppercase tracking-wider text-text-secondary\">Total Reports Generated</span>\n<div class=\"flex items-baseline space-x-2\">\n<span class=\"text-headline-md font-headline-md font-bold text-text-primary\">42</span>\n<span class=\"text-caption font-caption text-text-secondary\">Official Dossiers</span>\n</div>\n<div class=\"flex items-center space-x-1.5 pt-1\">\n<span class=\"text-caption font-caption text-text-secondary\">\n<span class=\"text-primary font-semibold\">+8 new</span> during Q1 2025 cycle\n            </span>\n</div>\n</div>\n<div class=\"p-2.5 bg-surface-container rounded-lg text-primary\">\n<span class=\"material-symbols-outlined text-[24px]\" data-icon=\"description\">description</span>\n</div>\n</div>\n<!-- Metric 3 -->\n<div class=\"bg-surface rounded-lg p-space-md border border-border shadow-sm flex items-start justify-between\">\n<div class=\"space-y-1\">\n<span class=\"text-caption font-caption uppercase tracking-wider text-text-secondary\">Net Carbon Offset Verified</span>\n<div class=\"flex items-baseline space-x-2\">\n<span class=\"text-headline-md font-headline-md font-bold text-text-primary\">412</span>\n<span class=\"text-label-md font-label-md text-text-secondary\">MT CO₂e</span>\n</div>\n<div class=\"flex items-center space-x-1.5 pt-1\">\n<span class=\"inline-flex items-center px-2 py-0.5 rounded-full text-label-sm font-label-sm font-bold bg-primary-fixed text-on-primary-fixed-variant\">\n              EPA Standard Tier 1\n            </span>\n</div>\n</div>\n<div class=\"p-2.5 bg-surface-container rounded-lg text-primary\">\n<span class=\"material-symbols-outlined text-[24px]\" data-icon=\"eco\">eco</span>\n</div>\n</div>\n</section>\n<!-- EXPORT ACTIONS BAR -->\n<section class=\"bg-surface-container-low rounded-lg p-3 sm:p-4 border border-border flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3\">\n<div class=\"flex items-center space-x-2 text-text-secondary\">\n<span class=\"material-symbols-outlined text-[20px] text-primary\" data-icon=\"file_download\">file_download</span>\n<span class=\"text-label-md font-label-md text-text-primary font-semibold\">Report Actions &amp; Export Tools</span>\n<span class=\"text-caption font-caption hidden lg:inline text-text-secondary\">| Audit-ready formats with verifiable cryptographic signatures</span>\n</div>\n<div class=\"flex flex-wrap items-center gap-2\">\n<button class=\"flex-1 sm:flex-none inline-flex items-center justify-center space-x-1.5 px-3.5 py-2 bg-background border border-border rounded-lg text-label-md font-label-md text-text-primary hover:bg-surface hover:border-outline transition-all active:scale-95 shadow-sm\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px] text-secondary\" data-icon=\"table_chart\">table_chart</span>\n<span>Export CSV</span>\n</button>\n<button class=\"flex-1 sm:flex-none inline-flex items-center justify-center space-x-1.5 px-3.5 py-2 bg-background border border-border rounded-lg text-label-md font-label-md text-text-primary hover:bg-surface hover:border-outline transition-all active:scale-95 shadow-sm\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px] text-error\" data-icon=\"picture_as_pdf\">picture_as_pdf</span>\n<span>Export PDF Summary</span>\n</button>\n<button class=\"w-full sm:w-auto inline-flex items-center justify-center space-x-1.5 px-4 py-2 bg-primary text-on-primary rounded-lg text-label-md font-label-md hover:bg-primary-container transition-all active:scale-95 shadow-sm\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"schedule\">schedule</span>\n<span>Schedule Automated Report</span>\n</button>\n</div>\n</section>\n<!-- FILTERS & PARAMETERS PANEL -->\n<section class=\"bg-surface rounded-lg border border-border shadow-sm p-4 sm:p-5\">\n<div class=\"flex items-center justify-between pb-3 border-b border-border mb-4\">\n<div class=\"flex items-center space-x-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\" data-icon=\"tune\">tune</span>\n<h2 class=\"text-headline-sm font-headline-sm text-text-primary\">Filter &amp; Parameter Scope</h2>\n</div>\n<button class=\"text-label-sm font-label-sm text-text-secondary hover:text-error transition-colors flex items-center space-x-1\" id=\"reset-filters\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"restart_alt\">restart_alt</span>\n<span>Reset All</span>\n</button>\n</div>\n<div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n<!-- Time Period Selector -->\n<div>\n<label class=\"block text-label-sm font-label-sm text-text-secondary mb-1.5\">Time Period</label>\n<div class=\"relative\">\n<select class=\"w-full appearance-none bg-background border border-border text-text-primary text-label-md font-label-md rounded-lg py-2 pl-3 pr-9 focus:ring-2 focus:ring-primary/20 focus:border-primary\">\n<option selected=\"\">Last 30 Days</option>\n<option>Q1 2025 (Current)</option>\n<option>Q4 2024</option>\n<option>Fiscal Year 2024-2025</option>\n<option>Custom Date Range...</option>\n</select>\n<div class=\"pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-text-secondary\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"expand_more\">expand_more</span>\n</div>\n</div>\n</div>\n<!-- Facility / Depot Location Filter -->\n<div>\n<label class=\"block text-label-sm font-label-sm text-text-secondary mb-1.5\">Depot / Facility</label>\n<div class=\"relative\">\n<select class=\"w-full appearance-none bg-background border border-border text-text-primary text-label-md font-label-md rounded-lg py-2 pl-3 pr-9 focus:ring-2 focus:ring-primary/20 focus:border-primary\">\n<option selected=\"\">All Depots (Universal)</option>\n<option>Metro Hub North (Sector 1)</option>\n<option>Sector 4 Depository</option>\n<option>Pacific Port Dock Yard</option>\n<option>Eastern Valley Smelting Plant</option>\n</select>\n<div class=\"pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-text-secondary\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"location_on\">location_on</span>\n</div>\n</div>\n</div>\n<!-- Waste Category Filter -->\n<div>\n<label class=\"block text-label-sm font-label-sm text-text-secondary mb-1.5\">Waste Stream Category</label>\n<div class=\"relative\">\n<select class=\"w-full appearance-none bg-background border border-border text-text-primary text-label-md font-label-md rounded-lg py-2 pl-3 pr-9 focus:ring-2 focus:ring-primary/20 focus:border-primary\">\n<option selected=\"\">All Categories</option>\n<option>IT &amp; Telecom Infrastructure</option>\n<option>Consumer Electronics (Small Appliances)</option>\n<option>Heavy Industrial Appliances</option>\n<option>Li-Ion Batteries &amp; Cells</option>\n<option>Precious Metal Printed Circuit Boards</option>\n</select>\n<div class=\"pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-text-secondary\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"category\">category</span>\n</div>\n</div>\n</div>\n<!-- Compliance Status Filter -->\n<div>\n<label class=\"block text-label-sm font-label-sm text-text-secondary mb-1.5\">Compliance Status</label>\n<div class=\"relative\">\n<select class=\"w-full appearance-none bg-background border border-border text-text-primary text-label-md font-label-md rounded-lg py-2 pl-3 pr-9 focus:ring-2 focus:ring-primary/20 focus:border-primary\">\n<option selected=\"\">All Audit States</option>\n<option>Certified Recovered</option>\n<option>Hazardous Neutralized</option>\n<option>Under Active Audit</option>\n<option>Pending Chain of Custody</option>\n</select>\n<div class=\"pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-text-secondary\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"filter_alt\">filter_alt</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Quick Chips & Action Footer -->\n<div class=\"mt-4 pt-3 border-t border-border flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3\">\n<div class=\"flex flex-wrap items-center gap-1.5\">\n<span class=\"text-caption font-caption text-text-secondary mr-1\">Active Presets:</span>\n<span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm font-label-sm bg-surface-container text-text-primary border border-border\">\n            Hazardous Li-Ion\n            <button class=\"ml-1 text-text-secondary hover:text-error\">×</button>\n</span>\n<span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm font-label-sm bg-surface-container text-text-primary border border-border\">\n    