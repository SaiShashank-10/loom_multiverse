  "html": "<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>EcoStream Live - E-Waste Overview Dashboard</title>\n<!-- Google Fonts -->\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&amp;family=Open+Sans:wght@400;500;600;700&amp;family=Roboto+Flex:wght@600;700;800&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Material Symbols Outlined -->\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Tailwind CSS with Theme Injection -->\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          \"colors\": {\n            \"tertiary-container\": \"#c64f00\",\n            \"secondary\": \"#575f67\",\n            \"on-tertiary\": \"#ffffff\",\n            \"on-tertiary-fixed\": \"#351000\",\n            \"on-secondary-container\": \"#5b646b\",\n            \"secondary-fixed\": \"#dbe4ed\",\n            \"inverse-primary\": \"#adc7ff\",\n            \"surface-tint\": \"#005bc0\",\n            \"on-background\": \"#161c22\",\n            \"surface\": \"#f8f9fa\",\n            \"surface-bright\": \"#f7f9ff\",\n            \"on-tertiary-fixed-variant\": \"#7c2e00\",\n            \"on-primary-container\": \"#fefcff\",\n            \"primary-fixed-dim\": \"#adc7ff\",\n            \"outline\": \"#717786\",\n            \"surface-dim\": \"#d5dae2\",\n            \"surface-container-lowest\": \"#ffffff\",\n            \"on-tertiary-container\": \"#fffbff\",\n            \"surface-container-high\": \"#e3e9f0\",\n            \"text-primary\": \"#343a40\",\n            \"on-error-container\": \"#93000a\",\n            \"on-primary-fixed-variant\": \"#004493\",\n            \"on-surface-variant\": \"#414754\",\n            \"primary-container\": \"#0070ea\",\n            \"inverse-on-surface\": \"#ecf1f9\",\n            \"warning\": \"#ffc107\",\n            \"inverse-surface\": \"#2b3137\",\n            \"border\": \"#dee2e6\",\n            \"background\": \"#ffffff\",\n            \"tertiary-fixed\": \"#ffdbcc\",\n            \"error-container\": \"#ffdad6\",\n            \"outline-variant\": \"#c1c6d7\",\n            \"on-secondary\": \"#ffffff\",\n            \"secondary-fixed-dim\": \"#bfc8d0\",\n            \"error\": \"#dc3545\",\n            \"primary-fixed\": \"#d8e2ff\",\n            \"tertiary-fixed-dim\": \"#ffb695\",\n            \"on-secondary-fixed\": \"#141d23\",\n            \"surface-container-low\": \"#eff4fc\",\n            \"on-primary-fixed\": \"#001a41\",\n            \"text-secondary\": \"#6c757d\",\n            \"tertiary\": \"#9e3d00\",\n            \"on-error\": \"#ffffff\",\n            \"secondary-container\": \"#d8e1ea\",\n            \"on-primary\": \"#ffffff\",\n            \"on-secondary-fixed-variant\": \"#3f484f\",\n            \"surface-variant\": \"#dde3eb\",\n            \"primary\": \"#0059bb\",\n            \"success\": \"#28a745\",\n            \"on-surface\": \"#161c22\",\n            \"surface-container-highest\": \"#dde3eb\",\n            \"surface-container\": \"#e9eef6\"\n          },\n          \"borderRadius\": {\n            \"DEFAULT\": \"0.125rem\",\n            \"lg\": \"0.25rem\",\n            \"xl\": \"0.5rem\",\n            \"full\": \"0.75rem\"\n          },\n          \"spacing\": {\n            \"space-md\": \"1rem\",\n            \"margin-mobile\": \"1.5rem\",\n            \"space-xs\": \"0.25rem\",\n            \"space-xl\": \"2rem\",\n            \"space-lg\": \"1.5rem\",\n            \"margin\": \"3rem\",\n            \"gutter\": \"1rem\",\n            \"space-sm\": \"0.5rem\"\n          },\n          \"fontFamily\": {\n            \"body-md\": [\"Montserrat\", \"sans-serif\"],\n            \"headline-lg\": [\"Roboto Flex\", \"sans-serif\"],\n            \"label-md\": [\"Open Sans\", \"sans-serif\"],\n            \"body-lg\": [\"Montserrat\", \"sans-serif\"],\n            \"headline-lg-mobile\": [\"Roboto Flex\", \"sans-serif\"],\n            \"headline-md\": [\"Open Sans\", \"sans-serif\"],\n            \"headline-sm\": [\"Open Sans\", \"sans-serif\"],\n            \"caption\": [\"Montserrat\", \"sans-serif\"],\n            \"label-sm\": [\"Open Sans\", \"sans-serif\"]\n          },\n          \"fontSize\": {\n            \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }],\n            \"headline-lg\": [\"32px\", { \"lineHeight\": \"38px\", \"fontWeight\": \"700\" }],\n            \"label-md\": [\"14px\", { \"lineHeight\": \"18px\", \"fontWeight\": \"600\" }],\n            \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }],\n            \"headline-lg-mobile\": [\"26px\", { \"lineHeight\": \"32px\", \"fontWeight\": \"700\" }],\n            \"headline-md\": [\"24px\", { \"lineHeight\": \"31px\", \"fontWeight\": \"600\" }],\n            \"headline-sm\": [\"20px\", { \"lineHeight\": \"26px\", \"fontWeight\": \"600\" }],\n            \"caption\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }],\n            \"label-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"500\" }]\n          }\n        },\n      },\n    }\n  </script>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-background text-text-primary antialiased font-body-md text-body-md min-h-screen flex flex-col pb-24\">\n<!-- Top Navigation Bar from Shared Components JSON -->\n<header class=\"fixed top-0 left-0 w-full z-50 flex justify-between items-center px-4 py-3 bg-surface shadow-sm border-b border-border\">\n<div class=\"flex items-center space-x-2.5\">\n<span class=\"material-symbols-outlined text-primary text-2xl\" data-icon=\"recycling\">recycling</span>\n<div>\n<h1 class=\"font-headline-sm text-headline-sm text-primary font-bold tracking-tight\">EcoStream Live</h1>\n</div>\n</div>\n<div class=\"flex items-center space-x-2\">\n<div class=\"flex items-center space-x-1.5 bg-surface-container-low px-2 py-1 rounded-full border border-border\">\n<span class=\"relative flex h-2 w-2\">\n<span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75\"></span>\n<span class=\"relative inline-flex rounded-full h-2 w-2 bg-success\"></span>\n</span>\n<span class=\"font-label-sm text-caption text-text-secondary font-medium tracking-tight\">Real-time sync</span>\n</div>\n<button aria-label=\"Notifications\" class=\"p-1.5 rounded-lg text-text-secondary hover:bg-surface-variant hover:text-on-surface transition-all duration-150 relative\">\n<span class=\"material-symbols-outlined\" data-icon=\"notifications\">notifications</span>\n<span class=\"absolute top-1 right-1 w-2 h-2 bg-error rounded-full ring-2 ring-surface\"></span>\n</button>\n</div>\n</header>\n<!-- Main Content Container: Mobile Optimized Stack -->\n<main class=\"mt-14 px-4 pt-4 flex flex-col space-y-5 max-w-md mx-auto w-full\">\n<!-- Section 1: Quick Time Filter Chips -->\n<section aria-label=\"Time Filter Controls\" class=\"w-full\">\n<div class=\"flex items-center space-x-2 overflow-x-auto pb-1 scrollbar-none text-text-secondary font-label-md text-label-md\">\n<button class=\"px-3.5 py-1.5 rounded-lg border border-border bg-surface text-text-secondary hover:bg-surface-variant transition-all duration-150 whitespace-nowrap\">\n          Today\n        </button>\n<button class=\"px-3.5 py-1.5 rounded-lg border border-border bg-surface text-text-secondary hover:bg-surface-variant transition-all duration-150 whitespace-nowrap\">\n          This Week\n        </button>\n<button class=\"px-3.5 py-1.5 rounded-lg bg-primary text-on-primary font-bold shadow-sm transition-all duration-150 whitespace-nowrap\">\n          This Month\n        </button>\n<button class=\"px-3.5 py-1.5 rounded-lg border border-border bg-surface text-text-secondary hover:bg-surface-variant transition-all duration-150 whitespace-nowrap\">\n          Year-to-Date\n        </button>\n</div>\n</section>\n<!-- Section 2: Key Metrics Cards (Bento/Card Grid) -->\n<section aria-label=\"Key Environmental Metrics\" class=\"grid grid-cols-2 gap-3\">\n<!-- Metric Card 1 -->\n<article class=\"bg-surface p-3.5 rounded-lg border border-border shadow-sm flex flex-col justify-between hover:scale-[1.02] active:scale-95 transition-all duration-150\">\n<div class=\"flex items-center justify-between mb-1.5\">\n<span class=\"font-label-sm text-caption text-text-secondary font-medium uppercase tracking-wider\">Total Collected</span>\n<span class=\"material-symbols-outlined text-primary text-lg\" data-icon=\"delete_outline\">delete_outline</span>\n</div>\n<div class=\"space-y-1\">\n<span class=\"font-headline-md text-headline-sm font-bold text-text-primary block\">148.6 <span class=\"font-label-sm text-label-sm font-medium text-text-secondary\">Tons</span></span>\n<div class=\"inline-flex items-center px-1.5 py-0.5 rounded-full bg-[rgba(40,167,69,0.12)] text-success font-label-sm text-caption font-bold\">\n<span class=\"material-symbols-outlined text-xs mr-0.5\" data-icon=\"trending_up\">trending_up</span>\n            +12.4% vs lm\n          </div>\n</div>\n</article>\n<!-- Metric Card 2 -->\n<article class=\"bg-surface p-3.5 rounded-lg border border-border shadow-sm flex flex-col justify-between hover:scale-[1.02] active:scale-95 transition-all duration-150\">\n<div class=\"flex items-center justify-between mb-1.5\">\n<span class=\"font-label-sm text-caption text-text-secondary font-medium uppercase tracking-wider\">Recovery Rate</span>\n<span class=\"material-symbols-outlined text-primary text-lg\" data-icon=\"autorenew\">autorenew</span>\n</div>\n<div class=\"space-y-1\">\n<span class=\"font-headline-md text-headline-sm font-bold text-text-primary block\">84.2%</span>\n<div class=\"inline-flex items-center px-1.5 py-0.5 rounded-full bg-[rgba(40,167,69,0.12)] text-success font-label-sm text-caption font-bold\">\n<span class=\"material-symbols-outlined text-xs mr-0.5\" data-icon=\"check_circle\">check_circle</span>\n            +3.1% target\n          </div>\n</div>\n</article>\n<!-- Metric Card 3 -->\n<article class=\"bg-surface p-3.5 rounded-lg border border-border shadow-sm flex flex-col justify-between hover:scale-[1.02] active:scale-95 transition-all duration-150\">\n<div class=\"flex items-center justify-between mb-1.5\">\n<span class=\"font-label-sm text-caption text-text-secondary font-medium uppercase tracking-wider\">Hazardous Neut.</span>\n<span class=\"material-symbols-outlined text-tertiary-container text-lg\" data-icon=\"shield\">shield</span>\n</div>\n<div class=\"space-y-1\">\n<span class=\"font-headline-md text-headline-sm font-bold text-text-primary block\">18.3 <span class=\"font-label-sm text-label-sm font-medium text-text-secondary\">Tons</span></span>\n<div class=\"inline-flex items-center px-1.5 py-0.5 rounded-full bg-surface-container-high text-text-secondary font-label-sm text-caption font-medium\">\n<span class=\"material-symbols-outlined text-xs mr-0.5 text-primary\" data-icon=\"verified\">verified</span>\n            Certified safe\n          </div>\n</div>\n</article>\n<!-- Metric Card 4 -->\n<article class=\"bg-surface p-3.5 rounded-lg border border-border shadow-sm flex flex-col justify-between hover:scale-[1.02] active:scale-95 transition-all duration-150\">\n<div class=\"flex items-center justify-between mb-1.5\">\n<span class=\"font-label-sm text-caption text-text-secondary font-medium uppercase tracking-wider\">Carbon Offset</span>\n<span class=\"material-symbols-outlined text-success text-lg\" data-icon=\"eco\">eco</span>\n</div>\n<div class=\"space-y-1\">\n<span class=\"font-headline-md text-headline-sm font-bold text-text-primary block\">412 <span class=\"font-label-sm text-label-sm font-medium text-text-secondary\">MT</span></span>\n<div class=\"inline-flex items-center px-1.5 py-0.5 rounded-full bg-surface-container-high text-text-secondary font-label-sm text-caption font-medium\">\n            CO2e Saved\n          </div>\n</div>\n</article>\n</section>\n<!-- Section 3: Real-Time Stream Inflow & Recycled Volume Chart -->\n<section class=\"bg-surface p-4 rounded-lg border border-border shadow-sm\">\n<div class=\"flex items-center justify-between mb-3\">\n<div>\n<h2 class=\"font-headline-sm text-label-md font-bold text-text-primary\">Stream Inflow vs Recycled Volume</h2>\n<p class=\"font-body-md text-caption text-text-secondary\">Measured in metric tons</p>\n</div>\n<!-- Chart Toggle Pills -->\n<div class=\"flex p-0.5 bg-surface-container rounded border border-border\">\n<button class=\"px-2 py-0.5 text-caption font-label-md bg-white text-primary rounded shadow-xs font-bold transition-all\">Volume</button>\n<button class=\"px-2 py-0.5 text-caption font-label-md text-text-secondary rounded hover:text-text-primary transition-all\">Efficiency</button>\n</div>\n</div>\n<!-- High Fidelity SVG Visualization -->\n<div class=\"relative w-full h-44 bg-surface-container-lowest rounded border border-border/60 p-2 overflow-hidden\">\n<!-- SVG Dual-Stream Chart -->\n<svg class=\"w-full h-full overflow-visible\" preserveaspectratio=\"none\" viewbox=\"0 0 340 140\">\n<defs>\n<lineargradient id=\"gradientInflow\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0%\" stop-color=\"#0070ea\" stop-opacity=\"0.32\"></stop>\n<stop offset=\"100%\" stop-color=\"#0070ea\" stop-opacity=\"0.0\"></stop>\n</lineargradient>\n<lineargradient id=\"gradientRecycled\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0%\" stop-color=\"#28a745\" stop-opacity=\"0.25\"></stop>\n<stop offset=\"100%\" stop-color=\"#28a745\" stop-opacity=\"0.0\"></stop>\n</lineargradient>\n</defs>\n<!-- Horizontal Reference Grid Lines -->\n<line stroke=\"#dee2e6\" stroke-dasharray=\"3,3\" stroke-width=\"0.8\" x1=\"0\" x2=\"340\" y1=\"20\" y2=\"20\"></line>\n<line stroke=\"#dee2e6\" stroke-dasharray=\"3,3\" stroke-width=\"0.8\" x1=\"0\" x2=\"340\" y1=\"60\" y2=\"60\"></line>\n<line stroke=\"#dee2e6\" stroke-dasharray=\"3,3\" stroke-width=\"0.8\" x1=\"0\" x2=\"340\" y1=\"100\" y2=\"100\"></line>\n<!-- Area Fills -->\n<path d=\"M 0,110 Q 55,75 110,85 T 220,40 T 340,25 L 340,130 L 0,130 Z\" fill=\"url(#gradientInflow)\"></path>\n<path d=\"M 0,120 Q 55,95 110,100 T 220,60 T 340,42 L 340,130 L 0,130 Z\" fill=\"url(#gradientRecycled)\"></path>\n<!-- Trajectory Stroke Lines -->\n<path d=\"M 0,110 Q 55,75 110,85 T 220,40 T 340,25\" fill=\"none\" stroke=\"#0070ea\" stroke-linecap=\"round\" stroke-width=\"2\"></path>\n<path d=\"M 0,120 Q 55,95 110,100 T 220,60 T 340,42\" fill=\"none\" stroke=\"#28a745\" stroke-linecap=\"round\" stroke-width=\"2\"></path>\n<!-- Data Points & Active Inspection Markers -->\n<circle cx=\"220\" cy=\"40\" fill=\"#ffffff\" r=\"3.5\" stroke=\"#0070ea\" stroke-width=\"2\"></circle>\n<circle cx=\"220\" cy=\"60\" fill=\"#ffffff\" r=\"3.5\" stroke=\"#28a745\" stroke-width=\"2\"></circle>\n<line stroke=\"#0070ea\" stroke-dasharray=\"2,2\" stroke-width=\"1\" x1=\"220\" x2=\"220\" y1=\"20\" y2=\"130\"></line>\n</svg>\n<!-- Floating Data Tooltip Indicator -->\n<div class=\"absolute top-2 left-[50%] -translate-x-1/2 bg-inverse-surface text-inverse-on-surface text-caption px-2 py-1 rounded shadow-md pointer-events-none flex space-x-2\">\n<span class=\"text-primary-fixed font-bold\">In: 38.4T</span>\n<span class=\"text-success font-bold\">Rec: 32.8T</span>\n</div>\n</div>\n<!-- Chart Legend & Time Ticks -->\n<div class=\"flex items-center justify-between mt-2 pt-2 border-t border-border/80 text-caption font-body-md text-text-secondary\">\n<div class=\"flex items-center space-x-3\">\n<span class=\"inline-flex items-center\"><span class=\"w-2 h-2 rounded-full bg-primary-container mr-1\"></span> Inflow Stream</span>\n<span class=\"inline-flex items-center\"><span class=\"w-2 h-2 rounded-full bg-success mr-1\"></span> Processed</span>\n</div>\n<div class=\"flex space-x-2 text-text-secondary font-label-sm\">\n<span>W1</span>\n<span>W2</span>\n<span class=\"text-primary font-bold\">W3</span>\n<span>W4</span>\n</div>\n</div>\n</section>\n<!-- Section 4: Material Category Breakdown -->\n<section class=\"bg-surface p-4 rounded-lg border border-border shadow-sm space-y-3\">\n<div class=\"flex justify-between items-center\">\n<h2 class=\"font-headline-sm text-label-md font-bold text-text-primary\">Material Composition</h2>\n<span class=\"font-caption text-caption text-text-secondary font-medium\">100% Accounted</span>\n</div>\n<div class=\"space-y-2.5\">\n<!-- Item 1 -->\n<div>\n<div class=\"flex justify-between text-caption font-label-md mb-1 text-text-primary\">\n<span class=\"flex items-center space-x-1.5\">\n<span class=\"material-symbols-outlined text-sm text-primary\" data-icon=\"devices\">devices</span>\n<span>IT &amp; Telecom</span>\n</span>\n<span class=\"font-bold\">42% (62.4 T)</span>\n</div>\n<div class=\"w-full h-2 bg-surface-container-high rounded-full overflow-hidden\">\n<div class=\"h-full bg-primary rounded-full\" style=\"width: 42%;\"></div>\n</div>\n</div>\n<!-- Item 2 -->\n<div>\n<div class=\"flex justify-between text-caption font-label-md mb-1 text-text-primary\">\n<span class=\"flex items-center space-x-1.5\">\n<span class=\"material-symbols-outlined text-sm text-secondary\" data-icon=\"tv\">tv</span>\n<span>Consumer Electronics</span>\n</span>\n<span class=\"font-bold\">28% (41.6 T)</span>\n</div>\n<div class=\"w-full h-2 bg-surface-container-high rounded-full overflow-hidden\">\n<div class=\"h-full bg-primary-container rounded-full\" style=\"width: 28%;\"></div>\n</div>\n</div>\n<!-- Item 3 -->\n<div>\n<div class=\"flex justify-between text-caption font-label-md mb-1 text-text-primary\">\n<span class=\"flex items-center space-x-1.5\">\n<span class=\"material-symbols-outlined text-sm text-text-secondary\" data-icon=\"kitchen\">kitchen</span>\n<span>Large Appliances</span>\n</span>\n<span class=\"font-bold\">18% (26.7 T)</span>\n</div>\n<div class=\"w-full h-2 bg-surface-container-high rounded-full overflow-hidden\">\n<div class=\"h-full bg-secondary rounded-full\" style=\"width: 18%;\"></div>\n</div>\n</div>\n<!-- Item 4 -->\n<div>\n<div class=\"flex justify-between text-caption font-label-md mb-1 text-text-primary\">\n<span class=\"flex items-center space-x-1.5\">\n<span class=\"material-symbols-outlined text-sm text-tertiary-container\" data-icon=\"battery_charging_full\">battery_charging_full</span>\n<span>Batteries &amp; Components</span>\n</span>\n<span class=\"font-bold\">12% (17.8 T)</span>\n</div>\n<div class=\"w-full h-2 bg-surface-container-high rounded-full overflow-hidden\">\n<div class=\"h-full bg-tertiary-container rounded-full\" style=\"width: 12%;\"></div>\n</div>\n</div>\n</div>\n</section>\n<!-- Section 5: Detailed E-Waste Stream Activity Table / List -->\n<section class=\"bg-surface rounded-lg border border-border shadow-sm overflow-hidden\">\n<div class=\"px-4 py-3 border-b border-border flex justify-between items-center bg-surface-container-lowest\">\n<div>\n<h2 class=\"font-headline-sm text-label-md font-bold text-text-primary\">Live Stream Activity</h2>\n<p class=\"font-body-md text-caption text-text-secondary\">Recent processing intake</p>\n</div>\n<button class=\"flex items-center space-x-1 bg-primary text-on-primary px-2.5 py-1.5 rounded text-caption font-label-md hover:bg-primary-container active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined text-sm\" data-icon=\"download\">download</span>\n<span>Export CSV</span>