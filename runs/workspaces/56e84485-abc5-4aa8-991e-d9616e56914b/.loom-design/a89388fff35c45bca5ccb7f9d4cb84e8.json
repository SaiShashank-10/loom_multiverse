  "html": "<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Settings &amp; Preferences - EcoStream Live</title>\n<!-- Google Fonts -->\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&amp;family=Open+Sans:wght@400;500;600;700&amp;family=Roboto+Flex:wght@600;700&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Material Symbols Outlined -->\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Tailwind CSS -->\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          \"colors\": {\n            \"text-primary\": \"#343a40\",\n            \"surface-container-lowest\": \"#ffffff\",\n            \"secondary-fixed-dim\": \"#bfc8d0\",\n            \"on-secondary\": \"#ffffff\",\n            \"tertiary-fixed\": \"#ffdbcc\",\n            \"primary\": \"#0059bb\",\n            \"text-secondary\": \"#6c757d\",\n            \"surface-tint\": \"#005bc0\",\n            \"on-tertiary-fixed\": \"#351000\",\n            \"on-tertiary-container\": \"#fffbff\",\n            \"on-secondary-container\": \"#5b646b\",\n            \"outline\": \"#717786\",\n            \"error\": \"#dc3545\",\n            \"surface-container-low\": \"#eff4fc\",\n            \"on-error\": \"#ffffff\",\n            \"primary-fixed\": \"#d8e2ff\",\n            \"success\": \"#28a745\",\n            \"surface-dim\": \"#d5dae2\",\n            \"tertiary-container\": \"#c64f00\",\n            \"on-secondary-fixed-variant\": \"#3f484f\",\n            \"tertiary-fixed-dim\": \"#ffb695\",\n            \"surface-container\": \"#e9eef6\",\n            \"surface-container-highest\": \"#dde3eb\",\n            \"on-surface\": \"#161c22\",\n            \"on-primary\": \"#ffffff\",\n            \"on-background\": \"#161c22\",\n            \"surface-container-high\": \"#e3e9f0\",\n            \"on-tertiary-fixed-variant\": \"#7c2e00\",\n            \"primary-container\": \"#0070ea\",\n            \"inverse-on-surface\": \"#ecf1f9\",\n            \"surface\": \"#f8f9fa\",\n            \"secondary-container\": \"#d8e1ea\",\n            \"surface-variant\": \"#dde3eb\",\n            \"on-secondary-fixed\": \"#141d23\",\n            \"primary-fixed-dim\": \"#adc7ff\",\n            \"on-primary-fixed-variant\": \"#004493\",\n            \"inverse-primary\": \"#adc7ff\",\n            \"error-container\": \"#ffdad6\",\n            \"on-primary-fixed\": \"#001a41\",\n            \"on-tertiary\": \"#ffffff\",\n            \"border\": \"#dee2e6\",\n            \"surface-bright\": \"#f7f9ff\",\n            \"background\": \"#ffffff\",\n            \"on-surface-variant\": \"#414754\",\n            \"on-primary-container\": \"#fefcff\",\n            \"inverse-surface\": \"#2b3137\",\n            \"warning\": \"#ffc107\",\n            \"outline-variant\": \"#c1c6d7\",\n            \"secondary\": \"#575f67\",\n            \"on-error-container\": \"#93000a\",\n            \"tertiary\": \"#9e3d00\",\n            \"secondary-fixed\": \"#dbe4ed\"\n          },\n          \"borderRadius\": {\n            \"DEFAULT\": \"0.125rem\",\n            \"lg\": \"0.25rem\",\n            \"xl\": \"0.5rem\",\n            \"full\": \"0.75rem\"\n          },\n          \"spacing\": {\n            \"margin-mobile\": \"1.5rem\",\n            \"gutter\": \"1rem\",\n            \"space-sm\": \"0.5rem\",\n            \"space-xs\": \"0.25rem\",\n            \"space-xl\": \"2rem\",\n            \"space-md\": \"1rem\",\n            \"space-lg\": \"1.5rem\",\n            \"margin\": \"3rem\"\n          },\n          \"fontFamily\": {\n            \"headline-lg-mobile\": [\"Roboto Flex\"],\n            \"headline-lg\": [\"Roboto Flex\"],\n            \"caption\": [\"Montserrat\"],\n            \"headline-sm\": [\"Open Sans\"],\n            \"body-lg\": [\"Montserrat\"],\n            \"headline-md\": [\"Open Sans\"],\n            \"label-md\": [\"Open Sans\"],\n            \"label-sm\": [\"Open Sans\"],\n            \"body-md\": [\"Montserrat\"]\n          },\n          \"fontSize\": {\n            \"headline-lg-mobile\": [\"26px\", { \"lineHeight\": \"32px\", \"fontWeight\": \"700\" }],\n            \"headline-lg\": [\"32px\", { \"lineHeight\": \"38px\", \"fontWeight\": \"700\" }],\n            \"caption\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }],\n            \"headline-sm\": [\"20px\", { \"lineHeight\": \"26px\", \"fontWeight\": \"600\" }],\n            \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }],\n            \"headline-md\": [\"24px\", { \"lineHeight\": \"31px\", \"fontWeight\": \"600\" }],\n            \"label-md\": [\"14px\", { \"lineHeight\": \"18px\", \"fontWeight\": \"600\" }],\n            \"label-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"500\" }],\n            \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }]\n          }\n        },\n      },\n    }\n  </script>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-background text-text-primary antialiased min-h-screen pb-24 select-none\">\n<!-- TopAppBar: Anchored Shared Component -->\n<header class=\"fixed top-0 left-0 w-full z-50 flex justify-between items-center px-4 py-3 bg-surface border-b border-border shadow-sm\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-2xl\" data-icon=\"recycling\">recycling</span>\n<span class=\"font-headline-sm text-headline-sm text-primary tracking-tight font-bold\">EcoStream Live</span>\n</div>\n<div class=\"flex items-center gap-3\">\n<button aria-label=\"Notifications\" class=\"relative p-1.5 text-text-secondary hover:text-text-primary rounded-lg hover:bg-surface-container transition-colors\">\n<span class=\"material-symbols-outlined text-2xl\" data-icon=\"notifications\">notifications</span>\n<span class=\"absolute top-1 right-1 w-2.5 h-2.5 bg-error rounded-full ring-2 ring-surface\"></span>\n</button>\n<div class=\"h-8 w-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-label-md text-label-md font-bold\">\n        ER\n      </div>\n</div>\n</header>\n<!-- Main Canvas -->\n<main class=\"pt-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n<!-- Page Context Title & Subtitle -->\n<div class=\"mb-6\">\n<div class=\"flex items-center gap-2 text-text-secondary text-caption font-caption mb-1\">\n<span>Console</span>\n<span class=\"material-symbols-outlined text-sm\" data-icon=\"chevron_right\">chevron_right</span>\n<span class=\"text-text-primary font-medium\">Settings &amp; Preferences</span>\n</div>\n<h1 class=\"font-headline-md text-headline-md text-text-primary font-bold tracking-tight\">System &amp; Account Settings</h1>\n<p class=\"font-body-md text-body-md text-text-secondary mt-1\">Configure organizational profile, automated compliance alerts, telemetry thresholds, and security preferences.</p>\n</div>\n<!-- Layout Grid -->\n<div class=\"space-y-6\">\n<!-- Section 1: Organization & Profile -->\n<section class=\"bg-surface rounded-xl border border-border p-6 shadow-sm\">\n<div class=\"flex items-center justify-between border-b border-border pb-4 mb-5\">\n<div class=\"flex items-center gap-2.5\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"badge\">badge</span>\n<h2 class=\"font-headline-sm text-headline-sm text-text-primary font-semibold\">Organization &amp; Profile</h2>\n</div>\n<span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm font-label-sm font-semibold bg-primary-fixed text-on-primary-fixed-variant\">\n            Verified Facility\n          </span>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-start\">\n<!-- Profile Avatar & Badges -->\n<div class=\"md:col-span-4 flex flex-col items-center p-4 bg-surface-container-lowest rounded-lg border border-border text-center\">\n<div class=\"relative mb-3\">\n<div class=\"w-24 h-24 rounded-full bg-surface-container-high border-2 border-primary text-primary flex items-center justify-center font-headline-md text-headline-md font-bold shadow-inner\">\n                ER\n              </div>\n<button class=\"absolute bottom-0 right-0 p-1.5 bg-primary text-on-primary rounded-full hover:bg-primary-container shadow transition-all active:scale-95\" title=\"Edit Profile Photo\">\n<span class=\"material-symbols-outlined text-sm block\" data-icon=\"photo_camera\">photo_camera</span>\n</button>\n</div>\n<h3 class=\"font-label-md text-label-md text-text-primary font-semibold\">Dr. Elena Rostova</h3>\n<span class=\"inline-block mt-1 px-2.5 py-0.5 rounded-full text-caption font-caption font-semibold bg-surface-container text-text-secondary border border-border\">\n              Compliance Administrator\n            </span>\n<p class=\"font-caption text-caption text-text-secondary mt-2\">Facility Supervisor • Node 4 Pacific</p>\n<button class=\"mt-3 w-full py-1.5 px-3 border border-border rounded-lg text-label-sm font-label-sm font-semibold text-text-primary hover:bg-surface-container transition-colors\">\n              Edit Photo\n            </button>\n</div>\n<!-- Form Fields -->\n<div class=\"md:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-4\">\n<div>\n<label class=\"block font-label-sm text-label-sm font-semibold text-text-primary mb-1.5\">Full Name</label>\n<div class=\"relative\">\n<input class=\"w-full bg-surface-container-lowest border border-border rounded-lg px-3 py-2 text-body-md font-body-md text-text-primary focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all\" type=\"text\" value=\"Dr. Elena Rostova\"/>\n<span class=\"material-symbols-outlined absolute right-2.5 top-2.5 text-text-secondary text-lg\" data-icon=\"person\">person</span>\n</div>\n</div>\n<div>\n<label class=\"block font-label-sm text-label-sm font-semibold text-text-primary mb-1.5\">Work Email</label>\n<div class=\"relative\">\n<input class=\"w-full bg-surface-container-lowest border border-border rounded-lg px-3 py-2 text-body-md font-body-md text-text-primary focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all\" type=\"email\" value=\"e.rostova@ecostream.org\"/>\n<span class=\"material-symbols-outlined absolute right-2.5 top-2.5 text-text-secondary text-lg\" data-icon=\"mail\">mail</span>\n</div>\n</div>\n<div class=\"sm:col-span-2\">\n<label class=\"block font-label-sm text-label-sm font-semibold text-text-primary mb-1.5\">Facility / Depot Node</label>\n<div class=\"relative\">\n<input class=\"w-full bg-surface-container-lowest border border-border rounded-lg px-3 py-2 text-body-md font-body-md text-text-primary focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all\" type=\"text\" value=\"Pacific Port Depository - Node 4\"/>\n<span class=\"material-symbols-outlined absolute right-2.5 top-2.5 text-text-secondary text-lg\" data-icon=\"factory\">factory</span>\n</div>\n</div>\n<div class=\"sm:col-span-2 flex items-center justify-between p-3 bg-surface-container-lowest rounded-lg border border-border\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-success text-lg\" data-icon=\"verified_user\">verified_user</span>\n<div>\n<span class=\"block font-label-sm text-label-sm text-text-primary font-semibold\">Basel Convention Compliance Role</span>\n<span class=\"font-caption text-caption text-text-secondary\">Authorized to digitally certify e-waste transboundary manifests</span>\n</div>\n</div>\n<span class=\"text-caption font-caption font-bold px-2 py-0.5 rounded bg-success/10 text-success\">Active</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Section 2: Telemetry & Monitoring Alerts -->\n<section class=\"bg-surface rounded-xl border border-border p-6 shadow-sm\">\n<div class=\"flex items-center justify-between border-b border-border pb-4 mb-5\">\n<div class=\"flex items-center gap-2.5\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"sensors\">sensors</span>\n<h2 class=\"font-headline-sm text-headline-sm text-text-primary font-semibold\">Telemetry &amp; Monitoring Alerts</h2>\n</div>\n<span class=\"text-label-sm font-label-sm text-text-secondary\">Real-time Stream Engine</span>\n</div>\n<div class=\"space-y-4\">\n<!-- Toggle 1 -->\n<div class=\"flex items-center justify-between p-3.5 bg-surface-container-lowest rounded-lg border border-border hover:border-outline-variant transition-colors\">\n<div class=\"pr-4\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-md text-label-md font-semibold text-text-primary\">Real-time Inflow Threshold Alerts</span>\n<span class=\"text-xs px-2 py-0.5 rounded bg-primary-fixed text-on-primary-fixed-variant font-medium\">Critical</span>\n</div>\n<p class=\"font-body-md text-body-md text-text-secondary mt-0.5\">Notify when physical mass intake spikes beyond 25 Metric Tons per day.</p>\n</div>\n<label class=\"relative inline-flex items-center cursor-pointer flex-shrink-0\">\n<input checked=\"\" class=\"sr-only peer\" type=\"checkbox\"/>\n<div class=\"w-11 h-6 bg-border peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-container\"></div>\n</label>\n</div>\n<!-- Toggle 2 -->\n<div class=\"flex items-center justify-between p-3.5 bg-surface-container-lowest rounded-lg border border-border hover:border-outline-variant transition-colors\">\n<div class=\"pr-4\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-md text-label-md font-semibold text-text-primary\">Automated Manifest Sync</span>\n</div>\n<p class=\"font-body-md text-body-md text-text-secondary mt-0.5\">Instantly synchronize Basel Convention certificates and customs clearance keys to the cloud ledger.</p>\n</div>\n<label class=\"relative inline-flex items-center cursor-pointer flex-shrink-0\">\n<input checked=\"\" class=\"sr-only peer\" type=\"checkbox\"/>\n<div class=\"w-11 h-6 bg-border peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-container\"></div>\n</label>\n</div>\n<!-- Toggle 3 -->\n<div class=\"flex items-center justify-between p-3.5 bg-surface-container-lowest rounded-lg border border-border hover:border-outline-variant transition-colors\">\n<div class=\"pr-4\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-md text-label-md font-semibold text-text-primary\">Hazardous Material Detection Warning</span>\n<span class=\"text-xs px-2 py-0.5 rounded bg-error/10 text-error font-medium\">Urgent</span>\n</div>\n<p class=\"font-body-md text-body-md text-text-secondary mt-0.5\">Dispatch immediate SMS &amp; push notifications on Lithium-ion thermal runaway or mercury vapor detection.</p>\n</div>\n<label class=\"relative inline-flex items-center cursor-pointer flex-shrink-0\">\n<input checked=\"\" class=\"sr-only peer\" type=\"checkbox\"/>\n<div class=\"w-11 h-6 bg-border peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-container\"></div>\n</label>\n</div>\n<!-- Toggle 4 -->\n<div class=\"flex items-center justify-between p-3.5 bg-surface-container-lowest rounded-lg border border-border hover:border-outline-variant transition-colors\">\n<div class=\"pr-4\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-md text-label-md font-semibold text-text-primary\">Weekly Sustainability Digest</span>\n</div>\n<p class=\"font-body-md text-body-md text-text-secondary mt-0.5\">Receive weekly automated email briefings summarizing Metric Tons of CO2e offset and metals diverted.</p>\n</div>\n<label class=\"relative inline-flex items-center cursor-pointer flex-shrink-0\">\n<input class=\"sr-only peer\" type=\"checkbox\"/>\n<div class=\"w-11 h-6 bg-border peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-container\"></div>\n</label>\n</div>\n<!-- Threshold Slider / Input -->\n<div class=\"p-4 bg-surface-container-low rounded-lg border border-border mt-3\">\n<div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n<div>\n<label class=\"font-label-md text-label-md font-semibold text-text-primary block\">Daily Capacity Alert Limit</label>\n<p class=\"font-caption text-caption text-text-secondary\">Depot triggers quarantine buffer when daily e-waste intake reaches this value.</p>\n</div>\n<div class=\"flex items-center gap-2\">\n<div class=\"relative w-36\">\n<input class=\"w-full bg-surface-container-lowest border border-border rounded-lg px-3 py-1.5 text-body-md font-body-md text-text-primary font-semibold text-right pr-12 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20\" step=\"0.5\" type=\"number\" value=\"150.0\"/>\n<span class=\"absolute right-3 top-2 text-caption font-caption text-text-secondary font-medium\">Tons</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Section 3: Data & Export Preferences -->\n<section class=\"bg-surface rounded-xl border border-border p-6 shadow-sm\">\n<div class=\"flex items-center justify-between border-b border-border pb-4 mb-5\">\n<div class=\"flex items-center gap-2.5\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"tune\">tune</span>\n<h2 class=\"font-headline-sm text-headline-sm text-text-primary font-semibold\">Data &amp; Export Preferences</h2>\n</div>\n<span class=\"text-label-sm font-label-sm text-text-secondary\">System Integration</span>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n<!-- Segmented Export Format -->\n<div class=\"space-y-1.5\">\n<label class=\"font-label-sm text-label-sm font-semibold text-text-primary block\">Default Export Dossier Format</label>\n<div class=\"grid grid-cols-3 gap-1 p-1 bg-surface-container-lowest border border-border rounded-lg\">\n<button class=\"py-1.5 text-label-sm font-label-sm font-semibold rounded bg-primary text-on-primary shadow-xs\" type=\"button\">\n                PDF Summary\n              </button>\n<button class=\"py-1.5 text-label-sm font-label-sm font-medium text-text-secondary hover:text-text-primary hover:bg-surface-container transition-colors rounded\" type=\"button\">\n                CSV Dossier\n              </button>\n<button class=\"py-1.5 text-label-sm font-label-sm font-medium text-text-secondary hover:text-text-primary hover:bg-surface-container transition-colors rounded\" type=\"button\">\n                JSON Stream\n              </button>\n</div>\n<p class=\"font-caption text-caption text-text-secondary\">Standard compliant format for customs reporting</p>\n</div>\n<!-- Polling Rate -->\n<div class=\"space-y-1.5\">\n<label class=\"font-label-sm text-label-sm font-semibold text-text-primary block\">Telemetry Polling Rate</label>\n<div class=\"relative\">\n<select class=\"w-full appearance-none bg-surface-container-lowest border border-border rounded-lg px-3 py-2 text-body-md font-body-md text-text-primary focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20\">\n<option selected=\"\">Real-time (30s Polling)</option>\n<option>5 minutes (Standard Battery Save)</option>\n<option>Hourly (Aggregated Summary)</option>\n</select>\n<span class=\"material-symbols-outlined absolute right-3 top-2.5 text-text-secondary pointer-events-none\" data-icon=\"expand_more\">expand_more</span>\n</div>\n<p class=\"font-caption text-caption text-text-secondary\">Higher polling rates yield pinpoint thermal dissipation logs</p>\n</div>\n<!-- Auto-Archive Records Toggle -->\n<div class=\"md:col-span-2 flex items-center justify-between p-3.5 bg-surface-container-lowest rounded-lg border border-border\">\n<div>\n<span class=\"font-label-md text-label-md font-semibold text-text-primary block\">Automated Historical Records Archiving</span>\n<p class=\"font-body-md text-body-md text-text-secondary\">Automatically transfer immutable chain-of-custody manifests to cold storage after 180 operational days.</p>\n</div>\n<label class=\"relative inline-flex items-center cursor-pointer flex-shrink-0 ml-4\">\n<input checked=\"\" class=\"sr-only peer\" type=\"checkbox\"/>\n<div class=\"w-11 h-6 bg-border peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-container\"></div>\n</label>\n</div>\n</div>\n</section>\n<!-- Section 4: Security & Compliance -->\n<section class=\"bg-surface rounded-xl border border-border p-6 shadow-sm\">\n<div class=\"flex items-center justify-between border-b border-border pb-4 mb-5\">\n<div class=\"flex items-center gap-2.5\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"shield\">shield</span>\n<h2 class=\"font-headline-sm text-headline-sm text-text-primary font-semibold\">Security &amp; Compliance</h2>\n</div>\n<span class=\"inline-flex items-center gap-1 text-label-sm font-label-sm font-semibold text-success\">\n<span class=\"material-symbols-outlined text-sm\" data-icon=\"lock\">lock</span>\n            Encrypted\n          </span>\n</div>\n<div class=\"space-y-4\">\n<!-- 2FA Box -->\n<div class=\"flex flex-col sm:flex-row sm:items-center justify-between p-4 bg-surface-container-lowest rounded-lg border border-border gap-3\">\n<div class=\"flex items-start gap-3\">\n<div class=\"p-2 bg-success/10 rounded-lg text-success\">\n<span class=\"material-symbols-outlined text-xl block\" data-icon=\"phonelink_lock\">phonelink_lock</span>\n</div>\n<div>\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-md text-label-md font-semibold text-text-primary\">Two-Factor Authentication (2FA)</span>\n<span class=\"px-2 py-0.5 rounded-full text-caption font-caption font-bold bg-success/10 text-success\">Active</span>\n</div>\n<p class=\"font-caption text-caption text-text-secondary mt-0.5\">Enforced hardware key via FIDO2 / Authenticator App</p>\n</div>\n</div>\n<button class=\"px-3 py-1.5 text-label-sm font-label-sm font-semibold border border-border rounded-lg text-text-primary hover:bg-surface-container transition-colors self-start sm:self-auto\">\n              Reconfigure\n            </button>\n</div>\n<!-- Session Timeout & Digital Signature Key -->\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n<div class=\"p-3 bg-surface-container-lowest rounded-lg border border-border\">\n<label cla