ne-md\": [\"Space Grotesk\"],\n            \"label-lg\": [\"Space Grotesk\"],\n            \"label-md\": [\"Space Grotesk\"],\n            \"display-lg-mobile\": [\"Space Grotesk\"],\n            \"body-sm\": [\"Hanken Grotesk\"],\n            \"headline-sm\": [\"Space Grotesk\"],\n            \"display-lg\": [\"Space Grotesk\"],\n            \"label-sm\": [\"Space Grotesk\"],\n            \"headline-lg\": [\"Space Grotesk\"]\n          },\n          \"fontSize\": {\n            \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0em\", \"fontWeight\": \"400\" }],\n            \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"400\" }],\n            \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"600\" }],\n            \"label-lg\": [\"14px\", { \"lineHeight\": \"18px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"500\" }],\n            \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.03em\", \"fontWeight\": \"500\" }],\n            \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"38px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }],\n            \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"400\" }],\n            \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"letterSpacing\": \"0em\", \"fontWeight\": \"600\" }],\n            \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.03em\", \"fontWeight\": \"700\" }],\n            \"label-sm\": [\"10px\", { \"lineHeight\": \"14px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"600\" }],\n            \"headline-lg\": [\"28px\", { \"lineHeight\": \"34px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"600\" }]\n          }\n        }\n      }\n    }\n  </script>\n<style>\n    .material-symbols-outlined {\n      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n      display: inline-block;\n      vertical-align: middle;\n      line-height: 1;\n    }\n    @keyframes pulse-ring {\n      0% { transform: scale(0.92); opacity: 0.8; }\n      50% { transform: scale(1.15); opacity: 0.25; }\n      100% { transform: scale(0.92); opacity: 0.8; }\n    }\n    .animate-pulse-ring {\n      animation: pulse-ring 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n    }\n    @keyframes scan-line {\n      0% { top: 12%; opacity: 0.85; }\n      50% { top: 78%; opacity: 0.45; }\n      100% { top: 12%; opacity: 0.85; }\n    }\n    .animate-scan-laser {\n      animation: scan-line 3.2s ease-in-out infinite;\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-surface text-on-surface antialiased min-h-screen flex justify-center selection:bg-primary selection:text-on-primary\">\n<!-- Mobile Device Simulation Frame (Flutter Single-Hand Ergonomics Target 412x915) -->\n<div class=\"relative w-full max-w-md bg-surface-container-lowest min-h-screen flex flex-col shadow-2xl overflow-x-hidden border-x border-outline-variant/30\">\n<!-- Native Mobile OS Status Bar -->\n<div class=\"w-full px-6 pt-3 pb-1 flex justify-between items-center bg-surface-container-lowest z-30 select-none\">\n<span class=\"font-headline-sm text-headline-sm text-on-surface font-semibold tracking-tight text-xs\">9:41</span>\n<div class=\"flex items-center space-x-2 text-on-surface\">\n<span class=\"material-symbols-outlined text-sm\">signal_cellular_4_bar</span>\n<span class=\"material-symbols-outlined text-sm\">wifi</span>\n<span class=\"material-symbols-outlined text-base\">battery_full</span>\n</div>\n</div>\n<!-- Top Navigation Bar (Shared Component Anchor) -->\n<header class=\"bg-surface dark:bg-inverse-surface flex justify-between items-center w-full px-5 py-2.5 z-30\">\n<div class=\"flex items-center space-x-3\">\n<button aria-label=\"Back to wardrobe\" class=\"w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined text-lg\">arrow_back</span>\n</button>\n<div>\n<h1 class=\"text-headline-sm font-headline-sm font-bold text-on-surface dark:text-inverse-on-surface leading-tight\">Style OS</h1>\n<p class=\"text-label-sm font-label-sm text-primary tracking-wide\">AI SCAN ENGINE v3.4</p>\n</div>\n</div>\n<div class=\"flex items-center space-x-2\">\n<button aria-label=\"Notifications\" class=\"w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-variant active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined text-lg\">notifications</span>\n</button>\n<div class=\"w-8 h-8 rounded-full border border-primary-container overflow-hidden\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Close-up portrait of an elegant stylish woman with sleek hair and minimal jewelry on a soft studio background representing refined fashion aesthetics.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBFYXSExTZwJlwqGmACCmvvEYzlj1WgExO40HvRP0dbeM0h9JnEtW8Z942TzobDfbsNcuqBpDKCPyFEMd2ECnbT73cW7NcslRuZqxoZB1QjRRkbS3btHBU-5U6yABBblayp8Ic5fxTvyYwefpao8GjLDlcLBfvf3-FzDGq7l58HlABILA2skgMfAi4GhH_K_fE4cx7rYyPSN4jY69BmPBvf7BuRnUoGHp1NYEKiY__VZpUdmBQWPvBqWBK8oTR-zhc8z9qA-aPwes0\"/>\n</div>\n</div>\n</header>\n<!-- Camera Mode Toggle Pill Switcher -->\n<div class=\"px-5 py-2 z-30 bg-surface-container-lowest\">\n<div class=\"bg-surface-container p-1 rounded-full flex items-center justify-between shadow-inner\">\n<button class=\"flex-1 py-1.5 px-3 rounded-full bg-surface-container-lowest text-on-surface font-label-md text-label-md font-semibold shadow-sm transition-all text-center\">\n          Single Item\n        </button>\n<button class=\"flex-1 py-1.5 px-3 rounded-full text-secondary font-label-md text-label-md hover:text-on-surface transition-all text-center flex items-center justify-center gap-1\">\n<span>Rapid Multi</span>\n<span class=\"w-2 h-2 rounded-full bg-primary-container\"></span>\n</button>\n<button class=\"flex-1 py-1.5 px-3 rounded-full text-secondary font-label-md text-label-md hover:text-on-surface transition-all text-center\">\n          Gallery\n        </button>\n</div>\n</div>\n<!-- Main Viewport Canvas (Camera Viewfinder with Real-Time AI Detection) -->\n<main class=\"relative flex-1 bg-inverse-surface mx-4 my-1 rounded-3xl overflow-hidden shadow-lg border border-outline-variant/30 flex flex-col justify-between\">\n<!-- Viewfinder Feed Simulation Background -->\n<div class=\"absolute inset-0 z-0\">\n<img class=\"w-full h-full object-cover object-center scale-105\" data-alt=\"High-end sartorial Italian dark charcoal navy tailored wool blazer positioned smoothly against an ultra clean architectural studio surface. Studio high-key diffused lighting illuminates crisp fabric lapel weave and precise sartorial shoulder structure for cataloging.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBWXCMOGDucuwCE81lqOasWMGYOPA_KIMTpbYSLP9fbMfQ8Om7Dm8tproK0F4_k0ZJeBDPgZOE8RT2tHDjKoc4i-qf3b_p46lnFj7ZrqkrQW1--PP9o83AvyvI-HSVKBLtgEB2xv9aFX7z-gCWVVY0qUlYkRNVCaWXBg0_CNyR5ZUsWLqvwCr-dqLFUyJ5V1aHiMTnmccDxR9exj5e5EtTEbc4WeWkw178hIy6ZC1jw6Fglp2A6UaKXsway-pFy1TojJBs8z3Sv_UU\"/>\n<div class=\"absolute inset-0 bg-gradient-to-b from-inverse-surface/40 via-transparent to-inverse-surface/80\"></div>\n</div>\n<!-- Camera Optical Guidelines Grid -->\n<div class=\"absolute inset-0 pointer-events-none z-10 grid grid-cols-3 grid-rows-3 opacity-20\">\n<div class=\"border-r border-b border-surface-container-lowest\"></div>\n<div class=\"border-r border-b border-surface-container-lowest\"></div>\n<div class=\"border-b border-surface-container-lowest\"></div>\n<div class=\"border-r border-b border-surface-container-lowest\"></div>\n<div class=\"border-r border-b border-surface-container-lowest\"></div>\n<div class=\"border-b border-surface-container-lowest\"></div>\n<div class=\"border-r border-surface-container-lowest\"></div>\n<div class=\"border-r border-surface-container-lowest\"></div>\n<div></div>\n</div>\n<!-- Active Laser Scan Beam -->\n<div class=\"absolute left-6 right-6 h-0.5 bg-gradient-to-r from-transparent via-primary-container to-transparent z-15 pointer-events-none animate-scan-laser shadow-[0_0_12px_#0070ea]\"></div>\n<!-- Top Camera Quick Controls Overlay -->\n<div class=\"relative z-20 flex justify-between items-center p-4\">\n<div class=\"flex items-center space-x-2 bg-inverse-surface/60 backdrop-blur-md px-3 py-1.5 rounded-full border border-surface-container-lowest/15 text-surface-container-lowest\">\n<button aria-label=\"Toggle flash\" class=\"p-1 rounded-full hover:bg-surface-container-lowest/20 transition-colors\">\n<span class=\"material-symbols-outlined text-sm\">flash_on</span>\n</button>\n<div class=\"h-3 w-px bg-surface-container-lowest/30\"></div>\n<button aria-label=\"Grid lines active\" class=\"p-1 rounded-full hover:bg-surface-container-lowest/20 transition-colors text-primary-fixed\">\n<span class=\"material-symbols-outlined text-sm\">grid_on</span>\n</button>\n<div class=\"h-3 w-px bg-surface-container-lowest/30\"></div>\n<button aria-label=\"HDR mode\" class=\"p-1 rounded-full hover:bg-surface-container-lowest/20 transition-colors\">\n<span class=\"text-label-sm font-label-sm font-bold text-surface-bright\">HDR</span>\n</button>\n</div>\n<div class=\"bg-primary-container/90 backdrop-blur-md px-3 py-1.5 rounded-full text-on-primary font-label-sm text-label-sm flex items-center space-x-1.5 shadow-md\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-surface-bright animate-ping\"></span>\n<span>AUTO-DETECT LIVE</span>\n</div>\n</div>\n<!-- AI Bounding Box & Live Optical Recognition Anchors -->\n<div class=\"relative z-20 mx-6 my-auto aspect-[3/4] border-2 border-primary/80 rounded-2xl p-3 flex flex-col justify-between shadow-[0_0_24px_rgba(0,112,234,0.3)] backdrop-brightness-105\">\n<!-- Bounding Box Corner Brackets -->\n<div class=\"absolute -top-1.5 -left-1.5 w-5 h-5 border-t-4 border-l-4 border-primary rounded-tl-md\"></div>\n<div class=\"absolute -top-1.5 -right-1.5 w-5 h-5 border-t-4 border-r-4 border-primary rounded-tr-md\"></div>\n<div class=\"absolute -bottom-1.5 -left-1.5 w-5 h-5 border-b-4 border-l-4 border-primary rounded-bl-md\"></div>\n<div class=\"absolute -bottom-1.5 -right-1.5 w-5 h-5 border-b-4 border-r-4 border-primary rounded-br-md\"></div>\n<!-- Real-Time AI Tags Overlay -->\n<div class=\"flex flex-col space-y-1.5 items-start\">\n<!-- Classification Chip -->\n<div class=\"bg-inverse-surface/85 backdrop-blur-md border border-primary-container/40 px-2.5 py-1 rounded-full flex items-center space-x-1.5 shadow-lg\">\n<span class=\"material-symbols-outlined text-primary-fixed text-xs\">checkroom</span>\n<span class=\"font-headline-sm text-label-sm font-bold text-surface-bright\">Outerwear / Tailored Blazer</span>\n<span class=\"bg-primary px-1.5 py-0.5 rounded-full text-[9px] font-label-sm text-on-primary\">99.2%</span>\n</div>\n<!-- Color Chip -->\n<div class=\"bg-inverse-surface/80 backdrop-blur-md border border-surface-container-lowest/15 px-2.5 py-1 rounded-full flex items-center space-x-2\">\n<span class=\"w-2.5 h-2.5 rounded-full bg-[#2B3448] ring-1 ring-white/60\"></span>\n<span class=\"font-body-sm text-body-sm text-surface-bright\">Charcoal Navy</span>\n<span class=\"text-[10px] text-outline-variant font-label-sm\">#2B3448</span>\n</div>\n</div>\n<!-- Center Focus Reticle -->\n<div class=\"self-center flex items-center justify-center\">\n<div class=\"relative w-12 h-12 flex items-center justify-center\">\n<div class=\"absolute inset-0 border border-primary/60 rounded-full animate-ping opacity-40\"></div>\n<div class=\"w-8 h-8 border border-surface-bright/80 rounded-full flex items-center justify-center\">\n<div class=\"w-1.5 h-1.5 bg-primary-container rounded-full\"></div>\n</div>\n</div>\n</div>\n<!-- Lower Metadata Detection Badge -->\n<div class=\"flex justify-between items-end\">\n<div class=\"bg-inverse-surface/85 backdrop-blur-md border border-surface-container-lowest/20 p-2 rounded-xl text-surface-bright flex flex-col space-y-0.5 shadow-md\">\n<div class=\"flex items-center space-x-1\">\n<span class=\"material-symbols-outlined text-tertiary-fixed text-xs\">verified</span>\n<span class=\"font-label-sm text-label-sm font-bold text-surface-bright\">100% Super 120s Wool</span>\n</div>\n<span class=\"font-body-sm text-[11px] text-outline-variant\">Weave: Fine Twill · Weight: 280gsm</span>\n</div>\n<div class=\"bg-primary-container text-on-primary font-label-sm text-label-sm px-2.5 py-1 rounded-full font-semibold shadow-md flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-xs\">straighten</span>\n<span>Slim Fit</span>\n</div>\n</div>\n</div>\n<!-- Live Batch Tray Strip Preview (3 recent scans) -->\n<div class=\"relative z-20 px-4 py-2 flex items-center justify-between bg-inverse-surface/75 backdrop-blur-lg border-t border-surface-container-lowest/10\">\n<div class=\"flex items-center space-x-2\">\n<span class=\"font-label-sm text-label-sm text-outline-variant uppercase tracking-wider\">Batch (3)</span>\n<div class=\"flex -space-x-2 overflow-hidden\">\n<div class=\"w-7 h-7 rounded-lg border border-surface-container-lowest overflow-hidden\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Minimalist cream cashmere crewneck sweater on studio pedestal under soft daylight high fashion clothing catalog photography.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBVJ4_7iHGx8E327mUsPn2vr8eHeRbpW-0bezCijY8smfdG0y62H3jwTXPHwc69kSenNYDdIS9OdExRL9PRa8sgoWXl4Z8dwcuKbTiBbF2SAvLfOQEW4Xt070pdHVP7uo0tZCXAHX-X5g83D_l1_a49ndsKbojRHnZVxIDcu0R-gUEkcDLs0dwShVhODKs7wFqkVhC97Rr4gu1A0Zm-BtKvNXmvrzqUCUOElBzWrSNlS1eCItjfgh1qdLhuXI8_oDPQ0NepbvPRc00\"/>\n</div>\n<div class=\"w-7 h-7 rounded-lg border border-surface-container-lowest overflow-hidden\">\n<img