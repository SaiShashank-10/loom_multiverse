nd Anchor -->\n<div>\n<span class=\"text-headline-sm font-headline-sm font-bold text-on-surface tracking-tight\">Style OS</span>\n<div class=\"flex items-center gap-1.5\">\n<span class=\"inline-block w-1.5 h-1.5 rounded-full bg-tertiary-container animate-pulse\"></span>\n<span class=\"font-label-sm text-label-sm text-secondary tracking-wide uppercase\">AI Active</span>\n</div>\n</div>\n</div>\n<div class=\"flex items-center gap-2.5\">\n<!-- Live Weather Pill Mini -->\n<div class=\"flex items-center gap-1 bg-surface-container-lowest px-2.5 py-1 rounded-full border border-outline-variant/30 shadow-sm\">\n<span class=\"material-symbols-outlined text-amber-500 text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\">wb_sunny</span>\n<span class=\"font-label-sm text-label-sm text-on-surface font-semibold\">72°F</span>\n</div>\n<!-- Trailing Notifications with unread badge -->\n<button class=\"relative w-10 h-10 rounded-full flex items-center justify-center text-primary hover:bg-surface-container active:scale-95 transition-transform duration-150\">\n<span class=\"material-symbols-outlined text-[24px]\">notifications</span>\n<span class=\"absolute top-2 right-2 w-2 h-2 rounded-full bg-error ring-2 ring-surface\"></span>\n</button>\n</div>\n</div>\n</header>\n<!-- Interactive Navigation Drawer (Overlay & Persistent Rail Hybrid) -->\n<aside class=\"fixed inset-y-0 left-0 w-80 max-w-[80vw] bg-surface z-50 rounded-r-2xl shadow-2xl transform -translate-x-full transition-transform duration-300 ease-out flex flex-col p-4 space-y-2 border-r border-outline-variant/20\" id=\"navDrawer\">\n<!-- Drawer Profile Header -->\n<div class=\"flex items-center justify-between pb-4 border-b border-outline-variant/20 pt-2 px-2\">\n<div class=\"flex items-center gap-3\">\n<div class=\"relative\">\n<img class=\"w-12 h-12 rounded-full object-cover ring-2 ring-primary-container/40\" data-alt=\"Sophisticated professional portrait of Sarah Thompson with modern tailored blazer in a bright warm studio environment with soft natural lighting and minimalist architectural accents.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCe3gMc0Wd4HjtnKcenTmRneOVBRRcGzCOdvQ6NLu8wvlNta4j6k2uahmF4qporf5BliNqbCq2pjbx7q4_rqTR65C5vBUrO0vmS-feTUQNtJ5xSJgdmFJKi7-dXk7bZ821trHQzbdAP6R-aN1S7rI66r3ZAaHAqKpbbdYRrpVaVf4U21-fxnLm6sVIi1Vz-ANWWqWYJQg_6IPMBgQRfK7E9vxSZ2-Clwkkp11GifqfnJxsqD_I_XskePMJi1TQ5AkJYa7D1jElzcF8\"/>\n<span class=\"absolute bottom-0 right-0 w-3 h-3 bg-tertiary-container rounded-full ring-2 ring-surface\"></span>\n</div>\n<div>\n<h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold leading-tight\">Sarah Thompson</h4>\n<p class=\"font-label-md text-label-md text-on-surface-variant\">Sartorial Profile</p>\n<p class=\"font-label-sm text-label-sm text-primary font-medium mt-0.5\">Versatility Score: 88%</p>\n</div>\n</div>\n<button class=\"w-8 h-8 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-surface-container\" id=\"drawerClose\">\n<span class=\"material-symbols-outlined text-[20px]\">close</span>\n</button>\n</div>\n<!-- Navigation Drawer Links (Using Shared Components JSON Exact Structure) -->\n<nav class=\"flex-1 py-4 space-y-1\">\n<!-- Home (Active Item based on intent) -->\n<a class=\"flex items-center gap-3 bg-primary-container text-on-primary-container rounded-full px-4 py-3 font-semibold text-label-lg font-label-lg transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined text-[22px]\" style=\"font-variation-settings: 'FILL' 1;\">home</span>\n<span>Home</span>\n</a>\n<a class=\"flex items-center gap-3 text-on-surface-variant hover:bg-surface-container-low rounded-full px-4 py-3 text-label-lg font-label-lg transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined text-[22px]\">styler</span>\n<span>Virtual Try-on</span>\n</a>\n<a class=\"flex items-center gap-3 text-on-surface-variant hover:bg-surface-container-low rounded-full px-4 py-3 text-label-lg font-