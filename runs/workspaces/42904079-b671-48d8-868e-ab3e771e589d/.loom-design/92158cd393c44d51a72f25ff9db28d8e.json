crollbar-width: none;\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-surface text-on-surface antialiased selection:bg-primary selection:text-on-primary\">\n<!-- Mobile Viewport Simulator Outer Frame -->\n<div class=\"min-h-screen flex justify-center bg-surface-container-low sm:py-6\">\n<main class=\"w-full max-w-[430px] bg-surface flex flex-col min-h-screen relative shadow-2xl overflow-x-hidden pb-28\">\n<!-- iOS Status Bar (9:41 Safe Area) -->\n<div class=\"sticky top-0 z-50 bg-surface/90 backdrop-blur-md px-6 pt-3 pb-2 flex justify-between items-center text-on-surface\">\n<span class=\"font-headline-sm text-body-md font-semibold tracking-tight\">9:41</span>\n<div class=\"flex items-center space-x-2 text-on-surface\">\n<span class=\"material-symbols-outlined text-[16px]\">signal_cellular_4_bar</span>\n<span class=\"material-symbols-outlined text-[16px]\">wifi</span>\n<span class=\"material-symbols-outlined text-[20px]\">battery_full</span>\n</div>\n</div>\n<!-- Pinned Top App Bar Header -->\n<header class=\"bg-surface px-5 py-3 flex items-center justify-between sticky top-[38px] z-40\">\n<div class=\"flex items-center gap-3\">\n<button aria-label=\"Go back\" class=\"w-10 h-10 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined text-[22px]\">arrow_back</span>\n</button>\n<div>\n<h1 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Closet Health &amp; Audit</h1>\n<p class=\"font-label-sm text-label-sm text-secondary\">Style OS Sartorial Intelligence</p>\n</div>\n</div>\n<div class=\"flex items-center gap-1\">\n<button aria-label=\"Export audit report\" class=\"w-10 h-10 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined text-[22px]\">ios_share</span>\n</button>\n</div>\n</header>\n<!-- Scrollable Main Content -->\n<div class=\"px-5 space-y-6 pt-2\">\n<!-- 1. Header & Wardrobe Health Score Hero -->\n<section class=\"bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/30 shadow-[0_4px_20px_rgba(30,34,41,0.04)]\">\n<div class=\"flex items-center justify-between\">\n<div class=\"space-y-1\">\n<span class=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-tertiary/10 text-tertiary font-label-sm text-label-sm\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary\"></span>\n                Optimal Flow\n              </span>\n<h2 class=\"font-headline-lg text-headline-md text-on-surface font-bold tracking-tight\">Closet Health</h2>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Real-time dynamic wardrobe efficiency</p>\n</div>\n<!-- SVG Radial Health Meter (88%) -->\n<div class=\"relative flex items-center justify-center w-24 h-24\">\n<svg class=\"w-24 h-24 transform -rotate-90\" viewbox=\"0 0 100 100\">\n<circle cx=\"50\" cy=\"50\" fill=\"transparent\" r=\"40\" stroke=\"#f1f3fd\" stroke-width=\"8\"></circle>\n<circle cx=\"50\" cy=\"50\" fill=\"transparent\" r=\"40\" stroke=\"#0070ea\" stroke-dasharray=\"251.2\" stroke-dashoffset=\"30.14\" stroke-linecap=\"round\" stroke-width=\"8\"></circle>\n</svg>\n<div class=\"absolute inset-0 flex flex-col items-center justify-center\">\n<span class=\"font-headline-lg text-headline-md font-bold text-on-surface\">88%</span>\n<span class=\"font-label-sm text-[9px] uppercase tracking-wider text-secondary\">Score</span>\n</div>\n</div>\n</div>\n<!-- Divider -->\n<div class=\"h-px w-full bg-surface-container-high my-4\"></div>\n<!-- Wardrobe Key Metrics Grid -->\n<div class=\"grid grid-cols-3 gap-2\">\n<div class=\"p-2.5 rounded-xl bg-surface-container-low flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-secondary\">Active Wear</span>\n<div class=\"mt-1 flex items-baseline gap-1\">\n<span class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">37</span>\n<span class=\"font-body-sm text-body-sm text-secondary\">/42</span>\n</div>\n<span class=\"font-label-sm text-[10px] text-tertiary mt-0.5\">88% in 45d</span>\n</div>\n<div class=\"p-2.5 rounded-xl bg-surface-container-low flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-secondary\">Cost/Wear</span>\n<span class=\"mt-1 font-headline-sm text-headline-sm font-bold text-on-surface\">$14.20</span>\n<span class=\"font-label-sm text-[10px] text-tertiary mt-0.5 flex items-center gap-0.5\">\n<span class=\"material-symbols-outlined text-[11px]\">trending_down</span>-18% mo\n              </span>\n</div>\n<div class=\"p-2.5 rounded-xl bg-surface-container-low flex flex-col\">\n<span class=\"font-label-sm text-label-sm text-secondary\">Valuation</span>\n<span class=\"mt-1 font-headline-sm text-headline-sm font-bold text-on-surface\">$4,850</span>\n<span class=\"font-label-sm text-[10px] text-secondary mt-0.5\">Appraised</span>\n</div>\n</div>\n</section>\n<!-- 2. Identified Wardrobe Gaps (Actionable AI Recommendations) -->\n<section class=\"space-y-3\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">auto_fix_high</span>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-semibold\">Wardrobe Gaps</h3>\n</div>\n<span class=\"px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm\">2 Identified</span>\n</div>\n<!-- Primary Gap Card -->\n<div class=\"bg-surface-container-lowest border border-outline-variant/30 rounded-2xl p-4 shadow-[0_4px_20px_rgba(30,34,41,0.04)] relative overflow-hidden\">\n<div class=\"absolute top-0 right-0 w-28 h-28 bg-primary/5 rounded-full -mr-8 -mt-8 pointer-events-none\"></div>\n<div class=\"flex gap-3\">\n<div class=\"w-20 h-24 rounded-xl bg-surface-container-low overflow-hidden flex-shrink-0 flex items-cente