d hover:bg-surface-container transition-all flex items-center justify-center gap-1\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">ac_unit</span>\n<span>Runs Cold</span>\n</button>\n<button class=\"py-2.5 px-3 rounded-full bg-on-surface text-on-primary font-label-md text-label-md font-semibold shadow-sm flex items-center justify-center gap-1\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">balance</span>\n<span>Balanced</span>\n</button>\n<button class=\"py-2.5 px-3 rounded-full border border-outline-variant/30 text-secondary bg-surface-container-low font-label-md text-label-md hover:bg-surface-container transition-all flex items-center justify-center gap-1\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">local_fire_department</span>\n<span>Runs Warm</span>\n</button>\n</div>\n</div>\n<!-- Commute Mode Selector -->\n<div class=\"space-y-2 pt-1\">\n<label class=\"font-label-md text-label-md font-semibold text-on-surface\">Primary Daily Commute</label>\n<div class=\"grid grid-cols-3 gap-2\">\n<label class=\"cursor-pointer\">\n<input checked=\"\" class=\"sr-only peer\" name=\"commute\" type=\"radio\"/>\n<div class=\"p-3 rounded-xl border border-outline-variant/30 peer-checked:border-primary peer-checked:bg-primary-fixed/30 flex flex-col items-center gap-1.5 transition-all\">\n<span class=\"material-symbols-outlined text-primary text-[22px]\">directions_walk</span>\n<span class=\"font-label-sm text-label-sm font-semibold text-on-surface\">Walking</span>\n<span class=\"font-body-sm text-[10px] text-secondary text-center leading-tight\">Footwear focus</span>\n</div>\n</label>\n<label class=\"cursor-pointer\">\n<input class=\"sr-only peer\" name=\"commute\" type=\"radio\"/>\n<div class=\"p-3 rounded-xl border border-outline-variant/30 peer-checked:border-primary peer-checked:bg-primary-fixed/30 flex flex-col items-center gap-1.5 transition-all\">\n<span class=\"material-symbols-outlined text-secondary peer-checked:text-primary text-[22px]\">subway</span>\n<span class=\"font-label-sm text-label-sm font-semibold text-on-surface\">Transit</span>\n<span class=\"font-body-sm text-[10px] text-secondary text-center leading-tight\">Breathable layers</span>\n</div>\n</label>\n<label class=\"cursor-pointer\">\n<input class=\"sr-only peer\" name=\"commute\" type=\"radio\"/>\n<div class=\"p-3 rounded-xl border border-outline-variant/30 peer-checked:border-primary peer-checked:bg-primary-fixed/30 flex flex-col items-center gap-1.5 transition-all\">\n<span class=\"material-symbols-outlined text-secondary peer-checked:text-primary text-[22px]\">directions_car</span>\n<span class=\"font-label-sm text-label-sm font-semibold text-on-surface\">Driving</span>\n<span class=\"font-body-sm text-[10px] text-secondary text-center leading-tight\">Compact jackets</span>\n</div>\n</label>\n</div>\n</div>\n<!-- Precipitation Toggle -->\n<div class=\"flex items-center justify-between pt-2 border-t border-outline-variant/20\">\n<div>\n<span class=\"font-label-md text-label-md font-semibold text-on-surface block\">Precipitation &amp; Rain Safeguard</span>\n<span class=\"font-body-sm text-body-sm text-secondary\">Prioritize water-resistant outers when rain probability &gt; 30%</span>\n</div>\n<label class=\"relative inline-flex items-center cursor-pointer ml-3 shrink-0\">\n<input checked=\"\" class=\"sr-only peer\" type=\"checkbox\"/>\n<div class=\"w-12 h-6 bg-surface-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-6 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary\"></div>\n</label>\n</div>\n</section>\n<!-- SECTION 3: Clothing Item & Wardrobe Management -->\n<section class=\"bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/30 shadow-[0px_4px_20px_rgba(30,34,41,0.04)] space-y-5\">\n<div 