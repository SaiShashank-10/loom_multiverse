tainer transition-all\" id=\"save-btn\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px] text-on-primary\">check</span>\n<span>Saved</span>\n</button>\n</div>\n</header>\n<!-- Main Scrollable Content -->\n<main class=\"flex-1 px-5 pt-3 space-y-6\">\n<!-- SECTION 1: Profile Information & AI Styling Persona -->\n<section class=\"bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/30 shadow-[0px_4px_20px_rgba(30,34,41,0.04)] space-y-5\">\n<div class=\"flex items-center gap-4\">\n<div class=\"relative\">\n<img alt=\"Sarah Thompson\" class=\"w-16 h-16 rounded-full object-cover ring-2 ring-primary/20 p-0.5\" data-alt=\"Close-up editorial portrait of Sarah Thompson, a polished marketing manager with warm natural makeup and sleek pulled-back hair, set against a bright, airy architectural studio background. The aesthetic is clean high-fashion modernism with pure cobalt blue accents and crisp lighting.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAPTT4layEYscw_klWKBh_opyIHGjn3y1HvlVZKtsYUdvCEeoLhk5s7rfa0KVSjzIO8GmCws_ojFeaTZg9UrcYKZnTNhCrlYK6jz5ZgDazoW4Pvp7Kmyow-QB94CNFXraeg4n7POpstkx-mrv55G7OQiVEG6iPz-7mLT19sPy4CJ8DNfcWA950ZNRp8rqLw1OxWGBb0ehmbaHDRQ01tS4XH3LTuIjgUBgyjqkSGKrbSFSib82EemW7-NWG31Qa7o9Dhj2ccPf1osDM\"/>\n<button aria-label=\"Change photo\" class=\"absolute -bottom-1 -right-1 w-7 h-7 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-md active:scale-90 transition-transform\" type=\"button\">\n<span class=\"material-symbols-outlined text-[15px]\">photo_camera</span>\n</button>\n</div>\n<div class=\"flex-1 min-w-0\">\n<div class=\"flex items-center gap-1.5\">\n<h2 class=\"font-headline-sm text-headline-sm font-bold text-on-surface truncate\">Sarah Thompson</h2>\n<span class=\"material-symbols-outlined text-primary text-[18px] fill\" title=\"Verified Curated Profile\">verified</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-secondary truncate\">Marketing Manager • London, UK</p>\n<div class=\"mt-1.5 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm\">\n<span class=\"material-symbols-outlined text-[13px]\">auto_awesome</span>\n<span>Versatility Score: 88%</span>\n</div>\n</div>\n</div>\n<!-- AI Persona Chips -->\n<div class=\"pt-3 border-t border-outline-variant/20 space-y-3\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-md text-label-md font-semibold text-on-surface flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-primary text-[16px]\">styler</span>\n<span>AI Styling Persona</span>\n</span>\n<button class=\"font-label-sm text-label-sm text-primary hover:underline\">Re-calibrate</button>\n</div>\n<div class=\"grid grid-cols-3 gap-2\">\n<div class=\"bg-surface-container-low p-2.5 rounded-xl text-center border border-outline-variant/20\">\n<span class=\"font-label-sm text-label-sm text-secondary block\">Body Shape</span>\n<span class=\"font-label-md text-label-md font-bold text-on-surface\">Hourglass</span>\n</div>\n<div class=\"bg-surface-container-low p-2.5 rounded-xl text-center border border-outline-variant/20\">\n<span class=\"font-label-sm text-label-sm text-secondary block\">Color Season</span>\n<span class=\"font-label-md text-label-md font-bold text-on-surface\">Soft Autumn</span>\n</div>\n<div class=\"bg-surface-container-low p-2.5 rounded-xl text-center border border-outline-variant/20\">\n<span class=\"font-label-sm text-label-sm text-secondary block\">Dressing Mood</span>\n<span class=\"font-label-md text-label-md font-bold text-primary\">Executive</span>\n</div>\n</div>\n</div>\n<!-- Measurements & Fit Preferences -->\n<div class=\"space-y-3 pt-1\">\n<label class=\"block font-label-md text-label-md text-secondary\">Physical Baseline &amp; Silhouette</label>\n<div class=\"grid grid-cols-2 gap-3\">\n<div class=\"relative\">\n<input class=\"w-full h-11 bg-surface-container-low border border-o