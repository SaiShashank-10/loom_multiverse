  "html": "<!DOCTYPE html>\n\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Virtual Try-On Studio - Style OS</title>\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600&amp;family=Space+Grotesk:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          \"colors\": {\n            \"inverse-primary\": \"#adc7ff\",\n            \"surface-container\": \"#ebeef7\",\n            \"on-error\": \"#ffffff\",\n            \"inverse-on-surface\": \"#eef0fa\",\n            \"surface-dim\": \"#d7dae3\",\n            \"on-surface\": \"#181c23\",\n            \"error\": \"#ba1a1a\",\n            \"on-primary-container\": \"#fefcff\",\n            \"surface-bright\": \"#f9f9ff\",\n            \"tertiary-fixed\": \"#83fc8e\",\n            \"secondary-fixed-dim\": \"#bfc8d0\",\n            \"on-tertiary-container\": \"#f7fff2\",\n            \"tertiary-fixed-dim\": \"#66df75\",\n            \"on-tertiary-fixed-variant\": \"#00531a\",\n            \"on-secondary-fixed\": \"#141d23\",\n            \"primary-container\": \"#0070ea\",\n            \"outline-variant\": \"#c1c6d7\",\n            \"outline\": \"#717786\",\n            \"surface-tint\": \"#005bc0\",\n            \"surface-variant\": \"#dfe2ec\",\n      