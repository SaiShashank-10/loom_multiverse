tesk\"],\n            \"label-md\": [\"Space Grotesk\"],\n            \"display-lg-mobile\": [\"Space Grotesk\"],\n            \"body-sm\": [\"Hanken Grotesk\"],\n            \"headline-sm\": [\"Space Grotesk\"],\n            \"display-lg\": [\"Space Grotesk\"],\n            \"label-sm\": [\"Space Grotesk\"],\n            \"headline-lg\": [\"Space Grotesk\"]\n          },\n          \"fontSize\": {\n            \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0em\", \"fontWeight\": \"400\" }],\n            \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"400\" }],\n            \"headline-md\": [\"22px\", { \"lineHeight\": \"28px\", \"letterSpacing\": \"-0.01em\", \"fontWeight\": \"600\" }],\n            \"label-lg\": [\"14px\", { \"lineHeight\": \"18px\", \"letterSpacing\": \"0.02em\", \"fontWeight\": \"500\" }],\n            \"label-md\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.03em\", \"fontWeight\": \"500\" }],\n            \"display-lg-mobile\": [\"32px\", { \"lineHeight\": \"38px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }],\n            \"body-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"letterSpacing\": \"0.01em\", \"fontWeight\": \"400\" }],\n            \"headline-sm\": [\"18px\", { \"lineHeight\": \"24px\", \"letterSpacing\": \"0em\", \"fontWeight\": \"600\" }],\n            \"display-lg\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.03em\", \"fontWeight\": \"700\" }],\n            \"label-sm\": [\"10px\", { \"lineHeight\": \"14px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"600\" }],\n            \"headline-lg\": [\"28px\", { \"lineHeight\": \"34px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"600\" }]\n          }\n        },\n      },\n    }\n  </script>\n<style>\n    .material-symbols-outlined {\n      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n      display: inline-block;\n      vertical-align: middle;\n      line-height: 1;\n    }\n    .hide-scrollbar::-webkit-scrollbar {\n      display: none;\n    }\n    .hide-scrollbar {\n      -ms-overflow-style: none;\n      scrollbar-width: none;\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-background text-on-surface antialiased min-h-screen flex justify-center selection:bg-primary-fixed selection:text-on-primary-fixed\">\n<!-- Mobile Viewport Shell (Flutter Max Width Container) -->\n<div class=\"w-full max-w-md bg-surface flex flex-col min-h-screen relative shadow-2xl overflow-x-hidden pb-28\">\n<!-- Top App Bar (Customized with Contextual Back & Action Header) -->\n<header class=\"sticky top-0 z-40 bg-surface/95 backdrop-blur-md flex justify-between items-center w-full px-5 py-3.5 transition-all\">\n<div class=\"flex items-center gap-3\">\n<button aria-label=\"Go Back\" class=\"w-9 h-9 flex items-center justify-center rounded-full text-on-surface hover:bg-surface-container active:scale-95 transition-transform duration-150\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\">arrow_back</span>\n</button>\n<div>\n<h1 class=\"font-headline-sm text-headline-sm font-bold text-on-surface tracking-tight\">Virtual Try-On Studio</h1>\n<p class=\"font-label-sm text-label-sm text-outline\">Digital Twin #ST-9042</p>\n</div>\n</div>\n<div class=\"flex items-center gap-1.5\">\n<button aria-label=\"Share Look\" class=\"w-9 h-9 flex items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-container active:scale-95 transition-transform duration-150\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">ios_share</span>\n</button>\n<button aria-label=\"Save to Lookbook Diary\" class=\"w-9 h-9 flex items-center justify-center rounded-full text-primary hover:bg-surface-container active:scale-95 transition-transform duration-150\" id=\"likeBtn\" onclick=\"toggleSaveHeart()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\" id=\"heartIcon\" style=\"font-variation-settings: 'FILL' 1;\">favorite</span>\n</button>\n</div>\n</header>\n<!-- Main Content Flow -->\n<main class=\"flex-1 px-4 pt-1 pb-4 flex flex-col gap-4\">\n<!-- Viewport Simulation Canvas (The Avatar Stage) -->\n<section class=\"relative w-full rounded-2xl bg-surface-container-lowest border border-outline-variant/30 overflow-hidden shadow-sm flex flex-col\">\n<!-- Live Status Badges & HUD Elements -->\n<div class=\"absolute top-3 inset-x-3 z-20 flex justify-between items-start pointer-events-none\">\n<!-- Fit Analysis Tag -->\n<div class=\"pointer-events-auto flex items-center gap-1.5 bg-surface-container-lowest/90 backdrop-blur-md px-3 py-1.5 rounded-full border border-outline-variant/40 shadow-sm\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary-container animate-pulse\"></span>\n<span class=\"font-label-md text-label-md font-semibold text-on-surface\">Fit Score: 98% Optimal</span>\n</div>\n<!-- Weather Match Pill -->\n<div class=\"pointer-events-auto flex items-center gap-1.5 bg-surface-container-lowest/90 backdrop-blur-md px-3 py-1.5 rounded-full border border-outline-variant/40 shadow-sm\">\n<span class=\"material-symbols-outlined text-[16px] text-amber-500\" style=\"font-variation-settings: 'FILL' 1;\">wb_sunny</span>\n<span class=\"font-label-md text-label-md font-medium text-on-surface\">72°F Sunny Match</span>\n</div>\n</div>\n<!-- Realistic 3D Avatar Display -->\n<div class=\"relative w-full h-[380px] bg-gradient-to-b from-surface-container-low via-surface-container-lowest to-surface-container-low flex items-center justify-center overflow-hidden\">\n<img class=\"w-full h-full object-cover object-top filter contrast-[1.02]\" data-alt=\"Photorealistic full-body 3D digital twin of a stylish woman named Sarah Thompson with neat hair standing in a modern, ultra-clean minimalist studio. She wears a tailored navy blue linen blazer over a pristine off-white silk crepe top, paired with relaxed high-waisted wide-leg trousers and dark polished leather buckle loafers. Crisp daylight illumination, cinematic composition, pristine light mode aesthetic.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuA95m-io9d5nIkBxylk7rD0CECzP_7a6sW64BvYR83m3c1C0b0gV447tPfyYE24P8m-q8tZPjM5RAcVBtfiIeQxS2rQkfgMaewMdumtaY-o8CA2VNMNUMB2wUL0ELPUAwi-S3FLHSxKN_FhL22PhHB2km7M4BdqjVtKg25GE5Gz9eRKGwwz3b7lJ6ZOnyTcTwKFTAxV5iyshLUZ2VV-R5OIObSPWpeR2GvOYr34cIf6F1xeX4gTSU2SdRPxqHKvwr2o8jeauFmV5fY\"/>\n<!-- Subtle Avatar Lighting Overlay Scrim -->\n<div class=\"absolute inset-0 bg-gradient-to-t from-surface-container-lowest/90 via-transparent to-transparent pointer-events-none\"></div>\n<!-- Hotspot Markers on Avatar (Garment Interactivity) -->\n<div class=\"absolute top-[32%] left-[34%] z-10\">\n<button aria-label=\"Inspect Navy Blazer\" class=\"group relative flex items-center justify-center\" type=\"button\">\n<span class=\"absolute w-6 h-6 rounded-full bg-primary/20 animate-ping\"></span>\n<span class=\"w-5 h-5 rounded-full bg-primary border-2 border-surface-container-lowest flex items-center justify-center text-on-primary shadow-sm\">\n<span class=\"material-symbols-outlined text-[11px]\">crop_free</span>\n</span>\n<span class=\"hidden group-hover:flex absolute left-7 top-1/2 -translate-y-1/2 bg-inverse-surface text-inverse-on-surface font-label-sm text-label-sm px-2 py-0.5 rounded shadow whitespace-nowrap\">Navy Linen Blazer</span>\n</button>\n</div>\n<div class=\"absolute bottom-[22%] right-[38%] z-10\">\n<button aria-label=\"Inspect Wide Leg Trousers\" class=\"group relative flex items-center justify-center\" type=\"button\">\n<span class=\"w-5 h-5 rounded-full bg-primary/90 border-2 border-surface-container-lowest flex items-center justify-center text-on-primary shadow-sm\">\n<span class=\"material-symbols-outlined text-[11px]\">crop_free</span>\n</span>\n<span class=\"hidden group-hover:flex absolute right-7 top-1/2 -translate-y-1/2 bg-inverse-surface text-inverse-on-surface font-label-sm text-label-sm px-2 py-0.5 rounded shadow whitespace-nowrap\">Wide Leg Trousers</span>\n</button>\n</div>\n<!-- Bottom Viewport Info Float -->\n<div class=\"absolute bottom-3 left-3 z-10 flex items-center gap-2\">\n<span class=\"font-headline-sm text-headline-sm font-semibold text-on-surface\">Sarah Thompson</span>\n<span class=\"bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm px-2 py-0.5 rounded-full\">Proportion Twin</span>\n</div>\n</div>\n<!-- Mode Switcher Pills (Perspective & Simulation Controls) -->\n<div class=\"p-2.5 bg-surface-container-low/60 border-t border-outline-variant/30 flex items-center justify-between gap-1.5\">\n<button class=\"flex-1 py-1.5 px-2 rounded-full bg-on-surface text-surface font-label-md text-label-md font-medium text-center shadow-sm active:scale-98 transition-transform\" type=\"button\">\n            Front View\n          </button>\n<button class=\"flex-1 py-1.5 px-2 rounded-full bg-surface-container-lowest border border-outline-variant/40 text-on-surface-variant font-label-md text-label-md font-medium text-center hover:bg-surface-container active:scale-98 transition-transform flex items-center justify-center gap-1\" type=\"button\">\n<span class=\"material-symbols-outlined text-[15px]\">360</span>\n<span>360° Rotate</span>\n</button>\n<button class=\"flex-1 py-1.5 px-2 rounded-full bg-surface-container-lowest border border-outline-variant/40 text-on-surface-variant font-label-md text-label-md font-medium text-center hover:bg-surface-container active:scale-98 transition-transform flex items-center justify-center gap-1\" type=\"button\">\n<span class=\"material-symbols-outlined text-[15px]\">air</span>\n<span>Microclimate</span>\n</button>\n</div>\n</section>\n<!-- Outfit Synthesis Breakdown & Layer Tray Carousel -->\n<section class=\"flex flex-col gap-2.5\">\n<div class=\"flex items-center justify-between px-1\">\n<div class=\"flex items-center gap-2\">\n<h2 class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Outfit Layers</h2>\n<span class=\"bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm px-2 py-0.5 rounded-full\">4 pieces</span>\n</div>\n<button class=\"text-primary font-label-md text-label-md font-semibold flex items-center gap-0.5 hover:underline\" type=\"button\">\n<span>Remix All</span>\n<span class=\"material-symbols-outlined text-[16px]\">auto_awesome</span>\n</button>\n</div>\n<!-- Horizontal Layer Switcher Carousel -->\n<div class=\"flex gap-2.5 overflow-x-auto hide-scrollbar pb-1 pt-0.5 -mx-4 px-4\">\n<!-- Outerwear Card -->\n<div class=\"min-w-[136px] max-w-[136px] bg-surface-container-lowest rounded-2xl p-2.5 border border-outline-variant/40 shadow-sm flex flex-col justify-between relative group hover:border-primary/50 transition-colors\">\n<div class=\"relative w-full h-24 rounded-xl bg-surface-container-low overflow-hidden mb-2\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Single isolated studio photograph of a structured midnight navy blue linen blazer jacket cleanly displayed against a light neutral background, high-end catalog presentation, soft ambient illumination.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDP7j0dWOsIy4L6myJZzHTPHAUI6Y8_8jzPo5l4ByabCKwtrEV_Bc4DNgqqwEeLyA1_am34rF-hQD0k292A7KJJ8kUS9ubw5nIrRRihUzSYQBGAD2iah4k_8BjJxPEzr4DLmtXBwtf-c2t7wFmu2kX9AywaYRfJIlFBA6XgBKHADtrFplzntgiRZW_VszlZ_7aIEQwNgLrLvxPCJ8RIoBUE2K6j1exIwRZ28ZBRRCOn3ccSG4cerjOs6Cvo5N0aoLYBIxuxQVV6exQ\"/>\n<span class=\"absolute top-1.5 left-1.5 bg-surface-container-lowest/90 backdrop-blur-sm font-label-sm text-label-sm px-1.5 py-0.5 rounded text-on-surface font-semibold\">Outer</span>\n<button aria-label=\"Swap Outerwear\" class=\"absolute bottom-1.5 right-1.5 w-6 h-6 rounded-full bg-surface-container-lowest text-primary shadow flex items-center justify-center hover:scale-110 active:scale-95 transition-transform\" type=\"button\">\n<span class=\"material-symbols-outlined text-[14px]\">sync</span>\n</button>\n</div>\n<div>\n<p class=\"font-label-md text-label-md font-bold text-on-surface truncate\">Navy Linen Blazer</p>\n<p class=\"font-body-sm text-body-sm text-outline truncate\">Acne Studios</p>\n</div>\n</div>\n<!-- Top Card -->\n<div class=\"min-w-[136px] max-w-[136px] bg-surface-container-lowest rounded-2xl p-2.5 border border-outline-variant/40 shadow-sm flex flex-col justify-between relative group hover:border-primary/50 transition-colors\">\n<div class=\"relative w-full h-24 rounded-xl bg-surface-container-low overflow-hidden mb-2\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Minimalist product image of an elegant ivory cream silk crepe sleeveless shell top isolated on clean studio backdrop, luxury designer finish, subtle satin textures and soft light.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuD5S9KuosNoordXWYg10sUNRToCP5U7As9uf4rZmCjFAuj-X5d98lPGogmfo07aid0BT8pJqDOkHqostPX0jGlJRR891eld7Kx6Pxw9y-pr22lLi6kSN3vUrGiILcwoj3M8EIDDZDdpAzImxxEARH6-d1UpuhT4GQXAy0JOiiTzZvo9zOZDYTgmH0iuQW0CyTDYp3_6omRtXnbUCI0cmJrp0fAi8Q-4Hj2RVFduMfN6AMLgR9v4JwdsLUClpltE8enhTTq_7j-u6z8\"/>\n<span class=\"absolute top-1.5 left-1.5 bg-surface-container-lowest/90 backdrop-blur-sm font-label-sm text-label-sm px-1.5 py-0.5 rounded text-on-surface font-semibold\">Top</span>\n<button aria-label=\"Swap Top\" class=\"absolute bottom-1.5 right-1.5 w-6 h-6 rounded-full bg-surface-container-lowest text-primary shadow flex items-center justify-center hover:scale-110 active:scale-95 transition-transform\" type=\"button\">\n<span class=\"material-symbols-outlined text-[14px]\">sync</span>\n</button>\n</div>\n<div>\n<p class=\"font-label-md text-label-md font-bold text-on-surface truncate\">Silk Crepe Top</p>\n<p class=\"font-body-sm text-body-sm text-outline truncate\">TOTÊME</p>\n</div>\n</div>\n<!-- Bottom Card -->\n<div class=\"min-w-[136px] max-w-[136px] bg-surface-container-lowest rounded-2xl p-2.5 border border