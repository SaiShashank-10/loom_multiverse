, photographed side profile against a pristine white studio background with gentle shadow.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAFObk17g1olkESa25CfbfNM0RXmBozAbPNem7-7vM4t8yOplcM63-2bpG3miA7bcxnP8J355xh7rwf_QZkBrv_EAhQSqJXyAHTTF_GtyVvogUULLQBHdGygqpzah_jq-4xIMt84UdaDzK7cDmRo-XSH3srXTPPuwLE_M74iAxnpkYPIIRyJCiVr0MCuiAKWJ4ACSDHG2lcBJ6WYyn1eifQM5UVw0dBJIJzv3IEIOKmQgnI-8ZEX1rI8crrTk0KIxXLZ_J8ohWU8SU\"/>\n<span class=\"absolute top-1.5 left-1.5 bg-surface-container-lowest/90 backdrop-blur-sm font-label-sm text-label-sm px-1.5 py-0.5 rounded text-on-surface font-semibold\">Footwear</span>\n<button aria-label=\"Swap Footwear\" class=\"absolute bottom-1.5 right-1.5 w-6 h-6 rounded-full bg-surface-container-lowest text-primary shadow flex items-center justify-center hover:scale-110 active:scale-95 transition-transform\" type=\"button\">\n<span class=\"material-symbols-outlined text-[14px]\">sync</span>\n</button>\n</div>\n<div>\n<p class=\"font-label-md text-label-md font-bold text-on-surface truncate\">Buckle Loafers</p>\n<p class=\"font-body-sm text-body-sm text-outline truncate\">Jil Sander</p>\n</div>\n</div>\n<!-- Add Layer Slot -->\n<button class=\"min-w-[96px] max-w-[96px] border border-dashed border-outline-variant rounded-2xl p-2 flex flex-col items-center justify-center gap-1.5 text-outline hover:text-primary hover:border-primary transition-colors active:scale-95\" type=\"button\">\n<span class=\"w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[18px]\">add</span>\n</span>\n<span class=\"font-label-sm text-label-sm font-medium\">Add Layer</span>\n</button>\n</div>\n</section>\n<!-- Stylist Diagnostic Matrix (Bento Micro Insight) -->\n<section class=\"grid grid-cols-2 gap-2.5 mt-1\">\n<div class=\"bg-surface-container-low p-3 rounded-2xl border border-outline-variant/30 flex flex-col justify-between\">\n<div class=\"flex items-center gap-1.5 text-outline mb-1\">\n<span class=\"material-symbols-outlined text-[16px]\">hourglass_empty</span>\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider\">Silhouette</span>\n</div>\n<div>\n<p class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Structured A-Line</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Elongates torso +4.2%</p>\n</div>\n</div>\n<div class=\"bg-surface-container-low p-3 rounded-2xl border border-outline-variant/30 flex flex-col justify-between\">\n<div class=\"flex items-center gap-1.5 text-outline mb-1\">\n<span class=\"material-symbols-outlined text-[16px]\">palette</span>\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider\">Palette Harmonics</span>\n</div>\n<div>\n<p class=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Deep Cold Neutral</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">88% Seasonal Alignment</p>\n</div>\n</div>\n</section>\n<!-- Action Button Group (Sticky Above Bottom Navigation Bar) -->\n<section class=\"flex flex-col gap-2.5 pt-2\">\n<button class=\"w-full py-3.5 px-6 rounded-full bg-primary text-on-primary font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 shadow-md hover:bg-primary-container active:scale-[0.98] transition-all duration-150\" onclick=\"saveToLookbook()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">bookmark_add</span>\n<span>Save to Outfit Diary</span>\n</button>\n<button class=\"w-full py-3 px-6 rounded-full bg-surface-container-lowest border border-outline-variant text-on-surface font-label-lg text-label-lg font-medium flex items-center justify-center gap-2 hover:bg-surface-container active:scale-[0.98] transition-all duration-150\" onclick=\"logAsWorn()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px] text-primary\">check_circle</span>\n<span>Log as Today's Worn Look</span>\n</button>\n<p class=\"text-center font-body-sm text-body-sm text-outline\">Logging reduces Cost-Per-Wear by -$1.42 and updates Closet Health index.</p>\n</section>\n</main>\n<!-- Bottom Navigation Bar (Mandated Shared Component) -->\n<!-- Style OS Bottom Navigation Bar: active on 'Try-On' -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-2 border-t border-outline-variant/20 dark:border-outline/20 bg-surface-container-lowest dark:bg-inverse-surface shadow-lg dark:shadow-none\">\n<!-- Home Tab (Inactive) -->\n<button class=\"flex flex-col items-center justify-center text-on-surface-variant dark:text-outline-variant px-3 py-1.5 active:scale-95 transition-transform duration-150 hover:bg-surface-container dark:hover:bg-surface-variant rounded-full\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\">home</span>\n<span class=\"font-label-sm text-label-sm mt-0.5\">Home</span>\n</button>\n<!-- Try-On Tab (ACTIVE: Exact Match to Intent) -->\n<button class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container dark:bg-primary-fixed dark:text-on-primary-fixed rounded-full px-3 py-1.5 active:scale-95 transition-transform duration-150\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\" style=\"font-variation-settings: 'FILL' 1;\">view_in_ar</span>\n<span class=\"font-label-sm text-label-sm mt-0.5 font-bold\">Try-On</span>\n</button>\n<!-- Scan Tab (Inactive) -->\n<button class=\"flex flex-col items-center justify-center text-on-surface-variant dark:text-outline-variant px-3 py-1.5 active:scale-95 transition-transform duration-150 hover:bg-surface-container dark:hover:bg-surface-variant rounded-full\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\">photo_camera</span>\n<span class=\"font-label-sm text-label-sm mt-0.5\">Scan</span>\n</button>\n<!-- Closet Tab (Inactive) -->\n<button class=\"flex flex-col items-center justify-center text-on-surface-variant dark:text-outline-variant px-3 py-1.5 active:scale-95 transition-transform duration-150 hover:bg-surface-container dark:hover:bg-surface-variant rounded-full\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\">checkroom</span>\n<span class=\"font-label-sm text-label-sm mt-0.5\">Closet</span>\n</button>\n<!-- Health Tab (Inactive) -->\n<button class=\"flex flex-col items-center justify-center text-on-surface-variant dark:text-outline-variant px-3 py-1.5 active:scale-95 transition-transform duration-150 hover:bg-surface-container dark:hover:bg-surface-variant rounded-full\" type=\"button\">\n<span class=\"material-symbols-outlined text-[22px]\">analytics</span>\n<span class=\"font-label-sm text-label-sm mt-0.5\">Health</span>\n</button>\n</nav>\n<!-- Toast Notification Overlay (Micro-interaction feedback) -->\n<div class=\"fixed top-16 left-1/2 -translate-x-1/2 bg-inverse-surface text-inverse-on-surface px-4 py-2.5 rounded-full text-label-md font-label-md shadow-xl flex items-center gap-2 pointer-events-none opacity-0 transition-opacity duration-200 z-50\" id=\"toastNotification\">\n<span class=\"material-symbols-outlined text-primary-fixed-dim text-[18px]\">verified</span>\n<span id=\"toastMessage\">Look saved to Outfit Diary</span>\n</div>\n</div>\n<!-- Microinteraction Handlers -->\n<script>\n    function triggerToast(message) {\n      const toast = document.getElementById('toastNotification');\n      const msg = document.getElementById('toastMessage');\n      msg.textContent = message;\n      toast.classList.remove('opacity-0');\n      toast.classList.add('opacity-100');\n      setTimeout(() => {\n        toast.classList.remove('opacity-100');\n        toast.classList.add('opacity-0');\n      }, 2200);\n    }\n\n    let isHearted = true;\n    function toggleSaveHeart() {\n      const heart = document.getElementById('heartIcon');\n      isHearted = !isHearted;\n      if (isHearted) {\n        heart.style.fontVariationSettings = \"'FILL' 1\";\n        triggerToast(\"Saved to favorites!\");\n      } else {\n        heart.style.fontVariationSettings = \"'FILL' 0\";\n        triggerToast(\"Removed from favorites\");\n      }\n    }\n\n    function saveToLookbook() {\n      triggerToast(\"Look #ST-9042 successfully added to Diary!\");\n    }\n\n    function logAsWorn() {\n      triggerToast(\"Logged for Today! Metrics updated in Health tab.\");\n    }\n  </script>\n</body></html>",
