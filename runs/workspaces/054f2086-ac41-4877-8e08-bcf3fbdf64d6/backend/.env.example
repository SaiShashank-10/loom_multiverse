# Example environment variables file for TechAccessoryDropshipperPlatform Backend

# Application settings
APP_PORT=3000
APP_HOST=localhost

# Database settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techaccessorydropshipperplatform
DB_USER=postgres
DB_PASSWORD=password

# JWT settings
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h

# CORS settings
CORS_ORIGIN=http://localhost:3001

# Logging settings
LOG_LEVEL=info

# Email settings (if needed)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@example.com
EMAIL_PASSWORD=your_email_password_here