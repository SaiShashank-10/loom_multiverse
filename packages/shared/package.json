{
  "name": "@loom/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./logger": "./dist/logger.js",
    "./config": "./dist/config.js",
    "./errors": "./dist/errors.js",
    "./types": "./dist/types.js",
    "./constants": "./dist/constants.js"
  },
  "scripts": {
